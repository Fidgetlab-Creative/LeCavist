acing_bottom":15}},"description_kHT4M":{"type":"description","settings":{"description":"<p>Designed for LeCavist owners, the Wine Circle gives you access to a considered program of tastings, private dinners, and moments with winemakers. It’s a space to continue learning, discover new wines with context, and better understand what sits in your cellar.<\/p>","font_size":14,"font_weight":"body_weight","spacing_bottom":10}}},"block_order":["heading_FqLVg","description_kHT4M"],"name":"t:sections.rich_text.name","settings":{"section_width":"container","color_scheme":"","content_alignment":"center","content_max_width":100,"enable_expand_content":false,"expand_content_button":"Join Us at the Table","padding_top":40,"padding_bottom":0,"reset_spacing":true}},"featured_product_CdyN3e":{"type":"featured-product","blocks":{"title_VaEpWQ":{"type":"title","settings":{"show_vendor":false}},"price_hKQKab":{"type":"price","settings":{}},"description_PCGtbb":{"type":"description","settings":{}},"buy_buttons_CAPVG3":{"type":"buy_buttons","settings":{"show_dynamic_checkout":false,"show_gift_card_recipient":false}}},"block_order":["title_VaEpWQ","price_hKQKab","description_PCGtbb","buy_buttons_CAPVG3"],"disabled":true,"name":"t:sections.featured-product.name","settings":{"product":"one-seat-to-the-clonakilla-x-manu-dinner-21-10","section_width":"container","color_scheme":"","desktop_media_width":30,"desktop_main_image_position":"left","desktop_layout":"hidden_thumbnail","enable_video_autoplay":false,"enable_video_looping":false,"padding_top":0,"padding_bottom":0,"reset_spacing":true}},"custom_liquid_LAFDG":{"type":"custom-liquid","name":"t:sections.custom_liquid.name","settings":{"section_width":"container","color_scheme":"","custom_liquid":"{% comment %}\n  Simple title section for Wine Circle page\n  Title: The 3 Pillars of the Wine Circle\n{% endcomment %}\n\n<div class=\"wine-circle-title-section\">\n  <div class=\"container\">\n    <h2 class=\"wine-circle-title\" >\n      The 3 Pillars of the Wine Circle\n    <\/h2>\n  <\/div>\n<\/div>\n\n<style>\n  \/* Optional styling *\/\n  .wine-circle-title-section {\n    padding: 60px px;\n    text-align: center;\n  }\n\n  .wine-circle-title {\n    font-size: 36px!important;\n    font-weight: 600;\n    color: #3a2f2f; \/* warm dark tone *\/\n    margin: 0;\n  }\n\n  @media screen and (max-width: 768px) {\n    .wine-circle-title {\n      font-size: 30px!important;\n    }\n  }\n<\/style>","padding_top":20,"padding_bottom":20,"reset_spacing":true}},"image_with_text_REaU8q":{"type":"image-with-text","name":"Image with text","settings":{"image":"shopify:\/\/shop_images\/0J0A3960.jpg","layout":"right","title":"Exclusive Wine Circle Experience","text":"<p>As a member, you receive exclusive invitations to intimate wine events and experiences, always in the company of celebrated winemakers.<br\/>These tastings are carefully curated moments featuring cellared and museum wines rarely opened in public.<\/p>","button_text":"","button_link":"","text_alignment":"center","color_bg":"#eeeeee","color_text":"#454f5b","color_head":"#212b36","skip_container":true}},"image_with_text_aaAkWg":{"type":"image-with-text","name":"Image with text","settings":{"image":"shopify:\/\/shop_images\/0J0A3614.jpg","layout":"left","title":"Wine Allocations","text":"<p>Wine Circle members gain access to limited releases, cellar-worthy vintages, and rare allocations — reserved privately for our community. <\/p><p>These wines are offered below market price, with allocations subsidised by LeCavist, because great wine deserves to be stored -and enjoyed - properly.<\/p>","button_text":"","button_link":"","text_alignment":"center","color_bg":"#eeeeee","color_text":"#454f5b","color_head":"#212b36","skip_container":true}},"image_with_text_LcKFNg":{"type":"image-with-text","name":"Image with text","settings":{"image":"shopify:\/\/shop_images\/0J0A3905.jpg","layout":"right","title":"Education & Guidance","text":"<p>Experience exclusive dinners and tastings with winemakers, explore new regions and grapes, and gain expert tips on storing and tasting your wines in your LeCavist cabinet -  blending learning, enjoyment, and connection in every event.<\/p>","button_text":"","button_link":"","text_alignment":"center","color_bg":"#eeeeee","color_text":"#454f5b","color_head":"#212b36","skip_container":true}},"shogun-optimizer":{"type":"shogun-optimizer","settings":{}},"custom_liquid_yFLMe":{"type":"custom-liquid","name":"t:sections.custom_liquid.name","settings":{"section_width":"container","color_scheme":"","custom_liquid":"<div class=\"wine-circle-title-section\">\n  <div class=\"container\">\n    <h3 class=\"wine-circle-title\" >\n      - Inside Our Past Dinners - \n    <\/h3>\n  <\/div>\n<\/div>\n\n<style>\n  \/* Optional styling *\/\n  .wine-circle-title-section {\n    padding: 60px px;\n    text-align: center;\n  }\n\n  .wine-circle-title {\n    font-size: 36px!important;\n    font-weight: 600;\n    color: #3a2f2f; \/* warm dark tone *\/\n    margin: 0;\n  }\n\n  @media screen and (max-width: 768px) {\n    .wine-circle-title {\n      font-size: 30px!important;\n    }\n  }\n<\/style>","padding_top":100,"padding_bottom":0,"reset_spacing":true}},"rich_text_6kGCa":{"type":"rich-text","blocks":{"heading_HYRme":{"type":"heading","settings":{"heading":"A Night With Chris Tyrrell - Rockpool Bar & Grill","font_size":36,"font_weight":"heading_weight","uppercase":false,"spacing_bottom":24}},"description_7mDff":{"type":"description","settings":{"description":"<p><strong>Rockpool Bar & Grill<\/strong>, October. The Wine Circle gathered around a curated pour from <strong>Chris Tyrrell's private collection<\/strong>, each wine matched to a signature dish from the kitchen. In one of Sydney's most iconic dining rooms, the evening felt less like an event than a long conversation between collectors and a Hunter Valley legacy.<\/p>","font_size":14,"font_weight":"body_weight","spacing_bottom":0}}},"block_order":["heading_HYRme","descrip