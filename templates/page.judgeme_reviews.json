ections.image_with_text_overlay.name","settings":{"section_width":"full_width","color_scheme":"","image":"shopify:\/\/shop_images\/Screenshot_2025-10-31_at_13.13.18.png","overlay_opacity":0,"image_height":"adapt","desktop_height":600,"mobile_height":500,"content_alignment":"left","content_position":"top-left","content_width":"container","content_max_width":100,"content_padding_block":50,"content_padding_inline":50,"show_content_background":false,"content_background":"#f5f0e8","content_box_opacity":10,"content_below_image":false,"content_alignment_mobile":"left","padding_top":0,"padding_bottom":30,"reset_spacing":true}},"image_with_text_wNHUTd":{"type":"image-with-text","disabled":true,"name":"Image with text","settings":{"image":"shopify:\/\/shop_images\/WhatsApp_Image_2025-11-04_at_12.09.57.jpg","layout":"right","title":"LeCavist in their words","text":"<p>We’re delighted to introduce <strong>Gianmattia Giordano<\/strong>, the Head Sommelier at the acclaimed Rockpool Bar & Grill in Sydney and the official brand ambassador for LeCavist. Hailing from Bologna, Italy, Gianmattia brings an extraordinary depth of knowledge and a refined palate to his work, having been recognised as Australia’s Best Young Sommelier in 2023 by the prestigious Chaîne des Rôtisseurs International.<\/p>","button_text":"Shop","button_link":"","text_alignment":"center","color_bg":"#7c3030","color_text":"#ffffff","color_head":"#ffffff","skip_container":true}},"divider_gADLqb":{"type":"divider","name":"t:sections.divider.name","settings":{"section_width":"container","border_height":1,"border_color":"#ebebeb","reset_spacing":false}},"shopable_video_Gkfqr9":{"type":"shopable-video","blocks":{"video_iajgHi":{"type":"video","settings":{"product":"lecavist-195-bottle-professional-wine-fridge-lcs300vx1zpro","video_url":"","local_video":"shopify:\/\/files\/videos\/manu HD Final_caeb9c78-9f9b-4402-82bb-67f541aba57e.mp4"}},"video_tBzBMb":{"type":"video","settings":{"product":"lecavist-63-bottle-wine-fridg