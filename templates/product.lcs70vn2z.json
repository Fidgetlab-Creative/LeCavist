      "blocks": {
        "tab_features": {
          "type": "features",
          "settings": {
            "heading": "Features",
            "feat_icon_1": "bottle",
            "feat_title_1": "68 Bottle Capacity",
            "feat_image_1": "shopify://shop_images/LCS70VN2Z_1_61ae791b-3a96-4aff-ad5c-eb9df21b54e0.png",
            "feat_content_1": "<p>Holds up to <strong>68 Bordeaux bottles</strong> in a slim, freestanding footprint — generous capacity without dominating the room.</p>",
            "feat_icon_2": "temperature",
            "feat_title_2": "Dual Zone Temperature Control",
            "feat_image_2": "shopify://shop_images/LCS70VN2Z_15.png",
            "feat_content_2": "<p>Two independently controlled zones hold precise temperatures at once — from Champagne at 5–8°C to reds at 12–18°C.</p>",
            "feat_icon_3": "temperature",
            "feat_title_3": "Fan-Assisted Cooling",
            "feat_image_3": "shopify://shop_images/LCS70VN2Z_3_7559c0bb-6812-4ead-a3b2-56a6ac925eae.png",
            "feat_content_3": "<p>A circulation fan keeps the temperature uniform throughout the cabinet, so every bottle ages evenly.</p>",
            "feat_icon_4": "filter",
            "feat_title_4": "Charcoal Air Filtration",
            "feat_image_4": "shopify://shop_images/LCS70VN2Z_12.png",
            "feat_content_4": "<p>An activated-charcoal filter absorbs odours and impurities, keeping the air around your wine clean and fresh.</p>",
            "feat_icon_5": "led-lighting",
            "feat_title_5": "Soft LED Lighting",
            "feat_image_5": "shopify://shop_images/LCS70VN2Z_11.png",
            "feat_content_5": "<p>Gentle interior LED lighting showcases your collection without heat or UV exposure.</p>",
            "feat_icon_6": "uv-resistant",
            "feat_title_6": "UV-Resistant Tempered Glass",
            "feat_image_6": "shopify://shop_images/LCS70VN2Z_4_9d0218c2-29f0-4926-a6ef-87523927320f.png",
            "feat_content_6": "<p>A triple-layer tempered glass door with Low-E film blocks harmful UV rays and insulates against temperature swings.</p>",
            "feat_icon_7": "shelf",
            "feat_title_7": "Beech Wood Shelves",
            "feat_image_7": "shopify://shop_images/LCS70VN2Z_14.png",
            "feat_content_7": "<p>Removable beech-wood-trimmed racks slide out for easy access — or reconfigure them to display prized bottles upright.</p>",
            "feat_icon_8": "anti-vibration",
            "feat_title_8": "Anti-Vibration Technology",
            "feat_image_8": "shopify://shop_images/LCS70VN2Z_5.png",
            "feat_content_8": "<p>A low-vibration compressor eliminates shelf vibration, keeping sediment undisturbed so your wine ages gracefully.</p>",
            "feat_icon_9": "winter",
            "feat_title_9": "Winter Function",
            "feat_image_9": "shopify://shop_images/LCS70VN2Z_18.png",
            "feat_content_9": "<p>Winter Function and severe-cold protection hold the ideal temperature all year — even in an unheated room — with managed humidity throughout.</p>",
            "feat_icon_10": "lock",
            "feat_title_10": "Recessed Handle & Lock",
            "feat_image_10": "shopify://shop_images/LCS70VN2Z_10.png",
            "feat_content_10": "<p>A sleek recessed handle keeps the design clean, while the integrated security lock keeps your collection safe.</p>",
            "feat_icon_11": "installation",
            "feat_title_11": "Freestanding",
            "feat_image_11": "shopify://shop_images/LCS70VN2Z_16.png",
            "feat_content_11": "<p>A slim, freestanding format slots into almost any space while still offering full dual-zone service-and-aging versatility.</p>",
            "feat_icon_12": "glass-holder",
            "feat_title_12": "Accessories",
            "feat_image_12": "shopify://shop_images/LCS70VN2Z_2_eb089d60-47ac-4cee-8bd7-84f799a0ed76.png",
            "feat_content_12": "<p>Includes a dedicated glass rack, a built-in humidity watch display, and a removable wooden crate for accessories or cigars.</p>"
          }
