{% schema %}
{
  "name": "Service Red Banner",  // Change this to the desired name for your section
  "settings": [
    {
      "type": "range",
      "label": "Banner Height",
      "id": "banner_height",
      "min": 50,
      "max": 150,
      "step": 5,
      "default": 95
    }
  ],
  "presets": [
    {
      "name": "Service Red Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}

