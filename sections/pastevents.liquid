<section class="wine-events">
  <div class="page-width">

    <h2 class="wine-events-title">Inside the Wine Circle</h2>
    <p class="wine-events-intro">
      A look back at our private wine dinners and tasting experiences.
    </p>

    <!-- EVENT LOOP -->
    {% for i in (1..4) %}
      <div class="wine-event-block">

        <div class="wine-event-header">
          <h3>{% assign title_key = "title_" | append: i %}
            {{ section.settings[title_key] }}</h3>
          <p>{% assign desc_key = "desc_" | append: i %}
            {{ section.settings[desc_key] }}</p>
        </div>

        <!-- IMAGE SCROLLER -->
        <div class="wine-event-gallery">
          {% for j in (1..6) %}
            {% assign image_key = "image_" | append: i | append: "_" | append: j %}
            {% assign img = section.settings[image_key] %}

            {% if img %}
              <div class="wine-event-image">
                <img
                  src="{{ img | image_url: width: 800 }}"
                  alt="{{ img.alt | escape }}"
                  width="{{ img.width }}"
                  height="{{ img.height }}"
                  loading="lazy"
                >
              </div>
            {% endif %}
          {% endfor %}
        </div>

      </div>
    {% endfor %}

  </div>
</section>

<style>
.wine-events {
  padding: 80px 0;
}

.wine-events-title {
  text-align: center;
  font-size: 36px;
  margin-bottom: 10px;
}

.wine-events-intro {
  text-align: center;
  color: #666;
  margin-bottom: 60px;
}

/* EVENT BLOCK */
.wine-event-block {
  margin-bottom: 60px;
}

.wine-event-header h3 {
  font-size: 24px;
  margin-bottom: 5px;
}

.wine-event-header p {
  color: #666;
  margin-bottom: 20px;
}

/* HORIZONTAL SCROLL */
.wine-event-gallery {
  display: flex;
  gap: 15px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding-bottom: 10px;
}

.wine-event-gallery::-webkit-scrollbar {
  height: 6px;
}

.wine-event-gallery::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 3px;
}

/* IMAGE ITEM */
.wine-event-image {
  flex: 0 0 250px;
  scroll-snap-align: start;
  overflow: hidden;
  border-radius: 10px;
}

.wine-event-image img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.wine-event-image:hover img {
  transform: scale(1.05);
}

/* MOBILE */
@media screen and (max-width: 749px) {
  .wine-event-image {
    flex: 0 0 200px;
  }

  .wine-event-image img {
    height: 150px;
  }
}
</style>

