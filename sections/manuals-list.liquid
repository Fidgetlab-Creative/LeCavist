{%- comment -%}
  Manuals & Spec Sheets — DYNAMIC
  Loops the chosen collection and reads each product's Manual / Spec Sheet from its
  metafields (custom.manual_pdf / custom.spec_sheet). Those same metafields drive the
  product page, so editing a product's metafield updates BOTH places — single source of truth.
  Note: a Liquid collection loop renders up to 50 products; raise via a metaobject if the
  active cabinet count ever exceeds this.
{%- endcomment -%}

{%- liquid
  assign acc = section.settings.accent_color | default: '#d0473e'
  assign brd = section.settings.border_color | default: '#ebebeb'
  assign coll = collections[section.settings.collection]
-%}

<style>
  #manuals-{{ section.id }} {
    --mn-accent: {{ acc }};
    --mn-border: {{ brd }};
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
  #manuals-{{ section.id }} .mn-head { text-align: center; margin-bottom: 28px; }
  #manuals-{{ section.id }} .mn-title { margin: 0 0 10px; }
  #manuals-{{ section.id }} .mn-sub { margin: 0 auto; max-width: 640px; opacity: .8; }
  #manuals-{{ section.id }} .mn-search {
    display: block; width: 100%; max-width: 420px; margin: 22px auto 0;
    padding: 12px 16px; border: 1px solid var(--mn-border); border-radius: 8px;
    font: inherit; font-size: 15px;
  }
  #manuals-{{ section.id }} .mn-list { margin-top: 26px; border-top: 1px solid var(--mn-border); }
  #manuals-{{ section.id }} .mn-item { border-bottom: 1px solid var(--mn-border); }
  #manuals-{{ section.id }} .mn-toggle {
    width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    background: none; border: 0; cursor: pointer; text-align: left;
    padding: 20px 4px; font: inherit; font-size: 17px; font-weight: 600; color: inherit;
  }
  #manuals-{{ section.id }} .mn-toggle:hover { color: var(--mn-accent); }
  #manuals-{{ section.id }} .mn-chevron { flex: 0 0 auto; transition: transform .25s ease; }
  #manuals-{{ section.id }} .mn-toggle[aria-expanded="true"] .mn-chevron { transform: rotate(180deg); }
  #manuals-{{ section.id }} .mn-panel { overflow: hidden; max-height: 0; transition: max-height .3s ease; }
  #manuals-{{ section.id }} .mn-panel-inner { padding: 0 4px 22px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  #manuals-{{ section.id }} .mn-file {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 11px 18px; border: 1px solid var(--mn-border); border-radius: 8px;
    text-decoration: none; color: inherit; font-size: 14px; font-weight: 500; transition: all .15s ease;
  }
  #manuals-{{ section.id }} .mn-file:hover { border-color: var(--mn-accent); color: var(--mn-accent); }
  #manuals-{{ section.id }} .mn-product-link {
    display: inline-flex; align-items: center; gap: 6px; margin-left: auto;
    font-size: 13px; font-weight: 500; color: var(--mn-accent); text-decoration: none;
  }
  #manuals-{{ section.id }} .mn-product-link:hover { text-decoration: underline; }
  #manuals-{{ section.id }} .mn-empty { padding: 14px 4px; opacity: .7; font-size: 14px; }
  #manuals-{{ section.id }} .mn-noresult { display: none; padding: 30px 4px; text-align: center; opacity: .7; }
</style>

<div id="manuals-{{ section.id }}" class="manuals-section">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="mn-head">
      {%- if section.settings.heading != blank -%}<h1 class="mn-title">{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<div class="mn-sub">{{ section.settings.subheading }}</div>{%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_search -%}
    <input type="text" class="mn-search" placeholder="{{ section.settings.search_placeholder | escape }}" data-manuals-search aria-label="Search manuals">
  {%- endif -%}

  <div class="mn-list" data-manuals-list>
    {%- comment -%}
      Pass 1: build a sortable key per product = zero-padded bottle capacity + index.
      Capacity comes from lecavist_specs.bottle_capacity (fallback custom.bottle_capacity);
      `times: 1` extracts the leading number ("237L" -> 237). Missing/zero sorts last (99999).
      Only products that have a Manual or Spec metafield are included — so the page auto-sorts
      and auto-includes new cabinets with no manual edits needed.
    {%- endcomment -%}
    {%- assign keys = '' -%}
    {%- for product in coll.products -%}
      {%- if product.metafields.custom.manual_pdf.value == blank and product.metafields.custom.spec_sheet.value == blank -%}{%- continue -%}{%- endif -%}
      {%- assign cap = product.metafields.lecavist_specs.bottle_capacity.value | default: product.metafields.custom.bottle_capacity.value -%}
      {%- assign capnum = cap | times: 1 -%}
      {%- if capnum <= 0 -%}{%- assign capnum = 99999 -%}{%- endif -%}
      {%- assign capstr = capnum | append: '' -%}
      {%- assign n = capstr | size -%}
      {%- if n == 1 -%}{%- assign capstr = '0000' | append: capstr -%}
      {%- elsif n == 2 -%}{%- assign capstr = '000' | append: capstr -%}
      {%- elsif n == 3 -%}{%- assign capstr = '00' | append: capstr -%}
      {%- elsif n == 4 -%}{%- assign capstr = '0' | append: capstr -%}
      {%- endif -%}
      {%- assign keys = keys | append: capstr | append: '__' | append: forloop.index0 | append: ',' -%}
    {%- endfor -%}
    {%- assign keylist = keys | split: ',' | sort -%}
    {%- assign count = 0 -%}
    {%- comment -%} Pass 2: render in sorted order, looking each product back up by its index. {%- endcomment -%}
    {%- for key in keylist -%}
      {%- assign idx = key | split: '__' | last | times: 1 -%}
      {%- assign product = coll.products[idx] -%}
      {%- assign manual = product.metafields.custom.manual_pdf.value -%}
      {%- assign spec = product.metafields.custom.spec_sheet.value -%}
      {%- assign count = count | plus: 1 -%}
      {%- assign open = false -%}
      {%- if count == 1 and section.settings.open_first -%}{%- assign open = true -%}{%- endif -%}
      <div class="mn-item" data-manuals-item data-name="{{ product.title | downcase | escape }}">
        <button type="button" class="mn-toggle" aria-expanded="{{ open }}" aria-controls="mn-panel-{{ section.id }}-{{ product.id }}">
          <span>{{ product.title }}</span>
          <svg class="mn-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="mn-panel" id="mn-panel-{{ section.id }}-{{ product.id }}" {% if open %}style="max-height:400px"{% endif %}>
          <div class="mn-panel-inner">
            {%- if manual != blank -%}
              <a class="mn-file" href="{{ manual }}" target="_blank" rel="noopener">{%- render 'icon-pdf' -%}{{ section.settings.manual_label }}</a>
            {%- endif -%}
            {%- if spec != blank -%}
              <a class="mn-file" href="{{ spec }}" target="_blank" rel="noopener">{%- render 'icon-pdf' -%}{{ section.settings.spec_label }}</a>
            {%- endif -%}
            <a class="mn-product-link" href="{{ product.url }}">View product →</a>
          </div>
        </div>
      </div>
    {%- endfor -%}
    {%- if count == 0 -%}
      <p class="mn-empty">No documents found. Make sure the collection is set and products have a Manual or Spec Sheet metafield.</p>
    {%- endif -%}
    <div class="mn-noresult" data-manuals-noresult>No cabinets match your search.</div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('manuals-{{ section.id }}');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('.mn-toggle');
      if (!btn) return;
      var panel = document.getElementById(btn.getAttribute('aria-controls'));
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      panel.style.maxHeight = open ? '0px' : (panel.scrollHeight + 40) + 'px';
    });
    var search = root.querySelector('[data-manuals-search]');
    if (search) {
      search.addEventListener('input', function () {
        var q = this.value.trim().toLowerCase();
        var items = root.querySelectorAll('[data-manuals-item]');
        var shown = 0;
        items.forEach(function (it) {
          var match = it.getAttribute('data-name').indexOf(q) !== -1;
          it.style.display = match ? '' : 'none';
          if (match) shown++;
        });
        var nr = root.querySelector('[data-manuals-noresult]');
        if (nr) nr.style.display = shown === 0 ? 'block' : 'none';
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Manuals & Spec Sheets",
  "tag": "section",
  "class": "section-manuals",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection to list", "info": "Each product's Manual/Spec are read from its metafields (custom.manual_pdf / custom.spec_sheet). Products without either are skipped." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Manuals & Spec Sheets" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Download the user manual and specification sheet for each of our wine cabinets.</p>" },
    { "type": "checkbox", "id": "show_search", "label": "Show search box", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search by model or name…" },
    { "type": "checkbox", "id": "open_first", "label": "Open first item by default", "default": false },
    { "type": "header", "content": "Button labels" },
    { "type": "text", "id": "manual_label", "label": "Manual button label", "default": "Download Manual (PDF)" },
    { "type": "text", "id": "spec_label", "label": "Spec sheet button label", "default": "Download Spec Sheet (PDF)" },
    { "type": "header", "content": "Layout & colours" },
    { "type": "range", "id": "max_width", "min": 600, "max": 1200, "step": 20, "unit": "px", "label": "Max width", "default": 900 },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#d0473e" },
    { "type": "color", "id": "border_color", "label": "Border colour", "default": "#ebebeb" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "presets": [
    { "name": "Manuals & Spec Sheets" }
  ]
}
{% endschema %}
