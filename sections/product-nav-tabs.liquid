<style>
.lc-tabs-section { padding-bottom: 60px; }
/* z-index kept below the site header (.shopify-section-header-sticky is z-index 11)
   so the header's dropdown menus open ABOVE this sticky tab bar. Still positive,
   so the bar stays above normal page content as it scrolls underneath. */
.lc-tabs-nav { position: sticky; top: var(--header-height, 0px); z-index: 9; background: #fff; border-bottom: 1px solid #e5e0db; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
.lc-tabs-nav__inner { display: flex; overflow-x: auto; scrollbar-width: none; }
.lc-tabs-nav__inner::-webkit-scrollbar { display: none; }
.lc-tabs-nav__tab { flex-shrink: 0; padding: 16px 22px; font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #7a5a5a; background: none; border: none; cursor: pointer; transition: color 0.2s; white-space: nowrap; }
/* Delivery tab: "Delivery And Service" on desktop, "Service" on mobile */
.lc-navtab-label--mob { display: none; }
.lc-tabs-nav__tab.is-active, .lc-tabs-nav__tab:hover { color: #3a0d16; }
.lc-tabs-nav__line-track { position: relative; height: 3px; }
.lc-tabs-nav__line { position: absolute; bottom: 0; height: 3px; background: #7c3030; border-radius: 2px 2px 0 0; transition: left 0.25s ease, width 0.25s ease; }

.lc-tab-panel { display: none; padding: 32px 0; }
.lc-tab-panel.is-active { display: block; }
.lc-tab-panel__content { max-width: 880px; }
.lc-prose { font-size: 16px; line-height: 1.75; color: #3d2020; }
.lc-prose p { margin: 0 0 12px; }
.lc-prose ul, .lc-prose ol { margin: 0 0 12px; padding-left: 20px; }
.lc-prose strong { color: #3a0d16; }
.lc-prose a { color: #7c3030; }
.lc-prose--sm { font-size: 16px; }

/* Features */
.lc-feat-layout { display: grid; grid-template-columns: 1fr; gap: 24px; }
@media (min-width: 900px) { .lc-feat-layout { grid-template-columns: 320px 1fr; align-items: start; gap: 36px; } }
.lc-feat-icons { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
@media (min-width: 900px) { .lc-feat-icons { grid-template-columns: repeat(3, 1fr); } }
.lc-feat-card { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 14px 8px 12px; background: #fff; border: 1.5px solid #e5e0db; border-radius: 10px; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s, background 0.15s; text-align: center; }
.lc-feat-card:hover { border-color: #d4b0b0; box-shadow: 0 3px 10px rgba(124,48,48,0.1); }
.lc-feat-card.is-active { border-color: #7c3030; background: #f5ede5; }
.lc-feat-card__icon { width: 36px; height: 36px; color: #7a5a5a; display: flex; align-items: center; justify-content: center; }
.lc-feat-card__icon svg { width: 100%; height: 100%; }
.lc-feat-card.is-active .lc-feat-card__icon { color: #7c3030; }
.lc-feat-card__label { font-size: 11px; font-weight: 600; color: #3d2020; line-height: 1.3; }
.lc-feat-panels { }
.lc-feat-panel { display: none; }
.lc-feat-panel.is-active { display: flex; flex-direction: column; border-radius: 14px; overflow: hidden; border: 1px solid #e5e0db; }
.lc-feat-panel__image { flex-shrink: 0; min-height: 220px; overflow: hidden; }
.lc-feat-panel__image img { width: 100%; height: 100%; object-fit: cover; display: block; }
.lc-feat-panel__text { padding: 28px 30px; background: #3a0d16; flex: 1; }
.lc-feat-panel__heading { font-family: 'Cormorant Garamond', 'Times New Roman', serif; font-size: 24px; font-weight: 400; color: #fff; margin: 0 0 12px; }
.lc-feat-panel__body { font-size: 16px; line-height: 1.7; color: rgba(255,255,255,0.85); }
.lc-feat-panel__body p { margin: 0 0 8px; }
.lc-feat-panel__body strong { color: #fff; }

/* Specs */
.lc-spec-table-wrap { overflow-x: auto; margin-bottom: 16px; }
.lc-spec-table { width: 100%; border-collapse: collapse; font-size: 16px; }
.lc-spec-table th { background: #3a0d16; color: #fff; font-weight: 600; padding: 10px 16px; text-align: center; }
.lc-spec-table td { padding: 10px 16px; border-bottom: 1px solid #f0e8e5; color: #3d2020; vertical-align: top; text-align: center; }
.lc-spec-table tr:nth-child(even) td { background: #faf6f4; }
.lc-spec-table td:first-child { font-weight: 600; width: 48%; color: #7a5a5a; white-space: nowrap; }
.lc-spec-note { font-size: 12px; color: #9a7a7a; line-height: 1.5; margin-top: 8px; }
.lc-spec-note a { color: #7c3030; }

/* Delivery */
.lc-delivery-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 40px; }
@media (min-width: 768px) { .lc-delivery-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 480px) { .lc-delivery-grid { grid-template-columns: 1fr; } }
.lc-delivery-card { padding: 20px; background: #fff; border: 1px solid #e5e0db; border-radius: 12px; }
.lc-delivery-card__icon { width: 40px; height: 40px; color: #7c3030; margin-bottom: 12px; }
.lc-delivery-card__icon svg { width: 100%; height: 100%; }
.lc-delivery-card__title { font-size: 15px; font-weight: 700; color: #3a0d16; margin: 0 0 8px; }
.lc-delivery-card__body { font-size: 16px; line-height: 1.6; color: #5a3a3a; margin: 0; }
.lc-delivery-times { border-top: 1px solid #e5e0db; padding-top: 32px; }
.lc-delivery-times__heading { font-size: 18px; font-weight: 700; color: #3a0d16; margin: 0 0 8px; text-align: center; }
.lc-delivery-times__intro { font-size: 16px; color: #5a3a3a; margin: 0 0 20px; line-height: 1.6; }
.lc-delivery-times__table-wrap { overflow-x: auto; }

/* Docs */
.lc-doc-links { display: flex; flex-direction: column; gap: 10px; }
.lc-doc-link { display: inline-flex; align-items: center; gap: 10px; padding: 12px 18px; border: 1.5px solid #d4c4be; border-radius: 8px; font-size: 14px; font-weight: 600; color: #7c3030; text-decoration: none; transition: border-color 0.15s, background 0.15s; width: fit-content; }
.lc-doc-link:hover { border-color: #7c3030; background: #f5ede5; }

/* ── Manuals (redesigned documents tab) ── */
.lc-manuals-wrap { max-width: 640px; }
.lc-manual-row { display: flex; align-items: center; justify-content: space-between; padding: 18px 22px; border: 1px solid rgba(26,21,18,0.12); border-radius: 6px; background: rgba(26,21,18,0.02); text-decoration: none; color: inherit; margin-bottom: 10px; transition: border-color 0.15s, background 0.15s; }
.lc-manual-row:hover { border-color: #7c3030; background: #fdf5f0; }
.lc-manual-row__text { display: flex; flex-direction: column; gap: 3px; }
.lc-manual-row__title { font-size: 15px; font-weight: 600; color: #7c3030; }
.lc-manual-row__meta { font-size: 11px; letter-spacing: 0.08em; color: rgba(26,21,18,0.45); }
.lc-manual-row__dl { color: #7c3030; flex-shrink: 0; }

/* ── Quiz Banner ── */
/* lc-quiz-banner styles moved to sections/cabinet-finder-quiz.liquid */

@media (max-width: 767px) {
  .lc-tabs-nav__tab { padding: 14px 14px; font-size: 12px; }
  .lc-navtab-label--desk { display: none; }
  .lc-navtab-label--mob { display: inline; }
  .lc-tab-panel { padding: 20px 0; }
  .lc-feat-card__label { font-size: 10px; }
  .lc-feat-panel__text { padding: 20px 18px; }
  .lc-feat-panel__heading { font-size: 21px; }
}
</style>

<script>
(function() {
  var sid    = '{{ section.id }}';
  var navEl  = document.getElementById('lc-tabs-nav-' + sid);
  var lineEl = document.getElementById('lc-tabs-line-' + sid);
  if (!navEl) return;
  var inner  = navEl.querySelector('.lc-tabs-nav__inner');
  var tabs   = navEl.querySelectorAll('.lc-tabs-nav__tab');
  var panels = document.querySelectorAll('[id^="lc-tab-panel-' + sid + '-"]');

  function setLine(tab) {
    if (!lineEl || !inner) return;
    var lr = lineEl.parentElement.getBoundingClientRect();
    var tr = tab.getBoundingClientRect();
    lineEl.style.left  = (tr.left - lr.left) + 'px';
    lineEl.style.width = tr.width + 'px';
  }

  function activateTab(idx) {
    tabs.forEach(function(t, i) {
      t.classList.toggle('is-active', i === idx);
      t.setAttribute('aria-selected', i === idx ? 'true' : 'false');
    });
    panels.forEach(function(p, i) {
      p.classList.toggle('is-active', i === idx);
      i === idx ? p.removeAttribute('hidden') : p.setAttribute('hidden', '');
    });
    setLine(tabs[idx]);
    tabs[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    initFeatGrid(panels[idx]);
  }

  tabs.forEach(function(tab, i) { tab.addEventListener('click', function() { activateTab(i); }); });

  function initFeatGrid(panel) {
    if (!panel) return;
    var cards = panel.querySelectorAll('.lc-feat-card');
    var pw = panel.querySelector('[id^="lc-feat-panels-"]');
    if (!cards.length || !pw) return;
    cards.forEach(function(card) {
      if (card._lcInit) return;
      card._lcInit = true;
      card.addEventListener('click', function() {
        var idx = this.dataset.featIdx;
        cards.forEach(function(c) { c.classList.remove('is-active'); c.setAttribute('aria-selected','false'); });
        this.classList.add('is-active'); this.setAttribute('aria-selected','true');
        pw.querySelectorAll('.lc-feat-panel').forEach(function(fp) {
          var match = fp.dataset.featPanel == idx;
          fp.classList.toggle('is-active', match);
          match ? fp.removeAttribute('hidden') : fp.setAttribute('hidden','');
        });
        if (window.innerWidth < 768) pw.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
  }

  if (panels.length) initFeatGrid(panels[0]);
  window.addEventListener('load', function() { if (tabs.length) setLine(tabs[0]); });
  window.addEventListener('resize', function() {
    var ai = Array.from(tabs).findIndex(function(t) { return t.classList.contains('is-active'); });
    if (ai >= 0) setLine(tabs[ai]);
  });
  if (tabs.length) setLine(tabs[0]);
})();
</script>

