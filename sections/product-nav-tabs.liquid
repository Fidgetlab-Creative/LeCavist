{% comment %}
  ════════════════════════════════════════════════════════════
  LeCavist — Product Navigation Tabs
  File: sections/product-nav-tabs.liquid

  TABS available (block types):
    • description  — product description
    • features     — 3×3 clickable icon grid with content panel
    • specs        — auto specs by SKU from brochure data
    • delivery     — hardcoded delivery + service content
    • richtext     — any custom rich text
    • documents    — up to 3 downloadable PDFs

  Works on both mobile AND desktop (no display:none wrappers).
  ════════════════════════════════════════════════════════════
{% endcomment %}

{%- liquid
  assign section_st = section.settings
  assign sw         = section_st.section_width
  assign lc_sku     = product.selected_or_first_available_variant.sku | upcase | strip
-%}

{%- if section.blocks.size > 0 -%}
{%- comment %} Anchor target for in-page links (e.g. from FAQ → "view spec sheet"). scroll-margin-top accounts for the sticky header. {%- endcomment %}
<a id="product-manuals" aria-hidden="true" tabindex="-1" style="display:block;position:relative;top:-90px;visibility:hidden"></a>
<div class="lc-tabs-section" id="lc-tabs-{{ section.id }}">

  {%- comment %} ── Sticky tab bar ──────────────────────────── {%- endcomment %}
  <div class="lc-tabs-nav" id="lc-tabs-nav-{{ section.id }}" role="tablist">
    <div class="{{ sw }}">
      <div class="lc-tabs-nav__inner">
        {%- for block in section.blocks -%}
          <button
            class="lc-tabs-nav__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="lc-tab-panel-{{ section.id }}-{{ forloop.index }}"
            id="lc-tab-btn-{{ section.id }}-{{ forloop.index }}"
            data-tab="{{ forloop.index }}"
            type="button"
            {{ block.shopify_attributes }}
          >{%- if block.type == 'delivery' -%}<span class="lc-navtab-label--desk">Delivery And Service</span><span class="lc-navtab-label--mob">Service</span>{%- else -%}{{ block.settings.heading }}{%- endif -%}</button>
        {%- endfor -%}
      </div>
    </div>
    <div class="lc-tabs-nav__line-track">
      <div class="lc-tabs-nav__line" id="lc-tabs-line-{{ section.id }}"></div>
    </div>
  </div>

  {%- comment %} ── Panels ──────────────────────────────────── {%- endcomment %}
  <div class="{{ sw }}">
    {%- for block in section.blocks -%}
      <div
        class="lc-tab-panel{% if forloop.first %} is-active{% endif %}"
        role="tabpanel"
        id="lc-tab-panel-{{ section.id }}-{{ forloop.index }}"
        aria-labelledby="lc-tab-btn-{{ section.id }}-{{ forloop.index }}"
        {% unless forloop.first %}hidden{% endunless %}
        {{ block.shopify_attributes }}
      >

        {%- case block.type -%}

          {%- when 'description' -%}
            {%- liquid
              assign lc_ov_sp    = product.metafields.lecavist_specs
              assign lc_ov_cap   = lc_ov_sp.bottle_capacity.value
              assign lc_ov_noise = lc_ov_sp.noise_level_db.value
              assign lc_ov_temp  = lc_ov_sp.temperature_range.value
              assign lc_ov_head  = block.settings.overview_headline
              assign lc_ov_eye   = block.settings.overview_eyebrow | default: '◇ A Closer Look'
              # Beverage centres / mixed wine-beverage units never show a "Bottles" label
              assign lc_title_dc = product.title | downcase
              assign lc_is_bev   = false
              if lc_title_dc contains 'beverage cent' or lc_title_dc contains 'wine and beverage'
                assign lc_is_bev = true
              endif
            -%}
            <style>
              @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&display=swap');
              .lc-ov-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 0 72px; padding: 48px 0 32px; align-items: start; }
              @media (max-width: 767px) { .lc-ov-wrap { grid-template-columns: 1fr; gap: 28px; } }
              .lc-ov-left { padding-right: 8px; }
              .lc-ov-eyebrow { font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase; color: #7c3030; margin-bottom: 18px; display: block;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6B1F2E;
  }
              .lc-ov-headline { font-family: 'Cormorant Garamond','Times New Roman',serif; font-size: clamp(24px, 2.8vw, 38px); font-weight: 400; line-height: 1.15; color: #1A1512; margin: 0; letter-spacing: -0.01em; }
              .lc-ov-right { border-top: 1px solid rgba(26,21,18,0.12); padding-top: 0; }
              .lc-ov-desc { font-size: 16px; line-height: 1.75; color: rgba(26,21,18,0.7); padding: 20px 0 24px; border-bottom: 1px solid rgba(26,21,18,0.08); }
              .lc-ov-desc p { margin: 0 0 10px; }
              .lc-ov-desc p:last-child { margin-bottom: 0; }
              .lc-ov-stats { display: flex; gap: 32px; padding-top: 24px; flex-wrap: wrap; }
              .lc-ov-stat__val { font-family: 'Cormorant Garamond','Times New Roman',serif; font-size: 28px; font-weight: 300; color: #1A1512; display: block; line-height: 1; margin-bottom: 6px; }
              .lc-ov-stat__key { font-size: 9px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(26,21,18,0.45); }
            </style>
            <div class="lc-ov-wrap">
              <div class="lc-ov-left">
                <span class="lc-ov-eyebrow">{{ lc_ov_eye }}</span>
                {%- if lc_ov_head != blank -%}
                  <h2 class="lc-ov-headline">{{ lc_ov_head }}</h2>
                {%- else -%}
                  {%- comment -%} Auto-headline from product title if none set {%- endcomment -%}
                  <h2 class="lc-ov-headline">{{ product.title }}</h2>
                {%- endif -%}
              </div>
              <div class="lc-ov-right">
                {%- if block.settings.overview_custom_content != blank -%}
                  <div class="lc-ov-desc">
                    {{ block.settings.overview_custom_content }}
                  </div>
                {%- elsif product.description != blank -%}
                  <div class="lc-ov-desc">
                    {%- assign lc_ov_paras = product.description | split: '</p>' -%}
                    {%- assign lc_ov_count = 0 -%}
                    {%- for lc_ov_p in lc_ov_paras limit: 6 -%}
                      {%- assign lc_ov_pt = lc_ov_p | strip_html | strip -%}
                      {%- if lc_ov_pt != blank and lc_ov_count < 4 -%}
                        <p>{{ lc_ov_pt }}</p>
                        {%- assign lc_ov_count = lc_ov_count | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <div class="lc-ov-stats">
                  {%- if lc_ov_cap != blank -%}
                    <div class="lc-ov-stat"><span class="lc-ov-stat__val">{{ lc_ov_cap }}</span>{%- unless lc_is_bev -%}<span class="lc-ov-stat__key">Bottles</span>{%- endunless -%}</div>
                  {%- endif -%}
                  {%- if lc_ov_noise != blank -%}
                    <div class="lc-ov-stat"><span class="lc-ov-stat__val">{{ lc_ov_noise }} dB</span><span class="lc-ov-stat__key">Noise</span></div>
                  {%- endif -%}
                  {%- if lc_ov_temp != blank -%}
                    <div class="lc-ov-stat"><span class="lc-ov-stat__val">{{ lc_ov_temp }}</span><span class="lc-ov-stat__key">Range</span></div>
                  {%- endif -%}
                  <div class="lc-ov-stat"><span class="lc-ov-stat__val">5 yr</span><span class="lc-ov-stat__key">Warranty</span></div>
                </div>
              </div>
            </div>

          {%- when 'features' -%}
            <div class="lc-feat-wrap">
              <div class="lc-feat-layout">
                <div class="lc-feat-icons" role="tablist" aria-label="Product features">
                  {%- for i in (1..15) -%}
                    {%- assign f_title = 'feat_title_' | append: i -%}
                    {%- assign f_icon  = 'feat_icon_'  | append: i -%}
                    {%- if block.settings[f_title] != blank -%}
                      <button
                        class="lc-feat-card{% if forloop.first %} is-active{% endif %}"
                        data-feat-idx="{{ i }}"
                        data-feat-section="{{ section.id }}-{{ forloop.index }}"
                        role="tab"
                        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                        type="button"
                      >
                        <span class="lc-feat-card__icon" aria-hidden="true">
                          {%- assign lc_icon = block.settings[f_icon] | default: 'bottle' -%}
                          {%- case lc_icon -%}
                            {%- when 'glass-holder' -%}<svg viewBox="0 0 120 120" fill="none"><g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M49 46 C51 57 55 64 60 64 C65 64 69 57 71 46 C67 49 53 49 49 46 Z" fill="currentColor" stroke="none"/><ellipse cx="60" cy="30" rx="15" ry="3.4"/><path d="M45 30 C45 52 53 64 60 64 C67 64 75 52 75 30"/><line x1="60" y1="64" x2="60" y2="92"/><ellipse cx="60" cy="94" rx="13" ry="3"/></g></svg>
                            {%- when 'led-lighting' -%}<svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="13" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M16 19v4M13 23h6M16 4v2M6 13H4M12 7l-2-2M20 7l2-2M28 13h-2M20 19l2 2M12 19l-2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                            {%- when 'temperature' -%}<svg viewBox="0 0 120 120" fill="none"><g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="45" y="26" width="10" height="54" rx="5"/><circle cx="50" cy="88" r="9"/><circle cx="50" cy="88" r="5.5" fill="currentColor" stroke="none"/><line x1="50" y1="83" x2="50" y2="52" stroke="currentColor" stroke-width="5"/><line x1="57" y1="38" x2="62" y2="38"/><line x1="57" y1="48" x2="62" y2="48"/><line x1="57" y1="58" x2="62" y2="58"/><g stroke-width="2.2"><line x1="86" y1="40" x2="86" y2="72"/><line x1="72" y1="48" x2="100" y2="64"/><line x1="100" y1="48" x2="72" y2="64"/><polyline points="82,44 86,40 90,44"/><polyline points="82,68 86,72 90,68"/><polyline points="75,45 72,48 76,51"/><polyline points="96,45 100,48 96,51"/><polyline points="75,61 72,64 76,67"/><polyline points="96,61 100,64 96,67"/></g></g></svg>
                            {%- when 'air-flow' -%}<svg viewBox="0 0 32 32" fill="none"><path d="M4 12h16a4 4 0 000-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M4 16h20a4 4 0 010 8H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M4 20h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                            {%- when 'humidity' -%}<svg viewBox="0 0 32 32" fill="none"><path d="M16 4l8 12a8 8 0 11-16 0L16 4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 20a4 4 0 004 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                            {%- when 'bottle' -%}<svg viewBox="0 0 120 120" fill="none"><g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="55" y="18" width="10" height="9" rx="1.5"/><path d="M56 27 L56 46 C56 51 47 51 47 61 L47 104 Q47 110 53 110 L67 110 Q73 110 73 104 L73 61 C73 51 64 51 64 46 L64 27"/><rect x="49" y="76" width="22" height="20" rx="1.5"/></g></svg>
                            {%- when 'lock' -%}<svg viewBox="0 0 32 32" fill="none"><rect x="7" y="15" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M11 15v-4a5 5 0 0110 0v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="16" cy="21" r="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 23v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                            {%- when 'glass-door' -%}<svg viewBox="0 0 120 120" fill="none"><g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="38" y="20" width="44" height="80" rx="3"/><rect x="45" y="27" width="30" height="60" rx="2"/><line x1="70" y1="46" x2="70" y2="68"/><line x1="51" y1="78" x2="66" y2="47"/><line x1="58" y1="79" x2="69" y2="57"/><line x1="46" y1="100" x2="46" y2="107"/><line x1="74" y1="100" x2="74" y2="107"/></g></svg>
                            {%- when 'anti-vibration' -%}<svg viewBox="0 0 32 32" fill="none"><path d="M4 16h2M26 16h2M7 9l1.5 1.5M23.5 9L22 10.5M7 23l1.5-1.5M23.5 23L22 21.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="16" cy="16" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M16 13v3l2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            {%- when 'shelf' -%}<svg viewBox="0 0 120 120" fill="none"><g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="28" y="22" width="64" height="7" rx="2"/><rect x="28" y="90" width="64" height="7" rx="2"/><line x1="40" y1="30" x2="40" y2="90"/><line x1="50" y1="30" x2="50" y2="90"/><line x1="60" y1="30" x2="60" y2="90"/><line x1="70" y1="30" x2="70" y2="90"/><line x1="80" y1="30" x2="80" y2="90"/><line x1="32" y1="60" x2="88" y2="60"/></g></svg>
                            {%- when 'reversible-door' -%}<svg viewBox="0 0 120 120" fill="none"><g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="62" y="34" width="34" height="62" rx="2.5"/><line x1="68" y1="50" x2="90" y2="50"/><line x1="68" y1="65" x2="90" y2="65"/><line x1="68" y1="80" x2="90" y2="80"/><line x1="67" y1="58" x2="67" y2="72"/><g stroke="currentColor" stroke-opacity="0.5" stroke-width="2" stroke-dasharray="4 3"><rect x="24" y="34" width="34" height="62" rx="2.5"/></g><path d="M86 26 Q60 8 34 26" stroke-width="2.4"/><polyline points="40,20 34,26 41,31"/></g></svg>
                            {%- when 'filter' -%}<svg viewBox="0 0 120 120" fill="none"><g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="42" y="46" width="36" height="28" rx="5"/><polyline points="48,54 54,68 60,54 66,68 72,54"/><polyline points="48,68 54,54 60,68 66,54 72,68"/><line x1="18" y1="60" x2="38" y2="60"/><polyline points="32,55 38,60 32,65"/><line x1="82" y1="60" x2="102" y2="60"/><polyline points="96,55 102,60 96,65"/></g></svg>
                            {%- when 'uv-resistant' -%}<svg viewBox="0 0 120 120" fill="none"><g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="34" cy="50" r="9"/><line x1="34" y1="34" x2="34" y2="38"/><line x1="22" y1="38" x2="25" y2="41"/><line x1="18" y1="50" x2="22" y2="50"/><line x1="22" y1="62" x2="25" y2="59"/><line x1="34" y1="66" x2="34" y2="62"/><line x1="49" y1="45" x2="60" y2="45"/><line x1="49" y1="50" x2="60" y2="50"/><line x1="49" y1="55" x2="60" y2="55"/><path d="M84 28 L102 34 V58 C102 76 93 86 84 92 C75 86 66 76 66 58 V34 Z"/><text x="84" y="64" text-anchor="middle" font-family="Montserrat, Arial, sans-serif" font-size="16" font-weight="600" stroke="none" fill="currentColor">UV</text></g></svg>
                            {%- when 'winter' -%}<svg viewBox="0 0 120 120" fill="none"><g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="60" y1="60" x2="60.0" y2="33.0"/><line x1="60.0" y1="33.0" x2="64.2" y2="26.2"/><line x1="60.0" y1="33.0" x2="55.8" y2="26.2"/><line x1="60.0" y1="44.3" x2="63.2" y2="39.3"/><line x1="60.0" y1="44.3" x2="56.8" y2="39.3"/><line x1="60" y1="60" x2="36.6" y2="46.5"/><line x1="36.6" y1="46.5" x2="32.9" y2="39.4"/><line x1="36.6" y1="46.5" x2="28.6" y2="46.8"/><line x1="46.4" y1="52.2" x2="43.6" y2="46.9"/><line x1="46.4" y1="52.2" x2="40.4" y2="52.4"/><line x1="60" y1="60" x2="36.6" y2="73.5"/><line x1="36.6" y1="73.5" x2="28.6" y2="73.2"/><line x1="36.6" y1="73.5" x2="32.9" y2="80.6"/><line x1="46.4" y1="67.8" x2="40.4" y2="67.6"/><line x1="46.4" y1="67.8" x2="43.6" y2="73.1"/><line x1="60" y1="60" x2="60.0" y2="87.0"/><line x1="60.0" y1="87.0" x2="55.8" y2="93.8"/><line x1="60.0" y1="87.0" x2="64.2" y2="93.8"/><line x1="60.0" y1="75.7" x2="56.8" y2="80.7"/><line x1="60.0" y1="75.7" x2="63.2" y2="80.7"/><line x1="60" y1="60" x2="83.4" y2="73.5"/><line x1="83.4" y1="73.5" x2="87.1" y2="80.6"/><line x1="83.4" y1="73.5" x2="91.4" y2="73.2"/><line x1="73.6" y1="67.8" x2="76.4" y2="73.1"/><line x1="73.6" y1="67.8" x2="79.6" y2="67.6"/><line x1="60" y1="60" x2="83.4" y2="46.5"/><line x1="83.4" y1="46.5" x2="91.4" y2="46.8"/><line x1="83.4" y1="46.5" x2="87.1" y2="39.4"/><line x1="73.6" y1="52.2" x2="79.6" y2="52.4"/><line x1="73.6" y1="52.2" x2="76.4" y2="46.9"/></g></svg>
                            {%- when 'installation' -%}<svg viewBox="0 0 120 120" fill="none"><g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="38" y="16" width="44" height="88" rx="3"/><rect x="44" y="22" width="32" height="66" rx="2"/><line x1="46" y1="38" x2="74" y2="38"/><line x1="46" y1="54" x2="74" y2="54"/><line x1="46" y1="70" x2="74" y2="70"/><circle cx="52" cy="34" r="2.4"/><circle cx="60" cy="34" r="2.4"/><circle cx="68" cy="34" r="2.4"/><circle cx="52" cy="50" r="2.4"/><circle cx="60" cy="50" r="2.4"/><circle cx="68" cy="50" r="2.4"/><circle cx="52" cy="66" r="2.4"/><circle cx="60" cy="66" r="2.4"/><circle cx="68" cy="66" r="2.4"/><line x1="72" y1="48" x2="72" y2="62"/><line x1="50" y1="95" x2="70" y2="95"/><line x1="46" y1="104" x2="46" y2="111"/><line x1="74" y1="104" x2="74" y2="111"/></g></svg>
                            {%- else -%}<svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="16" r="11" stroke="currentColor" stroke-width="1.5"/><path d="M16 11v5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          {%- endcase -%}
                        </span>
                        <span class="lc-feat-card__label">{{ block.settings[f_title] }}</span>
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                <div class="lc-feat-panels" id="lc-feat-panels-{{ section.id }}-{{ forloop.index }}">
                  {%- for i in (1..15) -%}
                    {%- assign f_title   = 'feat_title_'   | append: i -%}
                    {%- assign f_content = 'feat_content_' | append: i -%}
                    {%- assign f_image   = 'feat_image_'   | append: i -%}
                    {%- if block.settings[f_title] != blank -%}
                      <div
                        class="lc-feat-panel{% if forloop.first %} is-active{% endif %}"
                        data-feat-panel="{{ i }}"
                        {% unless forloop.first %}hidden{% endunless %}
                      >
                        {%- if block.settings[f_image] != blank -%}
                          <div class="lc-feat-panel__image">
                            <img
                              src="{{ block.settings[f_image] | image_url: width: 900 }}"
                              alt="{{ block.settings[f_image].alt | default: block.settings[f_title] | escape }}"
                              width="900"
                              height="600"
                              loading="lazy"
                            >
                          </div>
                        {%- endif -%}
                        <div class="lc-feat-panel__text">
                          <h3 class="lc-feat-panel__heading">{{ block.settings[f_title] }}</h3>
                          <div class="lc-feat-panel__body">{{ block.settings[f_content] }}</div>
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>

          {%- when 'specs' -%}
            <div class="lc-tab-panel__content">

              {%- comment -%} Pull lecavist_specs metafields first, then fall back to SKU lookup {%- endcomment -%}
              {%- liquid
                assign lc_ns            = product.metafields.lecavist_specs
                assign lc_spec_capacity = lc_ns.bottle_capacity.value
                # Capacity: if it's just a number (e.g. "168") suffix " Bottles";
                # if it already has text/units (e.g. "133 + 200 Cans", "600L") leave it.
                assign lc_cap_str = lc_spec_capacity | strip
                assign lc_cap_rt  = lc_cap_str | plus: 0 | append: ''
                if lc_cap_str != blank and lc_cap_str == lc_cap_rt
                  assign lc_spec_capacity = lc_cap_str | append: ' Bottles'
                endif
                assign lc_spec_zone     = lc_ns.cooling_zone.value
                assign lc_spec_install  = lc_ns.installation_type.value
                assign lc_spec_temp     = lc_ns.temperature_range.value
                assign lc_spec_noise    = lc_ns.noise_level_db.value
                assign lc_spec_shelves  = lc_ns.shelves.value
                assign lc_spec_door     = lc_ns.door_type.value
                assign lc_spec_lock     = lc_ns.lock.value
                assign lc_spec_vibration = lc_ns.anti_vibration.value
                assign lc_spec_led      = lc_ns.led_display.value
                assign lc_spec_charcoal = lc_ns.charcoal_filter.value
