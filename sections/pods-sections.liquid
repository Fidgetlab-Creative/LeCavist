{%- comment -%}
  Section: pods-section.liquid
  Radial "Points of Difference" Section for Shopify
  Inspired by drinkhyro.com radial benefit layout
  — Supports image OR video hero with oval mask
  — Up to 6 POD blocks arranged left (3) / right (3)
  — All colours, fonts, text fully customisable via Theme Editor
{%- endcomment -%}

{%- liquid
  assign section_id = 'pods-' | append: section.id
  assign pods = section.blocks | where: 'type', 'pod'
  assign left_pods  = pods | slice: 0, 3
  assign right_pods = pods | slice: 3, 6
  assign has_heading    = section.settings.section_heading    | strip | size
  assign has_subheading = section.settings.section_subheading | strip | size
-%}

{%- comment -%} ── Scoped CSS (font_face MUST live inside a style tag) ── {%- endcomment -%}
<style>
  {%- comment -%}
    Typography is locked to the global brand pair (Inter Tight body /
    Cormorant Garamond headings) — the legacy per-block font pickers
    are intentionally ignored to keep the site uniform.
  {%- endcomment -%}
  /* ─── CSS Variables ─────────────────────────────── */
  #{{ section_id }} {
    --pods-bg:            {{ section.settings.background_color }};
    --pods-dot-color:     {{ section.settings.dot_color }};
    --pods-pt:            {{ section.settings.padding_top }}px;
    --pods-pb:            {{ section.settings.padding_bottom }}px;
    --pods-oval-w:        {{ section.settings.hero_width }}px;
    --pods-gap:           {{ section.settings.column_gap }}px;
  }

  /* ─── Wrapper ───────────────────────────────────── */
  #{{ section_id }} {
    background-color: transparent;
    padding-top: var(--pods-pt);
    padding-bottom: var(--pods-pb);
    overflow: visible;
    position: relative;
  }
  /* Rounded beige card — near full-width with a 20px gutter so its left/right
     edges line up with the full-width "Shop the Look" section below it. */
  .pods-inner {
    max-width: none;
    margin: 0 20px;
    background-color: var(--pods-bg);
    border-radius: 22px;
    padding: 56px clamp(24px, 5vw, 64px);
    overflow: hidden;
  }
  @media (max-width: 749px) {
    .pods-inner { border-radius: 16px; padding: 32px 16px; margin: 0 10px; }
  }

  /* ─── Section Headings ──────────────────────────── */
  .pods-header {
    text-align: center;
    margin-bottom: 48px;
  }
  /* Title — same treatment as the "Best Selling" section title
     (Inter Tight 18px / 700 / 0.28em / uppercase / ink). */
  .pods-eyebrow {
    display: block;
    font-family: 'Inter Tight', -apple-system, sans-serif;
    font-style: normal;
    font-weight: 700;
    font-size: 18px;
    color: #1A1512;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    line-height: 1.3;
    margin: 0 0 8px;
  }
  /* Subtitle — burgundy "— Choose your —" eyebrow style from the PDP
     configuration block (Inter Tight 12px / 500 / 0.08em / uppercase). */
  .pods-main-heading {
    font-family: 'Inter Tight', -apple-system, sans-serif;
    font-style: normal;
    font-weight: 500;
    font-size: 12px;
    color: #6B1F2E;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.4;
    margin: 0;
    max-width: 780px;
    margin-inline: auto;
  }

  /* ─── 3-Column Radial Layout ────────────────────── */
  /* Centre column hugs the hero image (= --pods-oval-w) instead of a fixed 2fr,
     so there's no dead space around the picture. The two side columns share ALL
     the remaining width (full card width), so the pod blocks are as wide as
     possible and the text reaches out toward the left/right edges. */
  .pods-layout {
    display: grid;
    grid-template-columns: 1fr minmax(0, var(--pods-oval-w)) 1fr;
    gap: var(--pods-gap);
    align-items: center;
  }

  /* ─── Left / Right POD Columns ──────────────────── */
  .pods-col {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  /* ─── Individual POD ────────────────────────────── */
  .pod {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .pod--left {
    flex-direction: row-reverse; /* text | icon → icon faces centre */
    text-align: right;
  }
  .pod--right {
    flex-direction: row;         /* icon | text */
    text-align: left;
  }

  /* Clickable pods (page link or capacity-popup button) */
  .pod-clickable {
    text-decoration: none;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    width: 100%;
    transition: transform 0.18s ease;
  }
  .pod-clickable:hover { transform: translateY(-2px); }
  .pod-clickable:hover .pod__icon-wrap { box-shadow: 0 4px 14px rgba(107,31,46,0.16); }
  .pod-clickable:focus-visible { outline: 2px solid #6B1F2E; outline-offset: 6px; border-radius: 8px; }

  .pod__icon-wrap {
    flex-shrink: 0;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .pod__icon-wrap img {
    width: 55%;
    height: 55%;
    object-fit: contain;
    display: block;
  }

  .pod__text {
    flex: 1;
  }
  .pod__heading {
    margin: 0 0 6px;
    line-height: 1.2;
    font-family: var(--body-font, 'Inter Tight', -apple-system, sans-serif);
    font-style: normal;
    font-weight: 600;
  }
  .pod__body {
    margin: 0;
    line-height: 1.5;
    font-family: var(--body-font, 'Inter Tight', -apple-system, sans-serif);
    font-style: normal;
    font-weight: 400;
  }

  /* ─── Hero Centre Column ────────────────────────── */
  .pods-hero-col {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Cap the centre hero so it honours the "Hero column width" setting
       (--pods-oval-w) and stops filling the whole 2fr track — otherwise it
       balloons on wide monitors. Centred within its grid cell. */
    max-width: var(--pods-oval-w);
    margin-inline: auto;
  }

  /* Dotted SVG ring — sized so the arc (r=90 of the 200 viewBox = 45% of the
     SVG box) lands exactly on the round image's edge (image radius = 50% of the
     column). 45% × 111% ≈ 50%, so the dotted arcs trace the crop border. */
  .pods-ring-svg {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 111%;
    aspect-ratio: 1 / 1;
    height: auto;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 0;
  }
  .pods-ring-svg circle {
    stroke: var(--pods-dot-color);
  }

  /* Round mask — 1:1 circle so it follows the dotted ring's curvature */
  .pods-oval {
    position: relative;
    z-index: 1;
    width: 100%;
    border-radius: 50%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #ddd;
    transition: transform 0.25s ease;
  }
  .pods-oval img,
  .pods-oval video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Full-cover invisible link overlay — sits on top via z-index */
  .pods-oval__link-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: block;
    cursor: pointer;
    background: transparent;
    transition: background 0.25s ease;
  }
  /* Hover: oval scales up + subtle dark tint */
  .pods-oval:has(.pods-oval__link-overlay):hover {
    transform: scale(1.04);
    transition: transform 0.25s ease;
  }
  .pods-oval__link-overlay:hover {
    background: rgba(0, 0, 0, 0.10);
  }
  .pods-oval__link-overlay:focus-visible {
    outline: 3px solid {{ section.settings.dot_color }};
    outline-offset: 8px;
    border-radius: 50%;
  }

  /* ─── Per-block font styles (injected inline via style attr) ─── */

  /* ─── Mobile: compact 3-col (pods | hero | pods) ── */
  @media (max-width: 899px) {

    .pods-main-heading {
      font-size: clamp(16px, 5vw, 28px);
    }
    .pods-header { margin-bottom: 24px; }

    /* Keep 3-col grid — bigger centre pic on mobile too */
    .pods-layout {
      grid-template-columns: 1fr 1.6fr 1fr;
      gap: 8px;
      align-items: center;
    }

    /* Tighter column gap */
    .pods-col { gap: 20px; }

    /* Icon smaller */
    .pod__icon-wrap {
      width: 36px;
      height: 36px;
      min-width: 36px;
    }
    .pod__icon-wrap img { width: 52%; height: 52%; }

    /* Hide body text — heading only */
    .pod__body { display: none; }

    /* Compact heading */
    .pod__heading {
      font-size: clamp(9px, 2.6vw, 13px) !important;
      line-height: 1.3;
      margin-bottom: 0;
      word-break: break-word;
    }

    /* Restore correct flex directions */
    .pod--left {
      flex-direction: row-reverse;
      text-align: right;
      align-items: center;
      gap: 6px;
    }
    .pod--right {
      flex-direction: row;
      text-align: left;
      align-items: center;
      gap: 6px;
    }

    /* Ring tracks the image edge on mobile too */
    .pods-ring-svg {
      width: 111%;
    }
  }

  /* ─── Very small phones (<380px) ─────────────────── */
  @media (max-width: 380px) {
    .pods-layout { grid-template-columns: 1fr 36% 1fr; gap: 4px; }
    .pod__icon-wrap { width: 30px; height: 30px; min-width: 30px; }
    .pod__heading { font-size: clamp(8px, 2.4vw, 11px) !important; }
    .pods-col { gap: 16px; }
  }
</style>

{%- comment -%} ── HTML ── {%- endcomment -%}
<section id="{{ section_id }}" class="pods-section" aria-label="{{ section.settings.section_heading | escape }}">
  <div class="pods-inner">

    {%- comment -%} Section header {%- endcomment -%}
    {%- if has_heading > 0 or has_subheading > 0 -%}
      <header class="pods-header">
        {%- if has_subheading > 0 -%}
          <p class="pods-eyebrow">{{ section.settings.section_subheading | escape }}</p>
        {%- endif -%}
        {%- if has_heading > 0 -%}
          <p class="pods-main-heading">— {{ section.settings.section_heading | escape }} —</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="pods-layout">

      {%- comment -%} ── LEFT COLUMN (blocks 1-3) ── {%- endcomment -%}
      <div class="pods-col pods-col--left">
        {%- for block in left_pods -%}
          {%- liquid
            assign pod_tag = 'div'
            assign pod_extra = ''
            if block.settings.pod_opens_capacity
              assign pod_tag = 'button'
              assign pod_extra = 'type="button" data-lc-cc-open aria-haspopup="dialog" aria-controls="lc-cc-modal"'
            elsif block.settings.pod_link != blank
              assign pod_tag = 'a'
              assign pod_extra = 'href="' | append: block.settings.pod_link | append: '"'
            endif
          -%}
          <{{ pod_tag }} class="pod pod--left{% unless pod_tag == 'div' %} pod-clickable{% endunless %}" {{ pod_extra }} {{ block.shopify_attributes }}>
            <div class="pod__icon-wrap" style="background-color: {{ block.settings.icon_bg_color }};">
              {%- if block.settings.icon != blank -%}
                <img
                  src="{{ block.settings.icon | image_url: width: 120 }}"
                  alt="{{ block.settings.pod_heading | escape }}"
                  width="60"
                  height="60"
                  loading="lazy"
                >
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="24" height="24"><circle cx="12" cy="12" r="10" opacity=".5"/></svg>
              {%- endif -%}
            </div>
            <div class="pod__text">
              {%- if block.settings.pod_heading != blank -%}
                <p class="pod__heading" style="
                  font-size: {{ block.settings.pod_heading_size }}px;
                  color: {{ block.settings.pod_heading_color }};
                ">{{ block.settings.pod_heading | escape }}</p>
              {%- endif -%}
              {%- if block.settings.pod_body != blank -%}
                <p class="pod__body" style="
                  font-size: {{ block.settings.pod_body_size }}px;
                  color: {{ block.settings.pod_body_color }};
                ">{{ block.settings.pod_body | escape }}</p>
              {%- endif -%}
            </div>
          </{{ pod_tag }}>
        {%- else -%}
          <p style="color: #999; font-size: 13px;">Add POD blocks to populate this column.</p>
        {%- endfor -%}
      </div>

      {%- comment -%} ── CENTRE HERO ── {%- endcomment -%}
      <div class="pods-hero-col">
        {%- comment -%} SVG dotted ring {%- endcomment -%}
        <svg class="pods-ring-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          {%- comment -%} Two dotted arcs — a bracket on the LEFT and one on the
             RIGHT of the image, each ~2/3 down its side. Open at top and bottom. {%- endcomment -%}
          {%- assign ring_stroke = section.settings.dot_color -%}
          <path d="M 55 22 A 90 90 0 0 0 55 178" fill="none"
            stroke="{{ ring_stroke }}" stroke-width="2.5" stroke-dasharray="4 10" stroke-linecap="round"/>
          <path d="M 145 22 A 90 90 0 0 1 145 178" fill="none"
            stroke="{{ ring_stroke }}" stroke-width="2.5" stroke-dasharray="4 10" stroke-linecap="round"/>
        </svg>

        {%- comment -%} Oval media {%- endcomment -%}
        <div class="pods-oval">

          {%- if section.settings.hero_type == 'video' and section.settings.hero_video_url != blank -%}
            <video
              src="{{ section.settings.hero_video_url }}"
              autoplay muted loop playsinline
              aria-label="{{ section.settings.section_heading | escape }}"
            ></video>
          {%- elsif section.settings.hero_image != blank -%}
            <img
              src="{{ section.settings.hero_image | image_url: width: 800 }}"
              alt="{{ section.settings.hero_link_label | default: section.settings.section_heading | escape }}"
              width="{{ section.settings.hero_width }}"
              height="{{ section.settings.hero_width | times: 1.33 | round }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'pods-placeholder' }}
          {%- endif -%}

          {%- comment -%} Link overlay rendered LAST so it sits on top of the image {%- endcomment -%}
          {%- if section.settings.hero_link != blank -%}
            <a class="pods-oval__link-overlay"
               href="{{ section.settings.hero_link }}"
               aria-label="{{ section.settings.hero_link_label | default: 'Find your perfect cabinet' | escape }}"
               {%- if section.settings.hero_link_new_tab -%} target="_blank" rel="noopener"{%- endif -%}
            ></a>
          {%- endif -%}

        </div>
      </div>

      {%- comment -%} ── RIGHT COLUMN (blocks 4-6) ── {%- endcomment -%}
      <div class="pods-col pods-col--right">
        {%- for block in right_pods -%}
          {%- liquid
            assign pod_tag = 'div'
            assign pod_extra = ''
            if block.settings.pod_opens_capacity
              assign pod_tag = 'button'
              assign pod_extra = 'type="button" data-lc-cc-open aria-haspopup="dialog" aria-controls="lc-cc-modal"'
            elsif block.settings.pod_link != blank
              assign pod_tag = 'a'
              assign pod_extra = 'href="' | append: block.settings.pod_link | append: '"'
            endif
          -%}
          <{{ pod_tag }} class="pod pod--right{% unless pod_tag == 'div' %} pod-clickable{% endunless %}" {{ pod_extra }} {{ block.shopify_attributes }}>
            <div class="pod__icon-wrap" style="background-color: {{ block.settings.icon_bg_color }};">
              {%- if block.settings.icon != blank -%}
                <img
                  src="{{ block.settings.icon | image_url: width: 120 }}"
                  alt="{{ block.settings.pod_heading | escape }}"
                  width="60"
                  height="60"
                  loading="lazy"
                >
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="24" height="24"><circle cx="12" cy="12" r="10" opacity=".5"/></svg>
              {%- endif -%}
            </div>
            <div class="pod__text">
              {%- if block.settings.pod_heading != blank -%}
                <p class="pod__heading" style="
                  font-size: {{ block.settings.pod_heading_size }}px;
                  color: {{ block.settings.pod_heading_color }};
                ">{{ block.settings.pod_heading | escape }}</p>
              {%- endif -%}
              {%- if block.settings.pod_body != blank -%}
                <p class="pod__body" style="
                  font-size: {{ block.settings.pod_body_size }}px;
                  color: {{ block.settings.pod_body_color }};
                ">{{ block.settings.pod_body | escape }}</p>
              {%- endif -%}
            </div>
          </{{ pod_tag }}>
        {%- endfor -%}
      </div>

    </div>{%- comment -%} /.pods-layout {%- endcomment -%}
  </div>{%- comment -%} /.pods-inner {%- endcomment -%}
</section>

{%- comment -%}
  If any pod opens the capacity calculator, render its shared modal + JS once.
  (The modal is position:fixed, so its DOM location doesn't matter visually.)
{%- endcomment -%}
{%- assign pods_has_capacity = false -%}
{%- for block in pods -%}
  {%- if block.settings.pod_opens_capacity -%}{%- assign pods_has_capacity = true -%}{%- endif -%}
{%- endfor -%}
{%- if pods_has_capacity -%}
  {%- render 'capacity-calculator' -%}
{%- endif -%}

{% schema %}
{
  "name": "POD Radial Section",
  "tag": "section",
  "class": "pods-radial-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#f5ede4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 32
    },
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Main heading",
      "default": "What proper hydration actually feels like"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (px)",
      "min": 18,
      "max": 72,
      "step": 2,
      "default": 36
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Section Eyebrow / Subheading"
    },
    {
      "type": "text",
      "id": "section_subheading",
      "label": "Eyebrow / subheading text",
      "default": "Why it matters"
    },
    {
      "type": "font_picker",
      "id": "subheading_font",
      "label": "Subheading font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size (px)",
      "min": 10,
      "max": 28,
      "step": 1,
      "default": 13
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading colour",
      "default": "#cc2222"
    },
    {
      "type": "header",
      "content": "Hero Media"
    },
    {
      "type": "select",
      "id": "hero_type",
      "label": "Hero type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video (URL)" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Used when Hero type is set to Image. Recommended: portrait/vertical format."
    },
    {
      "type": "text",
      "id": "hero_video_url",
      "label": "Hero video URL",
      "info": "Used when Hero type is set to Video. Paste a direct .mp4 link (e.g. from your Shopify Files)."
    },
    {
      "type": "range",
      "id": "hero_width",
      "label": "Hero image size (px)",
      "min": 140,
      "max": 600,
      "step": 10,
      "default": 300
    },
    {
      "type": "header",
      "content": "Hero Link (click action)"
    },
    {
      "type": "text",
      "id": "hero_link",
      "label": "Hero link URL",
      "info": "Paste any URL here — internal (/pages/find-my-cabinet) or external (https://yourquiz.typeform.com/...)."
    },
    {
      "type": "text",
      "id": "hero_link_label",
      "label": "Link aria-label",
      "default": "Find your perfect cabinet",
      "info": "Accessibility label read by screen readers."
    },
    {
      "type": "checkbox",
      "id": "hero_link_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Dot Ring"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot ring colour",
      "default": "#cc2222"
    }
  ],
  "blocks": [
    {
      "type": "pod",
      "name": "POD Item",
      "settings": [
        {
          "type": "header",
          "content": "Link / Action"
        },
        {
          "type": "url",
          "id": "pod_link",
          "label": "Pod link",
          "info": "Where this pod goes when clicked. Leave blank for no link."
        },
        {
          "type": "checkbox",
          "id": "pod_opens_capacity",
          "label": "Open capacity calculator popup instead",
          "default": false,
          "info": "If on, clicking this pod opens the 'Find my perfect capacity' popup (ignores the link above)."
        },
        {
          "type": "header",
          "content": "Icon"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image",
          "info": "PNG or SVG. Recommended: square, transparent background, ~120×120px."
        },
        {
          "type": "color",
          "id": "icon_bg_color",
          "label": "Icon circle background colour",
          "default": "#cc2222"
        },
        {
          "type": "header",
          "content": "POD Heading"
        },
        {
          "type": "text",
          "id": "pod_heading",
          "label": "Heading text",
          "default": "Less Thirst"
        },
        {
          "type": "font_picker",
          "id": "pod_heading_font",
          "label": "Heading font",
          "default": "assistant_n7"
        },
        {
          "type": "range",
          "id": "pod_heading_size",
          "label": "Heading size (px)",
          "min": 12,
          "max": 48,
          "step": 1,
          "default": 17
        },
        {
          "type": "color",
