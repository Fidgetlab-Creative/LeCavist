{%- comment -%}
  LeCavist: collection size table, shown below the product grid.
  Same table styling as the comparison table (lc-collection-table.liquid).
  Driven by collection metafields, so collections without them render nothing:
    custom.size_table_title   single line text (falls back to the section's Table title setting)
    custom.size_table_note    single line text, shown in small grey text below the table
    custom.size_table         list of collection_size_table
      (model, bottles, zones, cabinet_w_x_h_x_d_mm)
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign table_title = collection.metafields.custom.size_table_title.value | default: section_st.heading
  assign table_items = collection.metafields.custom.size_table.value
  assign table_note = collection.metafields.custom.size_table_note.value
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}
{%- if table_items.size > 0 -%}
  {%- style -%}
    .lc-compare__inner {
      max-width: 1100px;
    }
    .lc-compare__title {
      margin: 0 0 15px;
    }
    .lc-compare__table-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: 0;
    }
    .lc-compare__table {
      width: 100%;
      min-width: 560px;
      border-collapse: collapse;
      text-align: left;
      border-top: 1px solid #a9a49f;
      border-bottom: 1px solid #a9a49f;
    }
    .lc-compare__table th,
    .lc-compare__table td {
      padding: 12px 16px;
      vertical-align: top;
      border-bottom: 1px solid #a9a49f;
      border-color: #a9a49f;
    }
    .lc-compare__table thead th,
    .lc-compare__table th + th,
    .lc-compare__table td + td {
      border-left: 1px solid #a9a49f;
    }
    .lc-compare__table thead th {
      background: #fdfaf5;
      border-color: #a9a49f;
      font-weight: 600;
    }
    .lc-compare__table tbody tr:last-child th,
    .lc-compare__table tbody tr:last-child td {
      border-bottom: 0;
    }
    .lc-compare__table tbody th {
      font-weight: 600;
    }
    .lc-compare__note {
      margin: 10px 0 0;
      font-size: 12px;
      color: #6b6b6b;
    }
  {%- endstyle -%}
  <div
    class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__lc-collection-size-table"
    style="{{ style | strip | strip_newlines }}"
  >
    <div class="{{ section_width }}">
      <div class="lc-compare__inner">
        {%- if table_title != blank -%}
          <h2 class="lc-compare__title heading-letter-spacing h3">{{ table_title }}</h2>
        {%- endif -%}
        <div
          class="lc-compare__table-wrap"
          role="region"
          tabindex="0"
          aria-label="{{ table_title | default: collection.title | escape }}"
        >
          <table class="lc-compare__table">
            <thead>
              <tr>
                <th scope="col">Model</th>
                <th scope="col">Bottles</th>
                <th scope="col">Zones</th>
                <th scope="col">Cabinet W x H x D (mm)</th>
              </tr>
            </thead>
            <tbody>
              {%- for item in table_items -%}
                <tr>
                  <th scope="row">{{ item.model }}</th>
                  <td>{{ item.bottles }}</td>
                  <td>{{ item.zones }}</td>
                  <td>{{ item.cabinet_w_x_h_x_d_mm }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        {%- if table_note != blank -%}
          <p class="lc-compare__note">{{ table_note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="section sec__lc-collection-size-table" style="{{ style | strip | strip_newlines }}">
    <div class="{{ section_width }}">
      <p class="text-center my-0">
        Size table: no rows found for this collection. Add entries to the "Size Table" metafield (a list)
        and make sure they are Active.
      </p>
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Size table",
  "tag": "section",
  "disabled_on": {
    "groups": ["custom.overlay", "header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Rows come from the collection's Size Table metafield (a list of Collection Size Table entries). Set the table title below."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Table title",
      "default": "Size guide"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "t:sections.all.section_width.container.label"
        },
        {
          "value": "fluid_container",
          "label": "t:sections.all.section_width.fluid_container.label"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.section_width.stretch_width.label"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.section_width.full_width.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.section_padding.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.section_padding.top.label",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.section_padding.bottom.label",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Size table"
    }
  ]
}
{% endschema %}
