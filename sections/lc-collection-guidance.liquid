{%- comment -%}
  LeCavist: buying guidance shown above the product grid on collection pages.
  Driven by collection metafields, so collections without them render nothing:
    custom.buying_guidance             rich text
    custom.buying_guidance_title       single line text
    custom.buying_guidance_table_items list of buying_guidance_table_item (type, temperatures, best_for)
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign guidance_title = collection.metafields.custom.buying_guidance_title.value
  assign guidance = collection.metafields.custom.buying_guidance
  assign table_items = collection.metafields.custom.buying_guidance_table_items.value
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}
{%- comment %} TEMP DEBUG: remove once the table renders. View page source and search for "lc-guidance-debug". {%- endcomment %}
<!--
  lc-guidance-debug collection={{ collection.handle }} title={{ guidance_title | size }} guidance_size={{ guidance | metafield_tag | size }} items={{ table_items.size }} first_type="{{ table_items[0].type }}" first_system_type="{{ table_items[0].system.type }}" first_temps="{{ table_items[0].temperatures }}" first_best_for="{{ table_items[0].best_for }}"
-->
{%- if guidance_title != blank or guidance != blank or table_items.size > 0 -%}
  {%- style -%}
    .lc-guidance__inner {
      max-width: 1100px;
    }
    .lc-guidance__title {
      margin: 0 0 15px;
    }
    .lc-guidance__body p {
      max-width: 74ch;
    }
    .lc-guidance__table-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin-top: 25px;
      border: 0;
    }
    .lc-guidance__table {
      width: 100%;
      min-width: 560px;
      border-collapse: collapse;
      text-align: left;
      border-top: 1px solid #a9a49f;
      border-bottom: 1px solid #a9a49f;
    }
    .lc-guidance__table th,
    .lc-guidance__table td {
      padding: 12px 16px;
      vertical-align: top;
      border-bottom: 1px solid #a9a49f;
      border-color: #a9a49f;
    }
    .lc-guidance__table thead th,
    .lc-guidance__table th + th,
    .lc-guidance__table td + td {
      border-left: 1px solid #a9a49f;
    }
    .lc-guidance__table thead th {
      background: #fdfaf5;
      border-color: #a9a49f;
      font-weight: 600;
    }
    .lc-guidance__table tbody tr:last-child th,
    .lc-guidance__table tbody tr:last-child td {
      border-bottom: 0;
    }
    .lc-guidance__table tbody th {
      font-weight: 600;
    }
  {%- endstyle -%}
  <div
    class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__lc-collection-guidance"
    style="{{ style | strip | strip_newlines }}"
  >
    <div class="{{ section_width }}">
      <div class="lc-guidance__inner">
        {%- if guidance_title != blank -%}
          <h2 class="lc-guidance__title heading-letter-spacing h3">{{ guidance_title }}</h2>
        {%- endif -%}
        {%- if guidance != blank -%}
          <div class="lc-guidance__body rte rich__text-m0">{{ guidance | metafield_tag }}</div>
        {%- endif -%}
        {%- if table_items.size > 0 -%}
          <div
            class="lc-guidance__table-wrap"
            role="region"
            tabindex="0"
            aria-label="{{ guidance_title | default: collection.title | escape }}"
          >
            <table class="lc-guidance__table">
              <thead>
                <tr>
                  <th scope="col">Type</th>
                  <th scope="col">Temperatures</th>
                  <th scope="col">Best for</th>
                </tr>
              </thead>
              <tbody>
                {%- for item in table_items -%}
                  <tr>
                    <th scope="row">{{ item.type }}</th>
                    <td>{{ item.temperatures }}</td>
                    <td>{{ item.best_for }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Buying guidance",
  "tag": "section",
  "disabled_on": {
    "groups": ["custom.overlay", "header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Content comes from the collection's metafields: Buying Guidance Title, Buying Guidance Description and Buying Guidance Table Items."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "t:sections.all.section_width.container.label"
        },
        {
          "value": "fluid_container",
          "label": "t:sections.all.section_width.fluid_container.label"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.section_width.stretch_width.label"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.section_width.full_width.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.section_padding.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.section_padding.top.label",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.section_padding.bottom.label",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Buying guidance"
    }
  ]
}
{% endschema %}
