              <button type="button" class="lc-d-qty-heart" id="lc-d-wishlist-btn" onclick="lcDWishlist(this)" aria-label="Save {{ product.title }} to wishlist">
                <svg class="lc-wishlist-heart" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
                  <path class="lc-heart-outline" d="M12 21l-1.45-1.32C5.4 15.36 2 12.27 2 8.5A5.5 5.5 0 0 1 7.5 3c1.74 0 3.41.81 4.5 2.08A5.99 5.99 0 0 1 16.5 3 5.5 5.5 0 0 1 22 8.5c0 3.77-3.4 6.86-8.55 11.19L12 21z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  <path class="lc-heart-filled" d="M12 21l-1.45-1.32C5.4 15.36 2 12.27 2 8.5A5.5 5.5 0 0 1 7.5 3c1.74 0 3.41.81 4.5 2.08A5.99 5.99 0 0 1 16.5 3 5.5 5.5 0 0 1 22 8.5c0 3.77-3.4 6.86-8.55 11.19L12 21z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" style="display:none"/>
                </svg>
              </button>
              <button type="button" class="lc-d-qty-heart lc-d-icon-tip" id="lc-d-email-btn" onclick="lcDEmailOpen()" aria-label="Email to myself" data-tip="Email to myself">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="2.5" y="4.5" width="19" height="15" rx="2" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M3 6.5l9 6.5 9-6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
