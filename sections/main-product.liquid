            {%- endif -%}
            {%- if section.settings.pdp_incl_line2 != blank -%}
            <div class="lc-d-wc-row">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--lc-ed-acc)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg>
