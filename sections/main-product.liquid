          {%- comment %} Capacity calculator - desktop trigger {%- endcomment %}
          {% render 'capacity-calculator-button', variant: 'desktop' %}

          {%- comment -%} ?? Included with purchase (moved under capacity button) ?? {%- endcomment -%}
          {%- if section.settings.pdp_show_included -%}
