  <div class="lc-desktop-pdp-wrapper">
  {%- comment -%} ??? EDITORIAL DESKTOP LAYOUT ??????????????????????????? {%- endcomment -%}
  {%- liquid
    assign lc_d_cv    = product.selected_or_first_available_variant
    assign lc_d_sp    = product.metafields.lecavist_specs
    assign lc_d_imgs  = product.media | where: 'media_type', 'image'
    assign lc_d_pfid  = 'lc-d-form-' | append: section.id
  -%}

  {%- comment -%} Google Fonts for editorial typography {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter+Tight:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    /* ?? Editorial desktop variables ?? */
    .lc-desktop-pdp-wrapper {
      --lc-ed-bg:       #F5F0E8;
      --lc-ed-soft:     #EBE4D8;
      --lc-ed-ink:      #1A1512;
      --lc-ed-subtle:   rgba(26,21,18,0.55);
      --lc-ed-border:   rgba(26,21,18,0.12);
      --lc-ed-acc:      #6B1F2E;
      --lc-ed-disp:     'Cormorant Garamond','Times New Roman',serif;
      --lc-ed-body:     'Inter Tight',-apple-system,sans-serif;
      font-family:      var(--lc-ed-body);
      background:       var(--lc-ed-bg);
      color:            var(--lc-ed-ink);
    }
    /* ?? Breadcrumb ?? */
    .lc-d-bc {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1400px;
      margin: 0 auto;
      padding: 16px 40px;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--lc-ed-subtle);
      border-bottom: 1px solid var(--lc-ed-border);
    }
    .lc-d-bc a { color: inherit; text-decoration: none; }
    .lc-d-bc a:hover { color: var(--lc-ed-acc); }
    /* ?? Hero grid ??
       Tight frame: minimal top/bottom padding around the gallery and a
       slim column gap so the images sit right next to the buy rail. */
    .lc-d-hero { padding: 10px 16px 28px; border-bottom: 1px solid var(--lc-ed-border); }
    .lc-d-hero__inner { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1fr 460px; gap: 16px; align-items: start; }
    /* ?? Split-scroll (Koala-style):
       LEFT gallery column is the sticky one with its own visible scrollbar -
       you click/drag it to browse more images.
       RIGHT info column flows with the page; mouse-wheel anywhere on the
       page advances the right column normally. */
    @media (min-width: 992px) {
      /* Independent columns. The PICTURES are their own scroll area, pinned
         beside the text; the TEXT/buy rail flows with the page. Result:
         scroll the pictures ? text stays fixed (page doesn't move, overscroll
         contained); scroll the text ? pictures stay fixed (gallery is sticky).
         The category tabs pin to the top of the gallery's scroll area. */
      .lc-d-hero__inner > .lc-d-gallery-col {
        position: sticky;
        top: calc(var(--height-header, 70px) + 44px);
        max-height: calc(100vh - var(--height-header, 70px) - 60px);
        overflow-y: auto;
        overscroll-behavior: contain;
        align-self: start;
        scrollbar-width: thin;
        scrollbar-color: rgba(26,21,18,0.25) transparent;
        padding-right: 6px;
      }
      .lc-d-hero__inner > .lc-d-gallery-col::-webkit-scrollbar { width: 8px; }
      .lc-d-hero__inner > .lc-d-gallery-col::-webkit-scrollbar-track { background: transparent; }
      .lc-d-hero__inner > .lc-d-gallery-col::-webkit-scrollbar-thumb { background: rgba(26,21,18,0.25); border-radius: 4px; }
      .lc-d-hero__inner > .lc-d-gallery-col::-webkit-scrollbar-thumb:hover { background: rgba(26,21,18,0.4); }
    }
    /* ?? Gallery - Koala-style stack:
       All product photos are square 1080�1080, so every cell is 1:1 -
       hero alone on row 1, pairs on rows 2+. Minimal 4px gap between
       pictures. */
    .lc-d-gallery-col { min-width: 0; }
    /* ?? Gallery category tabs (desktop) ?? */
    .lc-d-gallery-tabs {
      display: flex; flex-wrap: wrap; gap: 8px;
      margin: 0; padding: 8px 0 10px;
      /* Pinned to the top of the gallery's own scroll area so the tags stay
         visible while the photos scroll beneath them. */
      position: sticky; top: 0;
      z-index: 6; background: #fdfaf5;
    }
    .lc-d-gallery-tabs:empty { display: none; }
    .lc-d-gallery-tab {
      -webkit-appearance: none; appearance: none;
      display: inline-flex; align-items: center; gap: 6px;
      padding: 7px 15px;
      background: transparent;
      border: 1px solid var(--lc-ed-border);
      border-radius: 100px;
      font-family: var(--lc-ed-body);
      font-size: 12px; font-weight: 500; letter-spacing: .04em;
      color: var(--lc-ed-subtle);
      cursor: pointer;
      transition: background .15s, color .15s, border-color .15s;
      -webkit-tap-highlight-color: transparent;
    }
    .lc-d-gallery-tab:hover { border-color: var(--lc-ed-acc); color: var(--lc-ed-acc); }
    .lc-d-gallery-tab.is-active { background: var(--lc-ed-acc); border-color: var(--lc-ed-acc); color: #F5F0E8; }
    .lc-d-gallery-tab__count { font-size: 11px; opacity: .65; }
    .lc-d-mosaic {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px;
    }
    .lc-d-mosaic__cell {
      position: relative;
      margin: 0;
      overflow: hidden;
      background: var(--lc-ed-soft);
      aspect-ratio: 1 / 1;
      border-radius: 2px;
    }
    /* Hero (first VISIBLE cell of the active tab) spans both columns, and a
       lone trailing image (odd count after the hero) stretches full width.
       JS manages --hero / --wide per active tab. */
    .lc-d-mosaic__cell--hero,
    .lc-d-mosaic__cell--wide {
      grid-column: 1 / -1;
      aspect-ratio: 1 / 1;
    }
    /* ?? Slider mode (Details / Inside / Lifestyle tabs) ??
       A generic horizontal swipe carousel instead of the product mosaic. */
    .lc-d-gallery-stage { position: relative; }
    .lc-d-mosaic.lc-d-mosaic--slider {
      display: flex;
      grid-template-columns: none;
      gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .lc-d-mosaic.lc-d-mosaic--slider::-webkit-scrollbar { display: none; }
    .lc-d-mosaic.lc-d-mosaic--slider .lc-d-mosaic__cell {
      flex: 0 0 100%;
      grid-column: auto;
      scroll-snap-align: start;
      aspect-ratio: 1 / 1;
    }
    /* Slider arrows - only shown when a slider tab is active */
    .lc-d-gallery-arrow {
      display: none;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 3;
      width: 42px; height: 42px;
      align-items: center; justify-content: center;
      padding: 0;
      border: none; border-radius: 50%;
      background: rgba(245,240,232,0.92);
      color: var(--lc-ed-ink);
      cursor: pointer;
      box-shadow: 0 2px 10px rgba(15,13,11,0.18);
      transition: background .15s;
    }
    .lc-d-gallery-arrow:hover { background: #ffffff; }
    .lc-d-gallery-arrow--prev { left: 12px; }
    .lc-d-gallery-arrow--next { right: 12px; }
    .lc-d-gallery-stage.is-slider .lc-d-gallery-arrow { display: flex; }
    .lc-d-mosaic__img {
      width: 100%;
      height: 100%;
      /* Source files are 1:1 like the cells, so cover = pixel-exact fit
         (and gracefully crops any stray non-square upload). */
      object-fit: cover;
      display: block;
      transition: transform 0.8s cubic-bezier(.2,.8,.2,1);
    }
    .lc-d-mosaic__cell:hover .lc-d-mosaic__img { transform: scale(1.02); }
    /* ── Main (hero) image: keep the WHOLE cabinet visible ──────────────
       Source photos are square 1080×1080 and show the full cabinet. The hero
       cell used to span the full gallery width as a 1:1 square (~900px tall),
       which overflowed the height-limited sticky gallery column and cut the
       cabinet base off at the bottom. Cap the hero to the visible viewport
       height, keep it a centred square, and contain the image so the entire
       cabinet is always shown (top-to-bottom), centred, undistorted, and never
       cropped — on tablet and desktop alike. */
    @media (min-width: 768px) {
      .lc-d-mosaic__cell--hero {
        aspect-ratio: 1 / 1;
        max-height: calc(100vh - var(--height-header, 70px) - 140px);
        max-width:  calc(100vh - var(--height-header, 70px) - 140px);
        margin-left: auto;
        margin-right: auto;
      }
      .lc-d-mosaic__cell--hero .lc-d-mosaic__img {
        object-fit: contain;
        object-position: center;
      }
    }
    /* Watch-in-video chip overlay on the hero image - burgundy/cream */
    .lc-d-mosaic__video-chip {
      position: absolute;
      bottom: 20px;
      left: 20px;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #F5F0E8;
      color: var(--lc-ed-acc);
      border: 1px solid var(--lc-ed-acc);
      padding: 10px 20px 10px 12px;
      border-radius: 100px;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.08em;
      cursor: pointer;
      font-family: var(--lc-ed-body);
      transition: background 0.15s, color 0.15s;
      box-shadow: 0 4px 16px rgba(15,13,11,0.18);
    }
    .lc-d-mosaic__video-chip:hover { background: var(--lc-ed-acc); color: #F5F0E8; }
    .lc-d-mosaic__video-chip:hover .lc-d-mosaic__video-chip__dot { background: #F5F0E8; color: var(--lc-ed-acc); }
    .lc-d-mosaic__video-chip__dot {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--lc-ed-acc);
      color: #F5F0E8;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      line-height: 1;
      transition: background 0.15s, color 0.15s;
    }
    /* ?? Buy rail - flows with the page (left gallery is the sticky side now) ?? */
    .lc-d-buyrail {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }
    .lc-d-pill-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .lc-d-pill {
      padding: 5px 14px;
      border-radius: 100px;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: .08em;
      text-decoration: none;
      border: 1px solid;
      transition: opacity .15s;
      white-space: nowrap;
    }
    .lc-d-pill:hover { opacity: .75; }
    /* Zone - soft lavender, matching screenshot purple */
    .lc-d-pill--zone { background: #f0eef8; color: #4a2878; border-color: #c0aae0; }
    /* Installation - warm rose / pink */
    .lc-d-pill--inst { background: #fdf0f2; color: #7c2838; border-color: #e8b4bc; }
    /* Range - warm ivory / tan */
    .lc-d-pill--cap  { background: #faf5ee; color: #5a3510; border-color: #d4b896; }
    /* Beverage - soft green, matching the pill family */
    .lc-d-pill--bev  { background: #e9f3ec; color: #1a6642; border-color: #b3d5bf; }
    /* Fallback unstyled pill */
    .lc-d-pill:not(.lc-d-pill--zone):not(.lc-d-pill--inst):not(.lc-d-pill--cap):not(.lc-d-pill--bev) {
      background: transparent; color: var(--lc-ed-ink); border-color: rgba(26,21,18,0.25);
    }
    .lc-d-title { font-family: var(--lc-ed-disp); font-size: clamp(28px,2.6vw,40px); font-weight: 400; color: var(--lc-ed-ink); margin: 0; line-height: 1.05; letter-spacing: -.015em; }
    /* Category pill (e.g. Beverage Centre) - mobile PDP top, matches the .lc-d-pill family in green */
    .lc-cat-pill { display: inline-block; margin: 0 0 12px; padding: 5px 14px; border-radius: 100px; border: 1px solid #b3d5bf; background: #e9f3ec; color: #1a6642; font-family: var(--lc-ed-body, inherit); font-size: 11px; font-weight: 500; letter-spacing: .08em; text-decoration: none; white-space: nowrap; transition: opacity .15s; }
    .lc-cat-pill:hover { opacity: .75; }
    .lc-d-sku { margin-top: 6px; font-size: 13px; letter-spacing: .12em; color: var(--lc-ed-subtle); }
    .lc-d-dims { margin-top: 8px; font-size: 16px; letter-spacing: .04em; color: var(--lc-ed-subtle); font-weight: 700; }
    .lc-d-stars { margin-top: 14px; font-size: 13px; color: var(--lc-ed-acc); letter-spacing: .16em; }
    .lc-d-stars__count { color: var(--lc-ed-subtle); margin-left: 6px; letter-spacing: .04em; }
    /* ?? Trust strip ?? */
    .lc-d-trust { display: grid; grid-template-columns: repeat(4,1fr); border: 1px solid var(--lc-ed-border); border-radius: 2px; background: var(--lc-ed-soft); }
    .lc-d-trust-item { padding: 14px 4px; display: flex; flex-direction: column; align-items: center; gap: 6px; border-right: 1px solid var(--lc-ed-border); text-align: center; }
    .lc-d-trust-item:last-child { border-right: none; }
    .lc-d-trust-item span { font-size: 12.5px; font-weight: 600; color: var(--lc-ed-ink); line-height: 1.3; letter-spacing: .03em; }
    .lc-d-short-desc { font-size: 16px; color: var(--lc-ed-subtle); line-height: 1.65; margin: 10px 0 0; text-align: justify; }
    .lc-d-desc-toggle { display: inline; margin-left: 6px; padding: 0; border: 0; background: none; color: var(--lc-ed-acc); font-family: inherit; font-size: 13px; font-weight: 400; text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
    .lc-d-desc-toggle:hover { opacity: .7; }
    .lc-d-preorder-badge { display: inline-block; font-family: var(--lc-ed-body); font-size: 11px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; background: var(--lc-ed-acc); color: #F5F0E8; padding: 3px 10px; border-radius: 3px; vertical-align: middle; margin-left: 6px; }
    .lc-fs-badge { display: inline-block; font-family: var(--lc-ed-body); font-size: 11px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; background: #1a6642; color: #ffffff; padding: 3px 10px; border-radius: 3px; vertical-align: middle; margin-left: 6px; }
    .lc-d-avail-status-label { font-size: 8px; letter-spacing: .14em; text-transform: uppercase; color: var(--lc-ed-subtle); margin-top: 2px; text-align: center; }
    .lc-d-avail-date { font-size: 9px; font-weight: 600; color: var(--lc-ed-ink); margin-top: 1px; text-align: center; }
    /* ?? Eyebrow labels - ONE reusable style for ALL-INCLUSIVE, QUANTITY,
       INCLUDED WITH PURCHASE and the DELIVERY / AVAILABILITY BY STATE header.
       Typography lives here only; the old per-label classes keep layout props. ?? */
    .lc-d-eyebrow {
      font-family: var(--lc-ed-body);
      font-size: 12px;
      font-weight: 500;
      font-style: normal;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--lc-ed-acc);
    }
    .lc-d-block-title {
      font-family: var(--lc-ed-body);
      font-size: 12px;
      font-weight: 500;
      font-style: normal;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--lc-ed-ink);
    }
    /* ?? Price ?? */
    .lc-d-price-kicker { margin-bottom: 6px; }
    .lc-d-price-main { font-family: var(--lc-ed-disp); font-size: clamp(40px,3.5vw,54px); font-weight: 300; color: var(--lc-ed-ink); letter-spacing: -.02em; line-height: 1; }
    .lc-d-price-sub { margin-top: 8px; font-size: 13px; color: var(--lc-ed-subtle); line-height: 1.5; }
    /* ?? Specs grid ?? */
    .lc-d-specs-grid { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--lc-ed-border); border-radius: 2px; overflow: hidden; }
    .lc-d-spec-cell { padding: 10px 14px; border-right: 1px solid var(--lc-ed-border); border-bottom: 1px solid var(--lc-ed-border); }
    .lc-d-spec-cell:nth-child(2n) { border-right: none; }
    .lc-d-spec-cell:nth-last-child(-n+2) { border-bottom: none; }
    .lc-d-spec-label { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--lc-ed-subtle); margin-bottom: 3px; }
    .lc-d-spec-val { font-size: 13px; font-weight: 500; color: var(--lc-ed-ink); }
    /* ?? Variant buttons ?? */
    .lc-d-option-label { font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--lc-ed-subtle); margin-bottom: 8px; }
    .lc-d-option-btns { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
    .lc-d-opt-btn { padding: 10px 20px; font-size: 13px; border: 1px solid rgba(26,21,18,0.2); background: transparent; color: var(--lc-ed-ink); border-radius: 2px; cursor: pointer; transition: all .2s; font-family: var(--lc-ed-body); }
    .lc-d-opt-btn.is-selected { border-color: var(--lc-ed-acc); background: #F4E8EA; }
    /* ?? ATC form ?? */
    .lc-d-qty-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .lc-d-qty-ctrl { display: inline-flex; border: 1px solid var(--lc-ed-border); border-radius: 2px; }
    .lc-d-qty-btn { background: transparent; border: none; padding: 10px 18px; cursor: pointer; color: var(--lc-ed-ink); font-size: 16px; }
    .lc-d-qty-num { padding: 10px 24px; border-left: 1px solid var(--lc-ed-border); border-right: 1px solid var(--lc-ed-border); color: var(--lc-ed-ink); min-width: 56px; text-align: justify; }
    .lc-d-qty-right { display: inline-flex; align-items: center; gap: 12px; }
    .lc-d-qty-heart { background: transparent; border: none; padding: 4px; cursor: pointer; color: var(--lc-ed-ink); line-height: 0; display: inline-flex; align-items: center; transition: color .15s; }
    .lc-d-qty-heart:hover { color: var(--lc-ed-acc); }
    .lc-d-qty-heart.is-wishlisted { color: var(--lc-ed-acc); }
    .lc-d-qty-heart.is-wishlisted .lc-heart-outline { display: none; }
    .lc-d-qty-heart.is-wishlisted .lc-heart-filled { display: inline !important; }
    /* Hover tooltip for icon buttons (e.g. Email to myself) */
    .lc-d-icon-tip { position: relative; }
    .lc-d-icon-tip::after { content: attr(data-tip); position: absolute; bottom: calc(100% + 8px); right: 0; background: var(--lc-ed-ink, #1A1512); color: #F5F0E8; font-family: var(--lc-ed-body, inherit); font-size: 11px; font-weight: 500; letter-spacing: .02em; white-space: nowrap; padding: 5px 9px; border-radius: 4px; opacity: 0; transform: translateY(4px); pointer-events: none; transition: opacity .15s, transform .15s; z-index: 6; }
    .lc-d-icon-tip:hover::after, .lc-d-icon-tip:focus-visible::after { opacity: 1; transform: translateY(0); }
    .lc-d-atc { width: 100%; background: var(--lc-ed-acc); color: #F5F0E8; border: none; padding: 20px; font-size: 15px; cursor: pointer; border-radius: 4px; font-weight: 500; letter-spacing: .02em; transition: background .2s; font-family: var(--lc-ed-body); }
    .lc-d-atc:hover:not(:disabled) { background: #4A1420; }
    .lc-d-atc:disabled { background: rgba(26,21,18,0.15); cursor: not-allowed; }
    /* #5 - Contact our experts button (desktop) */
    .lc-d-experts-btn { display: flex; align-items: center; justify-content: center; gap: 9px; width: 100%; margin-top: 12px; padding: 14px; background: transparent; color: var(--lc-ed-ink); text-decoration: none; border: 1px solid var(--lc-ed-border); border-radius: 4px; font-size: 13px; font-weight: 500; font-family: var(--lc-ed-body); transition: border-color .15s, background .15s, color .15s; cursor: pointer; }
    .lc-d-experts-btn:hover { border-color: var(--lc-ed-acc); color: var(--lc-ed-acc); background: rgba(107,31,46,0.04); }
    .lc-d-experts-btn__icon { flex: 0 0 auto; }

    .lc-d-sec-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
    .lc-d-sec-btn { background: transparent; border: 1px solid var(--lc-ed-border); padding: 14px; cursor: pointer; color: var(--lc-ed-ink); font-size: 13px; border-radius: 4px; font-family: var(--lc-ed-body); transition: border-color .15s, background .15s; }
    .lc-d-sec-btn:hover { border-color: var(--lc-ed-acc); background: rgba(107,31,46,0.04); }
    .lc-d-sec-btn.is-wishlisted { color: var(--lc-ed-acc); border-color: var(--lc-ed-acc); }

    /* Email to myself modal */
    .lc-d-email-modal { display: none; position: fixed; inset: 0; z-index: 9999; align-items: center; justify-content: center; }
    .lc-d-email-modal.is-open { display: flex; }
    .lc-d-email-modal__backdrop { position: absolute; inset: 0; background: rgba(15,12,10,0.55); backdrop-filter: blur(4px); }
    .lc-d-email-modal__box { position: relative; z-index: 1; background: var(--lc-ed-bg, #F5F0E8); border-radius: 8px; padding: 40px 36px; max-width: 440px; width: 90%; text-align: center; box-shadow: 0 24px 64px rgba(0,0,0,0.2); }
    .lc-d-email-modal__close { position: absolute; top: 14px; right: 16px; background: none; border: none; cursor: pointer; font-size: 18px; color: rgba(26,21,18,0.45); padding: 4px 8px; }
    .lc-d-email-modal__img { margin-bottom: 20px; }
    .lc-d-email-modal__product-img { width: 80px; height: 80px; object-fit: cover; border-radius: 4px; margin: 0 auto; display: block; }
    .lc-d-email-modal__heading { font-family: 'Cormorant Garamond','Times New Roman',serif; font-size: 26px; font-weight: 400; color: #1A1512; margin: 0 0 10px; }
    .lc-d-email-modal__sub { font-size: 16px; color: rgba(26,21,18,0.6); line-height: 1.6; margin: 0 0 24px; }
    .lc-d-email-modal__field { display: flex; gap: 8px; }
    .lc-d-email-modal__input { flex: 1; padding: 12px 16px; border: 1px solid rgba(26,21,18,0.2); border-radius: 4px; font-size: 16px; background: #fff; font-family: 'Inter Tight',-apple-system,sans-serif; outline: none; }
    .lc-d-email-modal__input:focus { border-color: var(--lc-ed-acc, #6B1F2E); }
    .lc-d-email-modal__send { background: #6B1F2E; color: #F5F0E8; border: none; padding: 12px 22px; border-radius: 4px; cursor: pointer; font-size: 13px; font-weight: 500; font-family: 'Inter Tight',-apple-system,sans-serif; white-space: nowrap; }
    .lc-d-email-modal__send:hover { background: #4A1420; }
    .lc-d-email-modal__status { margin-top: 12px; font-size: 13px; min-height: 18px; color: #1a6642; }
    /* ?? Availability state cards ?? */
    .lc-d-avail-wrap { border: 1px solid var(--lc-ed-border); border-radius: 2px; overflow: hidden; }
    .lc-d-avail-header { background: var(--lc-ed-soft); padding: 10px 16px; border-bottom: 1px solid var(--lc-ed-border); text-align: center; }
    .lc-d-avail-eyebrow { display: block; margin-bottom: 2px; }
    .lc-d-avail-grid { display: grid; grid-template-columns: repeat(5,1fr); }
    .lc-d-avail-cell { padding: 12px 6px; text-align: center; border-right: 1px solid rgba(26,21,18,0.08); }
    .lc-d-avail-cell:last-child { border-right: none; }
    .lc-d-avail-abbr { font-size: 13px; font-weight: 600; text-align: center; }
    .lc-d-avail-status { font-size: 8px; letter-spacing: .14em; text-transform: uppercase; color: var(--lc-ed-subtle); margin-top: 2px; }
    .lc-d-avail--yes { color: #2d6a3f; }
    .lc-d-avail--slow { color: #92400e; }
    .lc-d-avail--no { color: rgba(26,21,18,0.35); }
    .lc-d-avail--limited { color: #2d6a3f; }
    /* ?? Wine Circle ?? */
    .lc-d-wc { border: 1px solid var(--lc-ed-border); border-radius: 4px; padding: 18px 20px; background: rgba(26,21,18,0.02); display: flex; flex-direction: column; gap: 12px; }
    .lc-d-wc-header { display: flex; justify-content: space-between; align-items: center; }
    .lc-d-wc-badge { padding: 3px 10px; background: var(--lc-ed-acc); color: #F5F0E8; font-size: 10px; letter-spacing: .18em; text-transform: uppercase; border-radius: 100px; font-weight: 500; }
    .lc-d-wc-badge--green { background: #1a6642; color: #ffffff; }
    .lc-d-wc-row { display: flex; gap: 10px; align-items: flex-start; font-size: 16px; color: var(--lc-ed-ink); line-height: 1.55; }
    .lc-d-wc-row svg { flex-shrink: 0; margin-top: 2px; }
    .lc-d-wc-row a { color: var(--lc-ed-acc); text-decoration: underline; text-decoration-thickness: 1px; text-decoration-color: rgba(107,31,46,0.35); text-underline-offset: 3px; font-weight: 500; border-radius: 2px; transition: color 0.15s, text-decoration-color 0.15s, background 0.15s; }
    .lc-d-wc-row a:hover { color: #4A1420; text-decoration-color: var(--lc-ed-acc); }
    .lc-d-wc-row a:active,
    .lc-d-wc-row a:focus-visible { background: rgba(107,31,46,0.08); text-decoration-color: var(--lc-ed-acc); outline: none; }
    .lc-d-savings-banner { display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; padding: 5px 10px; background: transparent; border: 1px solid rgba(26,102,66,0.28); border-radius: 100px; font-size: 11.5px; font-weight: 500; color: #1a6642; letter-spacing: .02em; }
    .lc-d-savings-banner svg { width: 12px; height: 12px; opacity: 0.7; }
    /* ?? Reviews teaser ?? */
    .lc-d-rev-teaser { border-top: 1px solid var(--lc-ed-border); padding-top: 16px; }
    .lc-d-rev-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .lc-d-rev-heading { font-family: var(--lc-ed-disp); font-size: 20px; font-weight: 400; color: var(--lc-ed-ink); }
    .lc-d-rev-score { font-size: 13px; color: var(--lc-ed-acc); letter-spacing: .14em; }
    .lc-d-rev-card { padding: 18px; background: var(--lc-ed-soft); border: 1px solid var(--lc-ed-border); border-radius: 2px; margin-bottom: 12px; }
    .lc-d-rev-stars { font-size: 12px; color: #c9a84c; letter-spacing: .2em; margin-bottom: 8px; }
    .lc-d-rev-quote { font-family: var(--lc-ed-disp); font-size: 18px; color: var(--lc-ed-ink); font-style: italic; margin-bottom: 8px; }
    .lc-d-rev-author { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--lc-ed-subtle); }
    .lc-d-rev-all { display: block; text-align: center; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--lc-ed-acc); text-decoration: none; border: 1px solid rgba(26,21,18,0.15); padding: 12px; border-radius: 2px; }
    .lc-d-rev-all:hover { background: var(--lc-ed-soft); }
    /* ?? Desktop sticky bar ?? */
    .lc-d-sticky { position: fixed; bottom: 0; left: 0; right: 0; z-index: 50; background: rgba(15,13,11,0.96); backdrop-filter: blur(16px); color: #F0E9DE; border-top: 1px solid rgba(255,255,255,0.08); transform: translateY(100%); transition: transform .4s cubic-bezier(.2,.8,.2,1); padding: 14px 40px; }
    .lc-d-sticky.is-visible { transform: translateY(0); }
    .lc-d-sticky__inner { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: 18px; }
    .lc-d-sticky__thumb { width: 40px; height: 40px; object-fit: cover; border-radius: 4px; background: rgba(255,255,255,0.05); flex-shrink: 0; display: block; }
    .lc-d-sticky__info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .lc-d-sticky__sku { font-family: var(--lc-ed-body); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(245,240,232,0.65); }
    .lc-d-sticky__name { font-family: var(--lc-ed-disp); font-size: 17px; font-weight: 400; line-height: 1.2; color: #F5F0E8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .lc-d-sticky__price { font-family: var(--lc-ed-disp); font-size: 22px; font-weight: 300; color: #F5F0E8; }
    .lc-d-sticky__btn { background: var(--lc-ed-acc); color: #F5F0E8; border: none; padding: 12px 28px; font-size: 13px; letter-spacing: .06em; border-radius: 4px; cursor: pointer; font-weight: 500; font-family: var(--lc-ed-body); white-space: nowrap; }
    @media (max-width: 1024px) {
      .lc-d-sticky__inner { gap: 12px; }
      .lc-d-sticky__price { font-size: 18px; }
      .lc-d-sticky__btn { padding: 10px 18px; font-size: 12px; }
    }
  </style>

  {%- comment -%} ?? Hero ?? {%- endcomment -%}
  <div class="lc-d-hero">
    <div class="lc-d-hero__inner">

      {%- comment -%} ? Gallery column - Habitat-style scrollable mosaic ? {%- endcomment -%}
      {%- liquid
        assign lc_mosaic_layout = 'default'
        if template.suffix == 'lek168pv'
          assign lc_mosaic_layout = 'lek168pv'
        endif
      -%}
      <div class="lc-d-gallery-col">
        {%- comment -%} Category tabs (built by JS from the data-tab below). Default
            view = "Product": full-product shots (alt PRODUCT:) + dimension slides.
            Details / Inside / Lifestyle each show as a horizontal slider. {%- endcomment -%}
        <div class="lc-d-gallery-tabs" role="tablist" aria-label="Gallery categories"></div>
        <div class="lc-d-gallery-stage">
          {% render 'lc-merch-badges', product: product, class: 'lc-mbadges--overlay' %}
          <div class="lc-d-mosaic lc-d-mosaic--{{ lc_mosaic_layout }}">
            {%- for media in lc_d_imgs -%}
              {%- assign lc_d_au = media.alt | upcase | strip -%}
              {%- assign lc_d_p7 = lc_d_au | slice: 0, 7 -%}
              {%- assign lc_d_p8 = lc_d_au | slice: 0, 8 -%}
              {%- assign lc_d_p10 = lc_d_au | slice: 0, 10 -%}
              {%- assign lc_d_tab = 'product' -%}
              {%- if lc_d_p8 == 'PRODUCT:' -%}{%- assign lc_d_tab = 'product' -%}{%- endif -%}
              {%- if lc_d_p7 == 'INSIDE:' -%}{%- assign lc_d_tab = 'inside' -%}{%- endif -%}
              {%- if lc_d_p10 == 'LIFESTYLE:' -%}{%- assign lc_d_tab = 'lifestyle' -%}{%- endif -%}
              {%- if lc_d_p8 == 'DETAILS:' -%}{%- assign lc_d_tab = 'details' -%}{%- endif -%}
              {%- comment -%} Dimension slides belong in the Product/overview view, not Details {%- endcomment -%}
              {%- if lc_d_au contains 'DIMENSION' -%}{%- assign lc_d_tab = 'product' -%}{%- endif -%}
              <figure class="lc-d-mosaic__cell" data-tab="{{ lc_d_tab }}">
                {%- assign lc_d_img_loading = 'lazy' -%}{%- if forloop.first -%}{%- assign lc_d_img_loading = 'eager' -%}{%- endif -%}
                {{ media | image_url: width: 1600 | image_tag: alt: media.alt | default: product.title, loading: lc_d_img_loading, class: 'lc-d-mosaic__img' }}
                {%- if forloop.first and lc_vid_src != blank -%}
                  <button class="lc-d-mosaic__video-chip" id="lc-d-video-pill-btn" type="button" data-video-url="{{ lc_vid_src | escape }}" aria-label="{{ section.settings.video_button_label | default: 'Watch in video' }}">
                    <span class="lc-d-mosaic__video-chip__dot" aria-hidden="true">?</span>
                    <span>{{ section.settings.video_button_label | default: 'Watch in video' }}</span>
                  </button>
                {%- endif -%}
              </figure>
            {%- endfor -%}
          </div>
          {%- comment -%} Slider arrows - shown only when a non-product (slider) tab is active {%- endcomment -%}
          <button type="button" class="lc-d-gallery-arrow lc-d-gallery-arrow--prev" data-gal-prev aria-label="Previous image">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="lc-d-gallery-arrow lc-d-gallery-arrow--next" data-gal-next aria-label="Next image">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>

      <script>
      (function(){
        function initDGallery(){
          var root = document.getElementById('MainProduct-{{ section.id }}');
          if(!root) return;
          var mosaic = root.querySelector('.lc-d-mosaic');
          var tabsRow = root.querySelector('.lc-d-gallery-tabs');
          var stage = root.querySelector('.lc-d-gallery-stage');
          var prevA = root.querySelector('[data-gal-prev]');
          var nextA = root.querySelector('[data-gal-next]');
          if(!mosaic || !tabsRow) return;
          var cells = Array.prototype.slice.call(mosaic.querySelectorAll('.lc-d-mosaic__cell'));
          if(!cells.length){ tabsRow.style.display = 'none'; return; }
          var DEFS = [
            { key:'product',   label:'Product'   },
            { key:'details',   label:'Details'   },
            { key:'inside',    label:'Inside'    },
            { key:'lifestyle', label:'Lifestyle' }
          ];
          var byTab = {};
          cells.forEach(function(c){ var t = c.getAttribute('data-tab') || 'product'; (byTab[t] = byTab[t] || []).push(c); });
          var visible = DEFS.filter(function(d){ return byTab[d.key] && byTab[d.key].length; });

          function apply(key){
            var isSlider = (key !== 'product');   // Product = mosaic; others = horizontal slider
            cells.forEach(function(c){
              var on = (c.getAttribute('data-tab') || 'product') === key;
              c.style.display = on ? '' : 'none';
              c.classList.remove('lc-d-mosaic__cell--hero','lc-d-mosaic__cell--wide');
            });
            mosaic.classList.toggle('lc-d-mosaic--slider', isSlider);
            if(stage) stage.classList.toggle('is-slider', isSlider);
            var vis = byTab[key] || [];
            if(isSlider){
              mosaic.scrollLeft = 0;
              var multi = vis.length > 1;
              if(prevA) prevA.style.display = multi ? '' : 'none';
              if(nextA) nextA.style.display = multi ? '' : 'none';
            } else {
              if(vis[0]) vis[0].classList.add('lc-d-mosaic__cell--hero');
              var rest = vis.length - 1;            // non-hero cells flow in pairs
              if(rest > 0 && rest % 2 === 1) vis[vis.length - 1].classList.add('lc-d-mosaic__cell--wide');
            }
            Array.prototype.forEach.call(tabsRow.querySelectorAll('.lc-d-gallery-tab'), function(b){
              var sel = b.getAttribute('data-tab-key') === key;
              b.classList.toggle('is-active', sel);
              b.setAttribute('aria-selected', sel ? 'true' : 'false');
            });
          }

          function galScroll(dir){ mosaic.scrollBy({ left: dir * mosaic.clientWidth, behavior: 'smooth' }); }
          if(prevA) prevA.addEventListener('click', function(){ galScroll(-1); });
          if(nextA) nextA.addEventListener('click', function(){ galScroll(1); });

          tabsRow.innerHTML = '';
          if(visible.length <= 1){ tabsRow.style.display = 'none'; }
          else {
            visible.forEach(function(d){
              var b = document.createElement('button');
              b.type = 'button'; b.className = 'lc-d-gallery-tab'; b.setAttribute('role','tab');
              b.setAttribute('data-tab-key', d.key);
              b.innerHTML = d.label + ' <span class="lc-d-gallery-tab__count">' + byTab[d.key].length + '</span>';
              b.addEventListener('click', function(){ apply(d.key); });
              tabsRow.appendChild(b);
            });
          }
          var def = (byTab['product'] && byTab['product'].length) ? 'product' : (visible[0] && visible[0].key);
          if(def) apply(def);
        }
        if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initDGallery);
        else initDGallery();
      })();
      </script>

      {%- comment -%} ? Buy rail ? {%- endcomment -%}
      <div class="lc-d-buyrail">

        {%- comment -%} ?? Collection badge pills ?? {%- endcomment -%}
        {%- assign lc_d_bc_cap  = nil -%}
        {%- assign lc_d_bc_inst = nil -%}
        {%- assign lc_d_bc_zone = nil -%}
        {%- for col in product.collections -%}
          {%- assign lc_d_ct = col.title | downcase -%}
          {%- unless lc_d_bc_cap -%}{%- if lc_d_ct contains 'small' or lc_d_ct contains 'medium' or lc_d_ct contains 'large' -%}{%- assign lc_d_bc_cap = col -%}{%- endif -%}{%- endunless -%}
          {%- unless lc_d_bc_inst -%}{%- if lc_d_ct contains 'freestanding' or lc_d_ct contains 'free standing' or lc_d_ct contains 'built' -%}{%- assign lc_d_bc_inst = col -%}{%- endif -%}{%- endunless -%}
          {%- unless lc_d_bc_zone -%}{%- if lc_d_ct contains 'zone' -%}{%- assign lc_d_bc_zone = col -%}{%- endif -%}{%- endunless -%}
        {%- endfor -%}

        {%- comment -%} Derive clean labels ?? {%- endcomment -%}
        {%- assign lc_d_label_zone = '' -%}
        {%- assign lc_d_label_inst = '' -%}
        {%- assign lc_d_label_cap  = '' -%}
        {%- if lc_d_bc_zone -%}
          {%- assign lc_d_zt = lc_d_bc_zone.title | downcase -%}
          {%- if lc_d_zt contains 'single' -%}{%- assign lc_d_label_zone = 'Single Zone' -%}
          {%- elsif lc_d_zt contains 'dual' -%}{%- assign lc_d_label_zone = 'Dual Zone' -%}
          {%- elsif lc_d_zt contains 'triple' -%}{%- assign lc_d_label_zone = 'Triple Zone' -%}
          {%- else -%}{%- assign lc_d_label_zone = lc_d_bc_zone.title -%}{%- endif -%}
        {%- endif -%}
        {%- if lc_d_bc_inst -%}
          {%- assign lc_d_it = lc_d_bc_inst.title | downcase -%}
          {%- if lc_d_it contains 'built' -%}{%- assign lc_d_label_inst = 'Built-in' -%}
          {%- else -%}{%- assign lc_d_label_inst = 'Freestanding' -%}{%- endif -%}
        {%- endif -%}
        {%- if lc_d_bc_cap -%}
          {%- assign lc_d_ct2 = lc_d_bc_cap.title | downcase -%}
          {%- if lc_d_ct2 contains 'small' -%}{%- assign lc_d_label_cap = 'Small Range' -%}
          {%- elsif lc_d_ct2 contains 'medium' -%}{%- assign lc_d_label_cap = 'Medium Range' -%}
          {%- elsif lc_d_ct2 contains 'large' -%}{%- assign lc_d_label_cap = 'Large Range' -%}
          {%- else -%}{%- assign lc_d_label_cap = lc_d_bc_cap.title -%}{%- endif -%}
        {%- endif -%}

        {%- assign lc_d_is_bev = false -%}
        {%- for lc_d_bcol in product.collections -%}{%- if lc_d_bcol.handle == 'beverage' -%}{%- assign lc_d_is_bev = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
        {%- if lc_d_bc_cap or lc_d_bc_inst or lc_d_bc_zone or lc_d_is_bev -%}
          <div class="lc-d-pill-row">
            {%- if lc_d_is_bev -%}<a href="/collections/beverage" class="lc-d-pill lc-d-pill--bev">Beverage Centre</a>{%- endif -%}
            {%- if lc_d_bc_zone -%}<a href="{{ lc_d_bc_zone.url }}" class="lc-d-pill lc-d-pill--zone">{{ lc_d_label_zone }}</a>{%- endif -%}
            {%- if lc_d_bc_inst -%}<a href="{{ lc_d_bc_inst.url }}" class="lc-d-pill lc-d-pill--inst">{{ lc_d_label_inst }}</a>{%- endif -%}
            {%- if lc_d_bc_cap -%}<a href="{{ lc_d_bc_cap.url }}" class="lc-d-pill lc-d-pill--cap">{{ lc_d_label_cap }}</a>{%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%}
        ?? Title: build "XX Bottle LECAVIST Wine/Beverage Cabinet/Fridge"
        Scans words for capacity marker (bottle/bottles/litre/litres/l-suffix),
        type word (wine/beverage) and container word (cabinet/fridge).
        Falls back to product.title stripped of range suffixes.
        {%- endcomment -%}
        {%- assign lc_d_title_parts     = product.title | split: ' ' -%}
        {%- assign lc_d_capacity_token  = '' -%}
        {%- assign lc_d_type_word       = '' -%}
        {%- assign lc_d_container_word  = '' -%}
        {%- assign lc_d_duo_word        = '' -%}
        {%- assign lc_d_prev_word       = '' -%}
        {%- for lc_d_tp in lc_d_title_parts -%}
          {%- assign lc_d_tp_lc = lc_d_tp | downcase | remove: '-' -%}
          {%- comment -%} Capacity: word is "bottle/bottles/litre/litres" or purely numeric suffix like "70l" {%- endcomment -%}
          {%- if lc_d_capacity_token == blank -%}
            {%- assign lc_d_is_cap = false -%}
            {%- if lc_d_tp_lc == 'bottle' or lc_d_tp_lc == 'bottles' or lc_d_tp_lc == 'litre' or lc_d_tp_lc == 'litres' -%}
              {%- assign lc_d_is_cap = true -%}
            {%- endif -%}
            {%- comment -%} Catch "70L" style tokens - last char is 'l' and rest is numeric {%- endcomment -%}
            {%- assign lc_d_last_char = lc_d_tp_lc | slice: -1 -%}
            {%- assign lc_d_stripped  = lc_d_tp_lc | remove: 'l' -%}
            {%- assign lc_d_stripped_i = lc_d_stripped | plus: 0 -%}
            {%- if lc_d_last_char == 'l' and lc_d_stripped_i > 0 -%}
              {%- assign lc_d_is_cap = true -%}
              {%- assign lc_d_prev_word = lc_d_tp -%}
            {%- endif -%}
            {%- if lc_d_is_cap and lc_d_prev_word != blank -%}
              {%- assign lc_d_capacity_token = lc_d_prev_word | append: ' ' | append: lc_d_tp -%}
              {%- comment -%} If it's a "70L" self-contained token, use it alone {%- endcomment -%}
              {%- if lc_d_last_char == 'l' -%}{%- assign lc_d_capacity_token = lc_d_tp -%}{%- endif -%}
            {%- elsif lc_d_is_cap -%}
              {%- assign lc_d_capacity_token = lc_d_tp -%}
            {%- endif -%}
          {%- endif -%}
          {%- assign lc_d_prev_word = lc_d_tp -%}
          {%- if lc_d_tp_lc == 'wine' or lc_d_tp_lc == 'beverage' -%}{%- assign lc_d_type_word = lc_d_tp -%}{%- endif -%}
          {%- if lc_d_tp_lc == 'cabinet' or lc_d_tp_lc == 'fridge' or lc_d_tp_lc == 'centre' or lc_d_tp_lc == 'center' -%}{%- assign lc_d_container_word = lc_d_tp -%}{%- endif -%}
          {%- if lc_d_tp_lc == 'duo' -%}{%- assign lc_d_duo_word = 'Duo' -%}{%- endif -%}
        {%- endfor -%}
        {%- assign lc_d_vendor_up = 'LeCavist' -%}
        {%- if lc_d_capacity_token != blank and lc_d_container_word != blank -%}
          {%- assign lc_d_display_title = lc_d_capacity_token | append: ' ' | append: lc_d_vendor_up -%}
          {%- if lc_d_type_word != blank -%}{%- assign lc_d_display_title = lc_d_display_title | append: ' ' | append: lc_d_type_word -%}{%- endif -%}
          {%- assign lc_d_display_title = lc_d_display_title | append: ' ' | append: lc_d_container_word -%}
          {%- if lc_d_duo_word != blank -%}{%- assign lc_d_display_title = lc_d_display_title | append: ' ' | append: lc_d_duo_word -%}{%- endif -%}
        {%- else -%}
          {%- comment -%} Fallback: strip range suffix like " - Medium Range" {%- endcomment -%}
          {%- assign lc_d_display_title = product.title | split: ' - ' | first -%}
        {%- endif -%}
        {%- capture lc_d_effective_tags -%}{%- render 'lc-effective-tags', product: product -%}{%- endcapture -%}
        {%- assign lc_d_effective_tags = lc_d_effective_tags | strip -%}
        {%- assign lc_d_tag_list = lc_d_effective_tags | split: '|' -%}
        {%- comment -%} Pre-order: manual 'pre-order' tag OR no state currently in stock {%- endcomment -%}
        {%- capture lc_d_po_raw -%}{%- render 'lc-is-preorder', product: product -%}{%- endcapture -%}
        {%- assign lc_d_po_raw = lc_d_po_raw | strip -%}
        {%- assign lc_d_is_preorder = false -%}
        {%- if lc_d_po_raw == 'true' -%}{%- assign lc_d_is_preorder = true -%}{%- endif -%}

        {%- comment -%}
        ?? Short description: extract the first <h3><strong> paragraph from product.description.
        This is the paragraph starting as "<h3><strong>LeCavist XX Bottle.</strong></h3>"
        We split on that h3 tag and take the paragraph following it.
        {%- endcomment -%}
        {%- assign lc_d_desc_raw = product.description -%}
        {%- assign lc_d_short_desc = '' -%}
        {%- comment -%}
          Primary: the first paragraph AFTER the "FREE REMOVAL OF OLD CONNECTED
          APPLIANCES" services line (the last of the FREE. inclusions). Robust to
          products with no <h3> (e.g. LEK168PVX) and stops the whole description
          leaking through (e.g. LCS240VN1Z1DX2 - only one paragraph is taken).
          Fallback: first paragraph after the first </h3> (older descriptions).
        {%- endcomment -%}
        {%- assign lc_d_free_anchor = 'FREE REMOVAL OF OLD CONNECTED APPLIANCES' -%}
        {%- if lc_d_desc_raw contains lc_d_free_anchor -%}
          {%- assign lc_d_after_free = lc_d_desc_raw | split: lc_d_free_anchor | last -%}
          {%- assign lc_d_p_parts = lc_d_after_free | split: '<p>' -%}
          {%- comment -%}
            Skip the title line(s) - a title has no full stop ('.'), the description
            sentences do. Once the first real sentence is found, collect up to 2
            paragraphs, stopping at the warranty / "Key Features" / specs / footer
            boundary (so LEK168PV stays one paragraph, LCS240VN1Z1DX2 gets its two
            intro paragraphs, and LEK168PVX gets its one sentence before "Key Features:").
          {%- endcomment -%}
          {%- assign lc_d_started = false -%}
          {%- assign lc_d_count = 0 -%}
          {%- assign lc_d_acc = '' -%}
          {%- for lc_d_pp in lc_d_p_parts offset: 1 -%}
            {%- assign lc_d_cand = lc_d_pp | split: '</p>' | first | strip_html | strip -%}
            {%- assign lc_d_cand_test = lc_d_cand | replace: '&nbsp;', '' | strip -%}
            {%- if lc_d_cand_test != blank -%}
              {%- assign lc_d_low = lc_d_cand | downcase -%}
              {%- assign lc_d_is_boundary = false -%}
              {%- if lc_d_low contains 'key feature' or lc_d_low contains 'warranty' or lc_d_low contains 'specification' or lc_d_low contains 'lecavist hq' or lc_d_low contains 'in the box' -%}
                {%- assign lc_d_is_boundary = true -%}
              {%- endif -%}
              {%- assign lc_d_has_period = false -%}
              {%- if lc_d_cand contains '.' -%}{%- assign lc_d_has_period = true -%}{%- endif -%}
              {%- if lc_d_started -%}
                {%- if lc_d_is_boundary or lc_d_has_period == false or lc_d_count >= 2 -%}
                  {%- break -%}
                {%- endif -%}
                {%- assign lc_d_acc = lc_d_acc | append: '<br><br>' | append: lc_d_cand -%}
                {%- assign lc_d_count = lc_d_count | plus: 1 -%}
              {%- elsif lc_d_has_period and lc_d_is_boundary == false -%}
                {%- assign lc_d_acc = lc_d_cand -%}
                {%- assign lc_d_started = true -%}
                {%- assign lc_d_count = 1 -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign lc_d_short_desc = lc_d_acc -%}
        {%- else -%}
          {%- assign lc_d_after_h3 = lc_d_desc_raw | split: '</h3>' -%}
          {%- if lc_d_after_h3.size > 1 -%}
            {%- assign lc_d_after_first = lc_d_after_h3[1] -%}
            {%- assign lc_d_paras = lc_d_after_first | split: '</p>' -%}
            {%- if lc_d_paras[0] != blank -%}
              {%- assign lc_d_short_desc = lc_d_paras[0] | remove: '<p>' | strip_html | strip -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}

        {%- capture lc_d_sku -%}{%- render 'lc-product-sku', product: product, variant: lc_d_cv -%}{%- endcapture -%}
        {%- assign lc_d_sku = lc_d_sku | strip -%}
        {%- assign lc_d_is_fs = false -%}
        {%- assign lc_d_sku_up = lc_d_sku | upcase -%}
        {%- if lc_d_sku_up.size > 2 -%}
          {%- assign lc_d_sku_last2 = lc_d_sku_up | slice: -2, 2 -%}
          {%- if lc_d_sku_last2 == 'FS' -%}{%- assign lc_d_is_fs = true -%}{%- endif -%}
        {%- endif -%}
        <div>
          <h1 class="lc-d-title">
            {{ lc_d_display_title }}
            {%- if lc_d_is_preorder %} <span class="lc-d-preorder-badge">Pre-order</span>{%- endif -%}
            {%- if lc_d_is_fs %} <span class="lc-fs-badge">Full Shelves Version</span>{%- endif -%}
          </h1>
          {%- if lc_d_sku != blank -%}<div class="lc-d-sku">({{ lc_d_sku }})</div>{%- endif -%}
          {% render 'lc-duo-badge', product: product, st: section.settings, pos: 'under_title' %}
          {%- comment %} Judge.me preview badge (display only) + clickable arrow that scrolls to the reviews widget {%- endcomment %}
          <div class="lc-jdgm-rating-row">
            <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
              {{ product.metafields.judgeme.badge }}
            </div>
            <a href="#lc-jdgm-reviews-target" class="lc-jdgm-arrow-link" aria-label="Jump to customer reviews" data-lc-scroll-jdgm>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 3v10M3 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
          {%- comment %} Dimensions - plain text under the reviews widget, same grey as SKU {%- endcomment %}
          {%- if lc_d_sp.width_mm.value != blank and lc_d_sp.height_mm.value != blank and lc_d_sp.depth_mm.value != blank -%}
            <div class="lc-d-dims">Dimensions: W&nbsp;{{ lc_d_sp.width_mm.value }} &times; H&nbsp;{{ lc_d_sp.height_mm.value }} &times; D&nbsp;{{ lc_d_sp.depth_mm.value }}&nbsp;mm</div>
          {%- endif -%}
          {%- comment -%} The "Extra text under dimensions" field REPLACES the auto-extracted
              description when it is filled; otherwise the auto description shows. Both are
              gated by the "Show description under dimensions" toggle. {%- endcomment -%}
          {%- if section.settings.pdp_show_short_desc -%}
            {%- if section.settings.pdp_under_dim_text != blank -%}
              <div class="lc-d-short-desc lc-d-short-desc--rte">{{ section.settings.pdp_under_dim_text }}</div>
            {%- elsif lc_d_short_desc != blank -%}
              {%- comment -%} Show only the first sentence; reveal the rest via a "Show more" toggle {%- endcomment -%}
              {%- assign lc_d_desc_first = lc_d_short_desc -%}
              {%- assign lc_d_desc_rest = '' -%}
              {%- if lc_d_short_desc contains '. ' -%}
                {%- assign lc_d_desc_first = lc_d_short_desc | split: '. ' | first | append: '.' -%}
                {%- assign lc_d_desc_rest = lc_d_short_desc | remove_first: lc_d_desc_first | strip -%}
              {%- endif -%}
              <p class="lc-d-short-desc">
                <span class="lc-d-desc-first">{{ lc_d_desc_first }}</span>
                {%- if lc_d_desc_rest != blank -%}
                  <span class="lc-d-desc-rest" hidden> {{ lc_d_desc_rest }}</span>
                  <button type="button" class="lc-d-desc-toggle" aria-expanded="false" data-lc-desc-toggle>Show more</button>
                {%- endif -%}
              </p>
            {%- endif -%}
          {%- endif -%}
          {% render 'lc-duo-badge', product: product, st: section.settings, pos: 'under_dimensions' %}
        </div>

        {%- comment -%} ?? Trust strip (4 icons) ?? {%- endcomment -%}
        <div class="lc-d-trust">
          <div class="lc-d-trust-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--lc-ed-acc)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="12" height="10" rx="1"/><path d="M14 10h4l3 3v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
            <span>Free<br>Delivery</span>
          </div>
          <div class="lc-d-trust-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--lc-ed-acc)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            <span>Free<br>Installation</span>
          </div>
          <div class="lc-d-trust-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--lc-ed-acc)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M9.3 9l1.8 1.8 3.6-3.8"/><path d="M9 14l-1.5 7 4.5-2.5 4.5 2.5L15 14"/></svg>
            <span>5Y Compressor<br>Warranty</span>
          </div>
          <div class="lc-d-trust-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--lc-ed-acc)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="9" height="18" rx="1"/><path d="M5 8h9M5 16h9"/><path d="M14 12h6M17 8l3 4-3 4"/></svg>
            <span>Old Cabinet<br>Collected</span>
          </div>
        </div>

        {%- comment -%} ?? Price + Afterpay ?? {%- endcomment -%}
        <div>
          <div class="lc-d-price-kicker lc-d-eyebrow">All-inclusive</div>
          <div class="lc-d-price-main" id="lc-d-price">{{ lc_d_cv.price | money }}</div>
          {%- if lc_d_cv.compare_at_price > lc_d_cv.price -%}
            <div style="font-size:14px;color:var(--lc-ed-subtle);text-decoration:line-through;margin-top:4px">{{ lc_d_cv.compare_at_price | money }}</div>
            {%- assign lc_d_savings_pct = lc_d_cv.compare_at_price | minus: lc_d_cv.price | times: 100 | divided_by: lc_d_cv.compare_at_price -%}
            {%- assign lc_d_savings_amt = lc_d_cv.compare_at_price | minus: lc_d_cv.price -%}
            <div class="lc-d-savings-banner">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              You are saving {{ lc_d_savings_amt | money }} ({{ lc_d_savings_pct }}% off) on your order
            </div>
          {%- endif -%}
          <div class="lc-d-price-sub">
            4 interest-free payments of <strong style="color:var(--lc-ed-ink)">{{ lc_d_cv.price | divided_by: 4 | money }}</strong> with
            <img src="https://static.afterpay.com/app/images/badge-mint-on-white.png" alt="Afterpay" style="height:18px;vertical-align:middle;display:inline-block;margin-left:2px" onerror="this.style.display='none';this.nextSibling.style.display='inline'"><span style="display:none;font-weight:600;color:#4b7e59">Afterpay</span>
          </div>
        </div>

        {%- comment -%} ?? Availability by state ?? captured, then rendered below Add to Cart (above "Contact our experts") on all PDPs {%- endcomment -%}
        {%- assign lc_move_avail = true -%}
        {%- capture lc_d_avail_html -%}
        {%- if lc_has_avail and section.settings.pdp_show_availability -%}
          <div class="lc-d-avail-wrap">
            <div class="lc-d-avail-header">
              <span class="lc-d-avail-eyebrow lc-d-eyebrow">- Delivery -</span>
              <span class="lc-d-avail-title lc-d-block-title">Availability by State</span>
            </div>
            <div class="lc-d-avail-grid">
              {%- assign lc_d_abbrs = 'NSW,VIC,QLD,SA,WA' | split: ',' -%}
              {%- assign lc_d_raws  = lc_nsw_raw | append: '|' | append: lc_vic_raw | append: '|' | append: lc_qld_raw | append: '|' | append: lc_sa_raw | append: '|' | append: lc_wa_raw | split: '|' -%}
              {%- for si in (0..4) -%}
                {%- assign lc_d_sr = lc_d_raws[si] | strip -%}
                {%- assign lc_d_sl = lc_d_sr | downcase -%}
                {%- assign lc_d_sc = 'lc-d-avail--no' -%}
                {%- assign lc_d_st = 'n/a' -%}
                {%- assign lc_d_date_label = '' -%}
                {%- if lc_d_sl == 'available' or lc_d_sl == 'yes' or lc_d_sl == 'in stock' or lc_d_sl == 'instock' -%}
                  {%- assign lc_d_sc = 'lc-d-avail--yes' -%}{%- assign lc_d_st = 'In stock' -%}
                {%- elsif lc_d_sl == 'limited' or lc_d_sl == 'low' or lc_d_sl == 'limited stock' or lc_d_sl == 'limited availability' or lc_d_sl == 'low stock' -%}
                  {%- assign lc_d_sc = 'lc-d-avail--limited' -%}{%- assign lc_d_st = 'Limited' -%}
                {%- elsif lc_d_sl == 'unavailable' or lc_d_sl == 'no' or lc_d_sl == 'out of stock' -%}
                  {%- assign lc_d_sc = 'lc-d-avail--no' -%}{%- assign lc_d_st = 'n/a' -%}
                {%- elsif lc_d_sr != blank -%}
                  {%- assign lc_d_sc = 'lc-d-avail--slow' -%}{%- assign lc_d_st = 'Expected' -%}{%- assign lc_d_date_label = lc_d_sr -%}
                {%- endif -%}
                <div class="lc-d-avail-cell">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="{{ lc_d_sc }}" style="margin:0 auto 4px;display:block"><rect x="3" y="5" width="18" height="16" rx="1"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                  <div class="lc-d-avail-abbr {{ lc_d_sc }}">{{ lc_d_abbrs[si] }}</div>
                  {%- if lc_d_date_label != blank -%}
                    <div class="lc-d-avail-status-label">Expected</div>
                    <div class="lc-d-avail-date">{{ lc_d_date_label }}</div>
                  {%- else -%}
                    <div class="lc-d-avail-status {{ lc_d_sc }}">{{ lc_d_st }}</div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
        {%- endcapture -%}
        {%- assign lc_d_avail_html = lc_d_avail_html | strip -%}
        {%- unless lc_move_avail -%}{{ lc_d_avail_html }}{%- endunless -%}

        {% render 'lc-duo-badge', product: product, st: section.settings, pos: 'above_configuration' %}

        {%- comment -%} Product configuration block - desktop placement (after availability) {%- endcomment -%}
        {%- if section.settings.pdp_show_configuration -%}<div class="lc-pdp-config-font">{% render 'product-configuration', product: product %}</div>{%- endif -%}

        {%- comment -%} ?? Qty + ATC form ?? {%- endcomment -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div>
              <div class="lc-d-option-label">{{ option.name }}</div>
              <div class="lc-d-option-btns">
                {%- for value in option.values -%}
                  {%- assign lc_d_opt_sel = false -%}
                  {%- if lc_d_cv.options[forloop.parentloop.index0] == value -%}{%- assign lc_d_opt_sel = true -%}{%- endif -%}
                  <button type="button" class="lc-d-opt-btn{% if lc_d_opt_sel %} is-selected{% endif %}" data-option-idx="{{ forloop.parentloop.index0 }}" data-value="{{ value | escape }}" aria-pressed="{{ lc_d_opt_sel }}">{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <product-form class="lc-d-atc-wrap" data-section-id="{{ section.id }}" data-hide-errors="false">
        {%- form 'product', product, id: lc_d_pfid, class: 'lc-d-atc-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ lc_d_cv.id }}" id="lc-d-variant-id">
