{{ 'main-product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign theme_st = settings
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign enable_sticky_content_on_desktop = section_st.enable_sticky_content_on_desktop
  assign enable_skeleton_loading = section_st.enable_skeleton_loading
  assign desktop_media_width = section_st.desktop_media_width
  assign desktop_layout = section_st.desktop_layout
  assign image_zoom = section_st.image_zoom
  assign user_variants_image_group = false
  assign enable_sticky_add_cart_on_desktop = section_st.enable_on_desktop
  assign enable_sticky_add_cart_on_mobile = section_st.enable_on_mobile
  assign enable_frequently_bought_together = section_st.enable_frequently_bought_together
  if settings.color_swatch_trigger != blank and settings.enable_color_swatches != false
    assign option_color_name = settings.color_swatch_trigger | split: ','
  else
    assign option_color_name = 'Color'
  endif
  assign color_scheme = section_st.color_scheme
  assign products_group = product.metafields.custom.product_grouped
  assign color = false
  for option in product.options_with_values
    for itemColor in option_color_name
      if option.name == itemColor
        assign color = true
      endif
    endfor
  endfor
  if section_st.reset_spacing
  assign reset_spacing = ' remove_spacing'
endif
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};--speed: {{ section_st.speed }}s; --font-size: {{ section_st.font_size }};
{%- endcapture -%}
<div
  id="MainProduct-{{ section.id }}"
  class="section sec__featured-product product__item-js {% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} color-{{ color_scheme }} gradient{{ reset_spacing }}"
  data-section="{{ section.id }}"
  data-color-trigger="{{ settings.color_swatch_trigger }}"
  data-desktop-layout="{{ desktop_layout }}"
  data-mobile-layout="{{ section_st.mobile_options }}"
  data-zoom="{{ image_zoom }}"
  style="{{ style | strip | strip_newlines }}"
>

{%- comment %} ???????????????????????????????????????????????????????????
   LECAVIST BRAND PALETTE - applied ONLY on product pages.
   Styles live here (not in a global asset) so they cannot leak
   into collection, cart, or other templates.
   ?????????????????????????????????????????????????????????????????
   Palette
     --lc-body:   #fdfaf5  (soft warm off-white - page background)
     --lc-card:   #f1eae1  (brand cream - section cards)
     --lc-accent: #e5dccc  (darker beige - inner accents)
     --lc-brand:  #7c3030  (burgundy)
     --lc-dark:   #3a0d16  (deep wine)
   ??????????????????????????????????????????????????????????? {%- endcomment %}
<style id="lc-pdp-brand-style">
  :root {
    --lc-body:   #fdfaf5;   /* very light warm beige */
    --lc-card:   #f1eae1;
    --lc-accent: #e5dccc;
    --lc-brand:  #7c3030;
    --lc-dark:   #3a0d16;
  }

  /* ?? Page background ???????????????????????????????????? */
  html, body { background-color: var(--lc-body) !important; }

  /* ?? Each section on the page becomes a rounded cream card ?? */
  main > .shopify-section,
  #MainContent > .shopify-section {
    background-color: var(--lc-card);
    border-radius: 22px;
    /* Symmetric top+bottom so the gap between every card is identical.
       !important beats glozin's .section margin-bottom (90px) which only
       hit the two brand-logo cards and made their gaps larger. */
    margin: 16px 18px !important;
    /* Use overflow: clip (not hidden) so position: sticky inside the section
       still works - `hidden` creates a scroll container that breaks sticky. */
    overflow: clip;
  }
  /* Header, footer, breadcrumbs, dividers stay flush */
  main > .shopify-section-header,
  main > .shopify-section--header,
  main > .shopify-section-footer,
  main > .shopify-section--footer,
  main > .shopify-section[id*="breadcrumb" i],
  main > .shopify-section[id*="divider" i],
  #MainContent > .shopify-section[id*="breadcrumb" i],
  #MainContent > .shopify-section[id*="divider" i] {
    background: transparent !important;
    border-radius: 0 !important;
    margin: 0 !important;
    overflow: visible !important;
  }
  /* Breadcrumb pins under the header for the whole product page. Its own
     .lc-breadcrumb-section provides a solid background + border, so content
     scrolls cleanly underneath. Below the header (z 11), above the gallery
     tabs (z 6). NOT applied to divider sections. */
  main > .shopify-section[id*="breadcrumb" i],
  #MainContent > .shopify-section[id*="breadcrumb" i] {
    position: sticky !important;
    top: var(--height-header, 70px) !important;
    z-index: 10 !important;
  }
  @media (max-width: 749px) {
    main > .shopify-section,
    #MainContent > .shopify-section { margin: 10px 10px !important; border-radius: 16px; }
    /* Pull the pinned breadcrumb flush under the header - its 8px top padding tucks
       behind the header (z 11 > 10) instead of leaving a gap when the measured header
       height overshoots on mobile. */
    main > .shopify-section[id*="breadcrumb" i],
    #MainContent > .shopify-section[id*="breadcrumb" i] { top: calc(var(--height-header, 60px) - 9px) !important; }
  }

  /* PDP custom wrappers transparent so card colour shows through */
  .lc-pdp,
  .lc-mobile-pdp-wrapper,
  .lc-desktop-pdp-wrapper,
  .lc-rp-section,
  .lc-lf,
  .lc-lf__container,
  .lc-all-reviews-section,
  .sec__brand-logo,
  .sec__shopable-video,
  .sec__related-product { background: transparent !important; }

  /* ?? Product gallery - flat cream, no gradient, matching nav-tabs section ?? */
  .lc-gallery {
    background: var(--lc-card) !important;
    border-radius: 18px !important;
  }
  .product__media-wrapper,
  .product__media-list,
  .product__media-item { background: var(--lc-card) !important; }

  /* Force the .lc-pdp inner wrapper to match the section card colour
     (it has its own hard-coded #F5F0E8 background by default).      */
  .lc-pdp { background: var(--lc-card) !important; }

  /* Trust strips: rules consolidated below in mobile-cleanup section */

  /* ?? Nav-tab bar (was white) ???????????????????????????? */
  .lc-tabs-nav {
    background: var(--lc-card) !important;
    border-bottom: 1px solid rgba(58, 13, 22, 0.08) !important;
  }
  .lc-tabs-nav__line-track { background: transparent !important; }

  .lc-feat-card {
    background: var(--lc-body) !important;
    border-color: rgba(58, 13, 22, 0.10) !important;
  }
  .lc-feat-card.is-active {
    background: var(--lc-accent) !important;
    border-color: var(--lc-brand) !important;
  }
  .lc-delivery-card,
  .lc-manual-row {
    background: var(--lc-body) !important;
    border-color: rgba(58, 13, 22, 0.10) !important;
  }

  /* ?? Specs table - alternating row colours ??????????????
     Hardcoded - .lc-pdp redefines --lc-body / --lc-accent / --lc-dark
     in its own scope, which would resolve these to burgundy/wine. */
  .lc-spec-table tr:nth-child(odd) td,
  .product-specs-table tr:nth-child(odd) td { background: #fdfaf5 !important; }
  .lc-spec-table tr:nth-child(even) td,
  .product-specs-table tr:nth-child(even) td { background: #e5dccc !important; }
  .lc-spec-table th,
  .product-specs-table th { background: #3a0d16 !important; color: #fff !important; }

  /* Info bubbles in custom_liquid block */
  .info-card {
    background: #fdfaf5 !important;
    border-color: rgba(58, 13, 22, 0.10) !important;
    border-radius: 12px !important;
  }

  /* ?? Lifestyle grid: rounded photos + dark wine quote ??? */
  .lc-lf__card,
  .lc-lf__card--hero,
  .lc-lf__card--half {
    border-radius: 18px !important;
    overflow: hidden;
  }
  .lc-lf__quote-block {
    background: var(--lc-dark) !important;
    border-radius: 18px !important;
    padding: 36px 32px !important;
  }
  .lc-lf__quote { color: #f5e8d8 !important; }
  .lc-lf__quote-attribution,
  .lc-lf__quote-attr { color: #d4b896 !important; }
  .lc-lf__quote-eyebrow     { color: #d4b896 !important; }

  /* ?? Related products (Rest of the range) ??????????????? */
  .lc-rp-card {
    background: var(--lc-accent) !important;
    border: 1px solid rgba(58, 13, 22, 0.10) !important;
    border-radius: 16px !important;
  }
  .lc-rp-card:hover {
    border-color: rgba(58, 13, 22, 0.25) !important;
    box-shadow: 0 8px 28px rgba(58, 13, 22, 0.08) !important;
  }
  .lc-rp-card--current {
    border: 2px solid var(--lc-brand) !important;
    box-shadow: 0 0 0 2px rgba(124, 48, 48, 0.18) !important;
  }
  .lc-rp-card__image {
    background: radial-gradient(ellipse 62% 52% at 50% 55%, #FBF8F2 0%, #EFE7DB 88%) !important;
  }

  /* ?? Recently viewed - darker beige rounded boxes per card ?? */
  .sec__related-product .product-item,
  .sec__related-product .product-card,
  .sec__related-product .card-product,
  .sec__related-product .card,
  .sec__related-product .swiper-slide > .product__item,
  .sec__related-product .swiper-slide article {
    background: var(--lc-accent) !important;
    border-radius: 16px !important;
    overflow: hidden;
    border: 1px solid rgba(58, 13, 22, 0.08);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .sec__related-product .product-item:hover,
  .sec__related-product .product-card:hover,
  .sec__related-product .card-product:hover,
  .sec__related-product .card:hover {
    border-color: rgba(58, 13, 22, 0.20);
    box-shadow: 0 8px 24px rgba(58, 13, 22, 0.06);
  }

  /* ?? All reviews - rounded review cards ????????????????? */
  .lc-all-reviews__list .lc-review-card {
    background: var(--lc-body) !important;
    border: 1px solid rgba(58, 13, 22, 0.10) !important;
    border-radius: 16px !important;
  }

  /* ?? Border around the product information column ???????
     Background stays transparent so the parent section card
     colour shows through unchanged. Box sized to content (no
     stretching from grid or sticky max-height).               */
  .lc-d-buyrail {
    border: 1px solid rgba(58, 13, 22, 0.14) !important;
    border-radius: 18px !important;
    padding: 26px 24px !important;
    background: transparent !important;
    overflow: visible !important;
    align-self: start !important;
    height: -moz-fit-content !important;
    height: fit-content !important;
    max-height: none !important;
  }
  @media (max-width: 749px) {
    /* Product info section spans the FULL screen width on every PDP - the main-product
       section drops its 10px card gutter, and .lc-info drops its side margin + padding,
       so every block/button/text inside starts flush at the left and runs to the right. */
    #shopify-section-main {
      margin-left: 0 !important;
      margin-right: 0 !important;
      border-radius: 0 !important;
    }
    .lc-info {
      border: none !important;
      padding: 18px 0 !important;
      margin: 12px 0 !important;
      background: transparent !important;
    }
  }

  {%- comment %} ?? Test scope: only on the LEK168PV product page (mobile) ??
       Stretch every block to the screen edges with no side gutter:
       - zero the shopify-section wrapper's 10px side margin + corner radius
       - zero .lc-info's side margin + side padding
       so all blocks inside it (pills, title, configuration, complete-setup,
       reviews, etc.) sit flush with the screen edges. Vertical spacing kept. {%- endcomment %}
  {%- if template.suffix == 'lek168pv' -%}
    @media (max-width: 749px) {
      /* All sections full-bleed, no card chrome */
      main > .shopify-section,
      #MainContent > .shopify-section {
        margin-left: 0 !important;
        margin-right: 0 !important;
        border-radius: 0 !important;
      }
      /* Left-side blank for the entire page that mirrors the right-side
         scrollbar gutter. Applied at the #MainContent level so every section
         (gallery, info, reviews, related, etc.) shifts together. calc resolves
         to scrollbar width: ~15px on classic scrollbars, 0 on overlay. */
      #MainContent,
      main#MainContent {
        padding-left: calc(100vw - 100%) !important;
        box-sizing: border-box !important;
      }
      .lc-info {
        margin-left: 0 !important;
        margin-right: 0 !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
      }
      /* Consistent, tighter vertical rhythm: normalize each section's vertical
         padding to 30/30 - uniform top padding across all sections, halved from
         the previous 60. Gap between any two sections = 30 + 30 = 60px (was 120).
         main-product keeps its 0 padding-top so the gallery stays flush, but
         takes 30 padding-bottom to match the rhythm with the next section. */
      #MainContent > .shopify-section:not(#shopify-section-main) {
        padding-top: 30px !important;
        padding-bottom: 30px !important;
      }
      #shopify-section-main {
        padding-bottom: 30px !important;
      }
      /* Tighter vertical rhythm between title / SKU / stars / dimensions / price */
      .lc-sku            { margin-top: 2px !important; margin-bottom: 4px !important; }
      .lc-jdgm-rating-row{ margin-top: 2px !important; }
      .lc-reviews-summary{ margin-bottom: 6px !important; }
      .lc-m-dims         { margin: 2px 0 6px !important; font-weight: 700 !important; font-size: 16px !important; }
      .lc-price-block    { margin-bottom: 10px !important; }
    }
  {%- endif -%}

  /* ?? Round product images & match section background ???? */
  .lc-d-mosaic,
  .lc-d-mosaic__cell {
    background: var(--lc-body) !important;
  }
  .lc-d-mosaic__cell {
    border-radius: 18px !important;
    overflow: hidden;
  }
  .lc-d-mosaic__img {
    border-radius: 18px !important;
    background: var(--lc-body) !important;
  }
  @media (max-width: 749px) {
    .lc-d-mosaic__cell,
    .lc-d-mosaic__img { border-radius: 14px !important; }
  }

  /* ?? Cabinet Finder Quiz section - sits in its own card ?? */
  .section-cabinet-finder-quiz { background: var(--lc-card) !important; }

  /* ?? Main product (info) section - lighter beige than other cards ??
     IMPORTANT: hardcode #fdfaf5 instead of var(--lc-body) because
     .lc-pdp defines its OWN --lc-body: #3d2020 (dark wine) at line ~2358.
     Using the variable here resolves to dark wine inside .lc-pdp scope. */
  main > .shopify-section:has(.lc-pdp),
  main > .shopify-section:has(.lc-desktop-pdp-wrapper),
  #MainContent > .shopify-section:has(.lc-pdp),
  #MainContent > .shopify-section:has(.lc-desktop-pdp-wrapper) {
    background-color: #fdfaf5 !important;
  }
  .sec__featured-product,
  .lc-pdp,
  .lc-mobile-pdp-wrapper,
  .lc-desktop-pdp-wrapper,
  .lc-d-hero,
  .lc-d-hero__inner,
  .lc-gallery,
  .product__media-wrapper,
  .product__media-list,
  .product__media-item {
    background: #fdfaf5 !important;
  }

  /* ?? Customer reviews carousel ??????????????????????????? */
  /* Eyebrow matches brand-logo "Our restaurant partners" styling */
  .lc-reviews-block__eyebrow {
    font-family: 'Inter Tight', -apple-system, sans-serif !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    letter-spacing: 0.28em !important;
    text-transform: uppercase !important;
    color: #1A1512 !important;
  }
  /* "What our customers say" heading in brand burgundy */
  .lc-reviews-block__title {
    color: #7c3030 !important;
  }

  /* Per-review product SKU label, sat next to the stars */
  .lc-reviews-block .lc-review-card__stars {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
  }
  .lc-reviews-block .lc-review-card__stars::after {
    content: var(--lc-rv-sku, "");
    font-family: 'Inter Tight', -apple-system, sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(26, 21, 18, 0.45);
    white-space: nowrap;
  }
  /* CTA card has no stars, no label needed there */
  .lc-reviews-block .lc-review-card--cta::after { content: none !important; }

  /* ?? Judge.me Review Widget - match other section styling ??????
     The apps section that holds Judge.me's review_widget block.    */
  .shopify-section-judgeme_reviews_lc,
  .shopify-section-group-judgeme_reviews_lc,
  [id*="judgeme_reviews_lc"] {
    padding: 40px 0 !important;
  }
  /* Wrap a "Customer Reviews" eyebrow above Judge.me's widget output */
  .shopify-section-judgeme_reviews_lc::before,
  [id*="shopify-section-judgeme_reviews_lc"]::before {
    content: "- REVIEWS -";
    display: block;
    font-family: 'Inter Tight', -apple-system, sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #1A1512;
    text-align: center;
    margin: 0 0 14px;
  }
  .shopify-section-judgeme_reviews_lc::after,
  [id*="shopify-section-judgeme_reviews_lc"]::after {
    content: "Customer Reviews";
    position: absolute;
    /* placed via the heading rule below - kept here so "after" exists */
    display: none;
  }
  /* ?? Rating row: Judge.me badge (not clickable) + arrow link (clickable) ?? */
  .lc-jdgm-rating-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
  }
  /* The badge itself shouldn't visually behave like a link, but keep
     pointer-events ON so Judge.me's JS can bind / render properly. */
  .lc-jdgm-rating-row .jdgm-prev-badge,
  .lc-jdgm-rating-row .jdgm-prev-badge * {
    cursor: default !important;
    text-decoration: none !important;
  }
  .lc-jdgm-rating-row .jdgm-star { color: #c9a84c !important; }
  /* No reviews yet ? hide the orphaned "jump to reviews" arrow. Judge.me
     reports data-number-of-reviews="0" on the badge (e.g. LCS600). */
  .lc-jdgm-rating-row:has(.jdgm-prev-badge[data-number-of-reviews="0"]) .lc-jdgm-arrow-link {
    display: none !important;
  }
  /* The arrow link - the only clickable element */
  .lc-jdgm-arrow-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(26, 21, 18, 0.55);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    padding: 2px 4px;
    transition: transform 0.15s, color 0.15s;
  }
  .lc-jdgm-arrow-link:hover {
    color: #7c3030;
    transform: translateY(2px);
  }

  /* ??? Judge.me Review Widget - title, summary, review titles ???
     Targets both classic and "Diamond" widget layouts.
     ???????????????????????????????????????????????????????????? */
  /* "Customer Reviews" title - center + Inter Tight uppercase eyebrow */
  .jdgm-rev-widg__title,
  .jdgm-rev-widg__summary-title,
  .jdgm-widget-title,
  .jdgm-row-actions__title,
  .jdgm-rev-widg .jdgm-widget__title,
  [class*="jdgm"] [class*="widget__title"],
  [class*="jdgm"] [class*="summary__title"] {
    font-family: 'Inter Tight', -apple-system, sans-serif !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    letter-spacing: 0.28em !important;
    text-transform: uppercase !important;
    color: #1A1512 !important;
    text-align: center !important;
    display: block !important;
    width: 100% !important;
    margin: 0 0 24px !important;
    line-height: 1.4 !important;
  }

  /* Center the whole summary header (rating + verified + reviewers count) */
  .jdgm-rev-widg__summary,
  .jdgm-rev-widg__summary-inner,
  .jdgm-summary-header,
  .jdgm-summary,
  [class*="jdgm"] [class*="summary-header"],
  [class*="jdgm"] [class*="summary__header"] {
    text-align: center !important;
    justify-content: center !important;
  }

  /* Force the overall rating stars to show next to the average */
  .jdgm-rev-widg__summary-stars,
  .jdgm-summary__stars,
  .jdgm-summary-stars,
  .jdgm-prev-badge__stars,
  [class*="jdgm"] [class*="summary__stars"],
  [class*="jdgm"] [class*="summary-stars"] {
    display: inline-flex !important;
    align-items: center !important;
    color: #7c3030 !important;
    font-size: 20px !important;
    margin: 0 8px !important;
  }
  .jdgm-star,
  .jdgm-prev-badge__stars-on,
  [class*="jdgm"] .jdgm-star { color: #7c3030 !important; }

  /* Individual review titles - Cormorant Garamond italic to match section H2s */
  .jdgm-rev__title,
  .jdgm-row__title,
  [class*="jdgm"] [class*="rev__title"] {
    font-family: 'Cormorant Garamond', 'Times New Roman', serif !important;
    font-style: italic !important;
    font-size: 22px !important;
    font-weight: 400 !important;
    line-height: 1.2 !important;
    color: #1A1512 !important;
    margin: 8px 0 12px !important;
    letter-spacing: -0.01em !important;
  }

  /* "Write a review" button - match brand burgundy */
  .jdgm-write-rev-link,
  .jdgm-btn--solid,
  [class*="jdgm"] [class*="write-rev"] {
    background: #7c3030 !important;
    color: #f1eae1 !important;
    border: none !important;
    border-radius: 4px !important;
    font-family: 'Inter Tight', -apple-system, sans-serif !important;
    font-weight: 500 !important;
    letter-spacing: 0.04em !important;
  }

  /* "See more reviews" CTA - burgundy text on transparent bg */
  .lc-reviews-block .lc-review-card--cta {
    background: transparent !important;
    border: 1.5px solid #7c3030 !important;
    color: #7c3030 !important;
  }
  .lc-reviews-block .lc-review-card--cta:hover {
    background: rgba(124, 48, 48, 0.06) !important;
    border-color: #7c3030 !important;
    color: #7c3030 !important;
  }
  .lc-reviews-block .lc-review-card--cta .lc-review-card--cta__text,
  .lc-reviews-block .lc-review-card--cta .lc-review-card--cta__sub,
  .lc-reviews-block .lc-review-card--cta .lc-review-card--cta__icon { color: #7c3030 !important; }

  /* ?? Pre-order tag - force brand burgundy (was leaking beige from --lc-accent) ?? */
  .lc-d-preorder-badge {
    background: #7c3030 !important;
    color: #fdfaf5 !important;
  }
  .lc-fs-badge {
    background: #1a6642 !important;
    color: #ffffff !important;
  }

  /* ?? Sale price - turn the visible price red when there's a strikethrough was-price ?? */
  .lc-price-block:has(.lc-price-was) .lc-price-main {
    color: #C04828 !important;
  }
  .lc-price-block:has(.lc-price-was) .lc-price-was,
  .lc-price-block:has(.lc-price-was) .lc-price-was s {
    color: rgba(26, 21, 18, 0.5) !important;
  }
  /* Desktop sale price - strike-through indicates sale */
  .lc-d-buyrail :has(> [style*="line-through"]) [id^="lc-d-price"] { color: #C04828 !important; }

  /* ?? Breadcrumb - use the lighter beige body colour ?? */
  .lc-breadcrumb-section {
