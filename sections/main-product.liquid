        {%- comment -%} Email to myself modal {%- endcomment -%}
        <div class="lc-d-email-modal" id="lc-d-email-modal" aria-hidden="true" role="dialog" aria-label="Email product to yourself">
          <div class="lc-d-email-modal__backdrop" id="lc-d-email-backdrop"></div>
          <div class="lc-d-email-modal__box">
            <button class="lc-d-email-modal__close" onclick="lcDEmailClose()" aria-label="Close">?</button>
            <div class="lc-d-email-modal__img">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 200 | image_tag: alt: product.title, loading: 'lazy', class: 'lc-d-email-modal__product-img' }}
              {%- endif -%}
            </div>
            <h3 class="lc-d-email-modal__heading">Save for later</h3>
            <p class="lc-d-email-modal__sub">We'll send you a full recap with the key specs and a direct link. Add other cabinets below to get a side-by-side comparison.</p>
