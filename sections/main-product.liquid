        <circle cx="12" cy="9" r="6"/>
        <path d="M9.3 9l1.8 1.8 3.6-3.8"/>
        <path d="M9 14l-1.5 7 4.5-2.5 4.5 2.5L15 14"/>
      </svg>
      <span>5Y Compressor<br>Warranty</span>
    </div>
    <div class="lc-trust__item" role="listitem">
      <svg class="lc-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="5" y="3" width="9" height="18" rx="1"/>
        <path d="M5 8h9M5 16h9"/>
        <path d="M14 12h6M17 8l3 4-3 4"/>
      </svg>
      <span>Old Cabinet<br>Collected</span>
    </div>
  </div>

  {%- comment %} Video modal lives OUTSIDE the mobile/desktop wrappers (rendered between
      them, below) so it is never trapped in a display:none container on desktop. {%- endcomment %}

  {%- comment %} ??? 4. PRODUCT INFO BLOCK ????????????????????? {%- endcomment %}
  <div class="lc-info">

    {%- comment %}
    ??? COLLECTION BADGES ??????????????????????????????????
    Loops product.collections to find which badge category
    each collection belongs to. No metafields required.

    Collection naming conventions detected (case-insensitive):
      Capacity    : title contains "small", "medium", or "large"
      Installation: title contains "free standing" or "built"
      Zone        : title contains "single", "dual", or "triple"
      (plus "zone" to avoid false-positives on unrelated collections)

    The full collection URL is used for the badge link.
    ?????????????????????????????????????????????????????? {%- endcomment %}

    {%- comment %} ?? Resolve parent product for Full Shelves (FS) and duo variants,
        so we can inherit its collections / specs when this product itself
        is not in those collections.
        Priority:
          1. website-rev.parent_product (product_reference) - direct drop, no lookup
          2. lc-fs-parent-handle snippet (custom.parent_product / SKU stripping) {%- endcomment %}
    {%- assign lc_parent_product = nil -%}
    {%- assign lc_parent_handle = '' -%}
    {%- assign _wr_parent = product.metafields['website-rev'].parent_product.value -%}
    {%- if _wr_parent != blank -%}
      {%- assign lc_parent_product = _wr_parent -%}
      {%- assign lc_parent_handle = _wr_parent.handle -%}
    {%- endif -%}
    {%- if lc_parent_product == blank -%}
      {%- capture lc_parent_handle -%}{%- render 'lc-fs-parent-handle', product: product -%}{%- endcapture -%}
      {%- assign lc_parent_handle = lc_parent_handle | strip -%}
      {%- if lc_parent_handle != '' -%}
        {%- assign lc_parent_product = all_products[lc_parent_handle] -%}
      {%- endif -%}
    {%- endif -%}

    {%- assign lc_badge_capacity     = nil -%}
    {%- assign lc_badge_installation = nil -%}
    {%- assign lc_badge_zone         = nil -%}

    {%- for col in product.collections -%}
      {%- assign lct = col.title | downcase -%}

      {%- comment %} Capacity {%- endcomment %}
      {%- if lc_badge_capacity == blank -%}
        {%- if lct contains 'small' or lct contains 'medium' or lct contains 'large' -%}
          {%- assign lc_badge_capacity = col -%}
        {%- endif -%}
      {%- endif -%}

      {%- comment %} Installation {%- endcomment %}
      {%- if lc_badge_installation == blank -%}
        {%- if lct contains 'free standing' or lct contains 'built' -%}
          {%- assign lc_badge_installation = col -%}
        {%- endif -%}
      {%- endif -%}

      {%- comment %} Cooling zone - require "zone" to avoid false positives {%- endcomment %}
      {%- if lc_badge_zone == blank -%}
        {%- if lct contains 'zone' -%}
          {%- if lct contains 'single' or lct contains 'dual' or lct contains 'triple' -%}
            {%- assign lc_badge_zone = col -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}

    {%- endfor -%}

    {%- comment %} Second pass: fill any unresolved badges from the parent product's collections. {%- endcomment %}
    {%- if lc_parent_product != blank -%}
      {%- for col in lc_parent_product.collections -%}
        {%- assign lct = col.title | downcase -%}
        {%- if lc_badge_capacity == blank -%}
          {%- if lct contains 'small' or lct contains 'medium' or lct contains 'large' -%}
            {%- assign lc_badge_capacity = col -%}
          {%- endif -%}
        {%- endif -%}
        {%- if lc_badge_installation == blank -%}
          {%- if lct contains 'free standing' or lct contains 'built' -%}
            {%- assign lc_badge_installation = col -%}
          {%- endif -%}
        {%- endif -%}
        {%- if lc_badge_zone == blank -%}
          {%- if lct contains 'zone' -%}
            {%- if lct contains 'single' or lct contains 'dual' or lct contains 'triple' -%}
              {%- assign lc_badge_zone = col -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment %} Derive short display labels from the matched collection title {%- endcomment %}
    {%- if lc_badge_capacity != blank -%}
      {%- assign lctc = lc_badge_capacity.title | downcase -%}
      {%- if lctc contains 'small'  -%}{%- assign lc_label_capacity = 'Small Range'  -%}{%- endif -%}
      {%- if lctc contains 'medium' -%}{%- assign lc_label_capacity = 'Medium Range' -%}{%- endif -%}
      {%- if lctc contains 'large'  -%}{%- assign lc_label_capacity = 'Large Range'  -%}{%- endif -%}
    {%- endif -%}

    {%- if lc_badge_installation != blank -%}
      {%- assign lcti = lc_badge_installation.title | downcase -%}
      {%- if lcti contains 'free standing' or lcti contains 'freestanding' -%}{%- assign lc_label_installation = 'Freestanding' -%}{%- endif -%}
      {%- if lcti contains 'built'        -%}{%- assign lc_label_installation = 'Built-in'     -%}{%- endif -%}
    {%- endif -%}

    {%- if lc_badge_zone != blank -%}
      {%- assign lctz = lc_badge_zone.title | downcase -%}
      {%- if lctz contains 'single' -%}{%- assign lc_label_zone = 'Single Zone' -%}{%- endif -%}
      {%- if lctz contains 'dual'   -%}{%- assign lc_label_zone = 'Dual Zone'   -%}{%- endif -%}
      {%- if lctz contains 'triple' -%}{%- assign lc_label_zone = 'Triple Zone' -%}{%- endif -%}
    {%- endif -%}

    {%- if lc_badge_capacity != blank or lc_badge_installation != blank or lc_badge_zone != blank -%}
      <div class="lc-col-badges" role="list" aria-label="Cabinet type">

        {%- if lc_badge_capacity != blank -%}
          <a
            href="{{ lc_badge_capacity.url }}"
            class="lc-col-badge lc-col-badge--capacity"
            role="listitem"
            aria-label="Browse {{ lc_label_capacity }} cabinets"
          >{{ lc_label_capacity }}</a>
        {%- endif -%}

        {%- if lc_badge_installation != blank -%}
          <a
            href="{{ lc_badge_installation.url }}"
            class="lc-col-badge lc-col-badge--installation"
            role="listitem"
            aria-label="Browse {{ lc_label_installation }} cabinets"
          >{{ lc_label_installation }}</a>
        {%- endif -%}

        {%- if lc_badge_zone != blank -%}
          <a
            href="{{ lc_badge_zone.url }}"
            class="lc-col-badge lc-col-badge--zone"
            role="listitem"
            aria-label="Browse {{ lc_label_zone }} cabinets"
          >{{ lc_label_zone }}</a>
        {%- endif -%}

      </div>
    {%- endif -%}

    {%- comment %}
    ??? TITLE PARSING ??????????????????????????????????????
    Format: XX-Bottle LECAVIST Wine Cabinet (SKU) PRE-ORDER
    - Bottle count: from specs.bottle_capacity metafield, OR
      extracted from product.title by splitting on spaces and
      finding a token that ends with "Bottle" or "bottle"
    - SKU: current_variant.sku
    - PRE-ORDER: shown if product has a "Pre-Order" or
      "PREORDER" tag (case-insensitive check)
    ?????????????????????????????????????????????????????? {%- endcomment %}

    {%- comment %} Title parsing - mirrors desktop: capacity + vendor + type + container {%- endcomment %}
    {%- assign lc_title_parts = product.title | split: ' ' -%}
    {%- assign lc_capacity_token  = '' -%}
    {%- assign lc_type_word       = '' -%}
    {%- assign lc_container_word  = '' -%}
    {%- assign lc_duo_word        = '' -%}
    {%- assign lc_prev_word       = '' -%}
    {%- for lc_tp in lc_title_parts -%}
      {%- assign lc_tp_lc = lc_tp | downcase | remove: '-' -%}
      {%- if lc_capacity_token == blank -%}
        {%- assign lc_is_cap = false -%}
        {%- if lc_tp_lc == 'bottle' or lc_tp_lc == 'bottles' or lc_tp_lc == 'litre' or lc_tp_lc == 'litres' -%}
          {%- assign lc_is_cap = true -%}
        {%- endif -%}
        {%- assign lc_last_char = lc_tp_lc | slice: -1 -%}
        {%- assign lc_stripped  = lc_tp_lc | remove: 'l' -%}
        {%- assign lc_stripped_i = lc_stripped | plus: 0 -%}
        {%- if lc_last_char == 'l' and lc_stripped_i > 0 -%}
          {%- assign lc_is_cap = true -%}
          {%- assign lc_prev_word = lc_tp -%}
        {%- endif -%}
        {%- if lc_is_cap and lc_prev_word != blank -%}
          {%- assign lc_capacity_token = lc_prev_word | append: ' ' | append: lc_tp -%}
          {%- if lc_last_char == 'l' -%}{%- assign lc_capacity_token = lc_tp -%}{%- endif -%}
        {%- elsif lc_is_cap -%}
          {%- assign lc_capacity_token = lc_tp -%}
        {%- endif -%}
      {%- endif -%}
      {%- assign lc_prev_word = lc_tp -%}
      {%- if lc_tp_lc == 'wine' or lc_tp_lc == 'beverage' -%}{%- assign lc_type_word = lc_tp -%}{%- endif -%}
      {%- if lc_tp_lc == 'cabinet' or lc_tp_lc == 'fridge' or lc_tp_lc == 'centre' or lc_tp_lc == 'center' -%}{%- assign lc_container_word = lc_tp -%}{%- endif -%}
      {%- if lc_tp_lc == 'duo' -%}{%- assign lc_duo_word = 'Duo' -%}{%- endif -%}
    {%- endfor -%}
    {%- assign lc_vendor_up = 'LeCavist' -%}
    {%- if lc_capacity_token != blank and lc_container_word != blank -%}
      {%- assign lc_display_title = lc_capacity_token | append: ' ' | append: lc_vendor_up -%}
      {%- if lc_type_word != blank -%}{%- assign lc_display_title = lc_display_title | append: ' ' | append: lc_type_word -%}{%- endif -%}
      {%- assign lc_display_title = lc_display_title | append: ' ' | append: lc_container_word -%}
      {%- if lc_duo_word != blank -%}{%- assign lc_display_title = lc_display_title | append: ' ' | append: lc_duo_word -%}{%- endif -%}
    {%- else -%}
      {%- assign lc_display_title = product.title | split: ' - ' | first -%}
    {%- endif -%}

    {%- capture lc_effective_tags -%}{%- render 'lc-effective-tags', product: product -%}{%- endcapture -%}
    {%- assign lc_effective_tags = lc_effective_tags | strip -%}
    {%- assign lc_tag_list = lc_effective_tags | split: '|' -%}
    {%- comment -%} Pre-order: manual 'pre-order' tag OR no state currently in stock {%- endcomment -%}
    {%- capture lc_po_raw -%}{%- render 'lc-is-preorder', product: product -%}{%- endcapture -%}
    {%- assign lc_po_raw = lc_po_raw | strip -%}
    {%- assign lc_is_preorder = false -%}
    {%- if lc_po_raw == 'true' -%}{%- assign lc_is_preorder = true -%}{%- endif -%}

    {%- capture lc_sku -%}{%- render 'lc-product-sku', product: product, variant: current_variant -%}{%- endcapture -%}
    {%- assign lc_sku = lc_sku | strip -%}

    {%- assign lc_is_fs = false -%}
    {%- assign lc_sku_up = lc_sku | upcase -%}
    {%- if lc_sku_up.size > 2 -%}
      {%- assign lc_sku_last2 = lc_sku_up | slice: -2, 2 -%}
      {%- if lc_sku_last2 == 'FS' -%}{%- assign lc_is_fs = true -%}{%- endif -%}
    {%- endif -%}

    {%- assign lc_m_is_bev = false -%}
    {%- for lc_m_bcol in product.collections -%}{%- if lc_m_bcol.handle == 'beverage' -%}{%- assign lc_m_is_bev = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
    {%- if lc_m_is_bev -%}<a href="/collections/beverage" class="lc-cat-pill">Beverage Centre</a>{%- endif -%}
    <h1 class="lc-title">
      {{ lc_display_title }}
      {%- if lc_is_preorder %} <span class="lc-d-preorder-badge">Pre-order</span>{%- endif -%}
      {%- if lc_is_fs %} <span class="lc-fs-badge">Full Shelves Version</span>{%- endif -%}
    </h1>
    {%- if lc_sku != blank -%}<div class="lc-sku">(Ref. {{ lc_sku }})</div>{%- endif -%}
    {% render 'lc-duo-badge', product: product, st: section.settings, pos: 'under_title' %}

    {%- comment %} Reviews widget - replace with your review app's snippet {%- endcomment %}
    <div class="lc-reviews-summary">
      {%- comment %}
        ACTIVE: Judge.me preview badge (star rating near title).
        Once Judge.me is confirmed working, replace the anchor below with:
          <a href="#lc-reviews-full" class="lc-reviews-anchor">
            {% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', concierge_install: true, product: product %}
          </a>
        The lc-jdgm CSS overrides below will style the badge to match our design.
        Placeholder shown until Judge.me is connected:
      {%- endcomment %}
      {%- comment %} Judge.me preview badge (display only) + clickable arrow that scrolls to the reviews widget {%- endcomment %}
      <div class="lc-jdgm-rating-row">
        <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
          {{ product.metafields.judgeme.badge }}
        </div>
        <a href="#lc-jdgm-reviews-target" class="lc-jdgm-arrow-link" aria-label="Jump to customer reviews" data-lc-scroll-jdgm>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 3v10M3 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

    {%- comment %} Dimensions - plain text under the reviews widget, same grey as SKU {%- endcomment %}
    {%- assign lc_m_sp = product.metafields.lecavist_specs -%}
    {%- if lc_m_sp.width_mm.value != blank and lc_m_sp.height_mm.value != blank and lc_m_sp.depth_mm.value != blank -%}
      <div class="lc-m-dims">Dimensions: W&nbsp;{{ lc_m_sp.width_mm.value }} &times; H&nbsp;{{ lc_m_sp.height_mm.value }} &times; D&nbsp;{{ lc_m_sp.depth_mm.value }}&nbsp;mm</div>
      {%- if section.settings.pdp_under_dim_text != blank and section.settings.pdp_show_short_desc -%}<div class="lc-under-dim rte">{{ section.settings.pdp_under_dim_text }}</div>{%- endif -%}
    {%- endif -%}
