    {%- comment %} Trust icons moved up - now rendered just under the picture gallery {%- endcomment %}

    {%- comment %} Price block - editorial style matching desktop {%- endcomment %}
    <div class="lc-price-block">
      <div class="lc-price-kicker">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l4 4 10-10"/></svg>
        <span>All-inclusive - delivery, installation &amp; old cabinet collected</span>
      </div>
      <div class="lc-price-main" id="lc-price">{{ current_variant.price | money }}</div>
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <div class="lc-price-was"><s>{{ current_variant.compare_at_price | money }}</s></div>
      {%- endif -%}
      <div class="lc-price-sub">
        4 interest-free payments of <strong>{{ current_variant.price | divided_by: 4 | money }}</strong> with
        <img src="https://static.afterpay.com/app/images/badge-mint-on-white.png" alt="Afterpay" style="height:18px;vertical-align:middle;display:inline-block;margin-left:2px" onerror="this.style.display='none';this.nextSibling.style.display='inline'"><span style="display:none;font-weight:600;color:#4b7e59">Afterpay</span>
      </div>
    </div>

    {%- comment %}
    ??? OPTION NAVIGATION TILES ????????????????????????????????
    Top row  : metafield-based attributes ? link to filtered collections
    Bottom row: product variant options   ? change variant in-page (styled as tiles)

    Collection handles are set in the Theme Editor (section settings).
    If no handle is provided the tile falls back to /collections/[handleized-value].

    Metafields required (specs namespace):
      installation_type  e.g. "Freestanding"
      zone_type          e.g. "Single Zone"
      size_range         e.g. "Medium Range"   ? new metafield, add under Settings ? Custom data
    {%- endcomment %}

    {%- comment %} Fall back to parent's specs metafields when the FS product lacks its own. {%- endcomment %}
    {%- assign lc_spec_install = specs.installation_type -%}
    {%- assign lc_spec_zone    = specs.zone_type -%}
    {%- assign lc_spec_size    = specs.size_range -%}
    {%- if lc_parent_product != blank -%}
      {%- assign _pspecs = lc_parent_product.metafields.specs -%}
      {%- if lc_spec_install == blank -%}{%- assign lc_spec_install = _pspecs.installation_type -%}{%- endif -%}
      {%- if lc_spec_zone    == blank -%}{%- assign lc_spec_zone    = _pspecs.zone_type         -%}{%- endif -%}
      {%- if lc_spec_size    == blank -%}{%- assign lc_spec_size    = _pspecs.size_range        -%}{%- endif -%}
    {%- endif -%}

    <div class="lc-optnav" role="group" aria-label="Browse by feature">

      {%- comment %} - Installation type - {%- endcomment %}
      {%- if lc_spec_install != blank -%}
        {%- assign lc_install_handle = section.settings.collection_installation | default: lc_spec_install | handleize -%}
        <a href="{{ routes.collections_url }}/{{ lc_install_handle }}"
           class="lc-opttile"
           aria-label="Browse all {{ lc_spec_install }} wine cabinets">
          <span class="lc-opttile__label">Type</span>
          <span class="lc-opttile__value">{{ lc_spec_install }}</span>
          <svg class="lc-opttile__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}

      {%- comment %} - Zone type - {%- endcomment %}
      {%- if lc_spec_zone != blank -%}
        {%- assign lc_zone_handle = section.settings.collection_zone | default: lc_spec_zone | handleize -%}
        <a href="{{ routes.collections_url }}/{{ lc_zone_handle }}"
           class="lc-opttile"
           aria-label="Browse all {{ lc_spec_zone }} wine cabinets">
          <span class="lc-opttile__label">Zone</span>
          <span class="lc-opttile__value">{{ lc_spec_zone }}</span>
          <svg class="lc-opttile__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}

      {%- comment %} - Size range - {%- endcomment %}
      {%- if lc_spec_size != blank -%}
        {%- assign lc_size_handle = section.settings.collection_size_range | default: lc_spec_size | handleize -%}
        <a href="{{ routes.collections_url }}/{{ lc_size_handle }}"
           class="lc-opttile"
           aria-label="Browse all {{ lc_spec_size }} wine cabinets">
          <span class="lc-opttile__label">Size</span>
          <span class="lc-opttile__value">{{ lc_spec_size }}</span>
          <svg class="lc-opttile__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}

      {%- comment %}
      - Variant-based options (e.g. Colour / Finish) --
      These change the variant in-page rather than linking away.
      Only rendered when the product has actual variants.
      {%- endcomment %}
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="lc-opttile-group" data-option-index="{{ forloop.index0 }}">
            <span class="lc-opttile__label">{{ option.name }}</span>
            <div class="lc-opttile-group__swatches">
              {%- for value in option.values -%}
                {%- assign lc_is_sel = false -%}
                {%- if current_variant.options[forloop.parentloop.index0] == value -%}
                  {%- assign lc_is_sel = true -%}
                {%- endif -%}
                <button
                  class="lc-optswatch{% if lc_is_sel %} is-selected{% endif %}"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                  data-value="{{ value | escape }}"
                  aria-pressed="{{ lc_is_sel }}"
                  aria-label="{{ option.name }}: {{ value }}"
                >
                  {{ value }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

    </div>{%- comment %} end .lc-optnav {%- endcomment %}

    {%- comment %} ??? 6. PURCHASE FORM ???????????????????????????? {%- endcomment %}

    {%- comment %} Savings banner - only on sale {%- endcomment %}
    {%- if current_variant.compare_at_price > current_variant.price -%}
      {%- assign savings_amt = current_variant.compare_at_price | minus: current_variant.price -%}
      <div class="lc-savings-badge" id="lc-savings-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
          <line x1="7" y1="7" x2="7" y2="7"/>
        </svg>
        <span>You are saving {{ savings_amt | money_without_trailing_zeros }} on your order</span>
      </div>
    {%- endif -%}

    {%- comment %} ??? AVAILABILITY BY STATE ??????????????????????? {%- endcomment %}
    {%- comment %}
      This block is automatically shown on every product page.
      To customise per-product, set the metafield custom.availability with
      the format: "NSW/ACT:In Stock QLD:In Stock VIC:Limited SA:In Stock WA:Limited"
      Leave blank to show the default delivery grid.
    {%- endcomment %}
    {%- comment -%} ??? AVAILABILITY BY STATE - state_availability metafields ??????? {%- endcomment -%}
    {%- comment -%}
      Waterfall:
        1. Product's own state_availability.* metafields
        2. Parent product (website-rev.parent_product reference) metafields - used by duo / full-shelf variants
        3. Nothing ? block hidden
      Namespace 'website-rev' has a hyphen, key 'parent_product' has an underscore - bracket notation needed for the namespace.
    {%- endcomment -%}
    {%- liquid
      assign lc_nsw_raw = product.metafields.state_availability.nsw.value | strip
      assign lc_vic_raw = product.metafields.state_availability.vic.value | strip
      assign lc_qld_raw = product.metafields.state_availability.qld.value | strip
      assign lc_sa_raw  = product.metafields.state_availability.sa.value  | strip
      assign lc_wa_raw  = product.metafields.state_availability.wa.value  | strip
      assign lc_has_own_avail = false
      if lc_nsw_raw != blank or lc_vic_raw != blank or lc_qld_raw != blank or lc_sa_raw != blank or lc_wa_raw != blank
        assign lc_has_own_avail = true
      endif

      unless lc_has_own_avail
        assign lc_avail_parent = product.metafields['website-rev'].parent_product.value
        if lc_avail_parent != blank
          assign lc_nsw_raw = lc_avail_parent.metafields.state_availability.nsw.value | strip
          assign lc_vic_raw = lc_avail_parent.metafields.state_availability.vic.value | strip
          assign lc_qld_raw = lc_avail_parent.metafields.state_availability.qld.value | strip
          assign lc_sa_raw  = lc_avail_parent.metafields.state_availability.sa.value  | strip
          assign lc_wa_raw  = lc_avail_parent.metafields.state_availability.wa.value  | strip
        endif
      endunless

      assign lc_has_avail = false
      if lc_nsw_raw != blank or lc_vic_raw != blank or lc_qld_raw != blank or lc_sa_raw != blank or lc_wa_raw != blank
        assign lc_has_avail = true
      endif
    -%}
    {%- comment %} Availability table + configurator moved below Add to Cart (see after the form) {%- endcomment %}

    {%- form 'product', product,
        id: 'lc-product-form',
        class: 'lc-atc-form',
        novalidate: 'novalidate',
        data-product-form: ''
    -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" id="lc-variant-id">

      {%- comment %} Quantity stepper {%- endcomment %}
      <div class="lc-qty-wrap">
        <span class="lc-qty__label">Quantity</span>
        <div class="lc-qty" role="group" aria-label="Quantity selector">
          <button type="button" class="lc-qty__btn lc-qty__minus" aria-label="Decrease quantity">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <input
            type="number"
            name="quantity"
            value="1"
            min="1"
            max="10"
            id="lc-qty-input"
            class="lc-qty__input"
            aria-label="Quantity"
          >
          <button type="button" class="lc-qty__btn lc-qty__plus" aria-label="Increase quantity">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
        {%- comment %} #5 - heart-only wishlist on the quantity line {%- endcomment %}
        <button type="button" class="lc-qty-heart" id="lc-m-wishlist-btn" onclick="lcMWishlist(this)" aria-label="Save {{ product.title }} to wishlist">
          <svg class="lc-wishlist-heart" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <path class="lc-heart-outline" d="M12 21l-1.45-1.32C5.4 15.36 2 12.27 2 8.5A5.5 5.5 0 0 1 7.5 3c1.74 0 3.41.81 4.5 2.08A5.99 5.99 0 0 1 16.5 3 5.5 5.5 0 0 1 22 8.5c0 3.77-3.4 6.86-8.55 11.19L12 21z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path class="lc-heart-filled" d="M12 21l-1.45-1.32C5.4 15.36 2 12.27 2 8.5A5.5 5.5 0 0 1 7.5 3c1.74 0 3.41.81 4.5 2.08A5.99 5.99 0 0 1 16.5 3 5.5 5.5 0 0 1 22 8.5c0 3.77-3.4 6.86-8.55 11.19L12 21z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" style="display:none"/>
          </svg>
        </button>
      </div>

      {%- comment %} Single Add to Cart button {%- endcomment %}
      <div class="lc-btn-row">
        <button
          type="submit"
          name="add"
          class="lc-atc-btn"
          id="lc-m-atc-btn"
          data-base-price="{{ current_variant.price | divided_by: 100.0 }}"
          {% unless current_variant.available %}disabled{% endunless %}
          aria-label="Add {{ product.title }} to cart"
        >
          {%- if current_variant.available -%}
            Add to Cart - {{ current_variant.price | money }}
          {%- else -%}
            Sold Out
          {%- endif -%}
        </button>
      </div>

    {%- endform -%}

    {%- comment %} ??? AVAILABILITY BY STATE - moved below Add to Cart ??? {%- endcomment %}
    {%- if lc_has_avail and section.settings.pdp_show_availability -%}
    <div class="lc-avail-block">
      <div class="lc-avail-block__header">
        <span class="lc-avail-block__eyebrow">- Delivery -</span>
        <span class="lc-avail-block__title">Availability by state</span>
      </div>
      <div class="lc-avail-block__grid">
        {%- for lc_si in (0..4) -%}
          {%- assign lc_state_abbrs = 'NSW,VIC,QLD,SA,WA' | split: ',' -%}
          {%- assign lc_state_raws  = lc_nsw_raw | append: '|' | append: lc_vic_raw | append: '|' | append: lc_qld_raw | append: '|' | append: lc_sa_raw | append: '|' | append: lc_wa_raw | split: '|' -%}
          {%- assign lc_sraw = lc_state_raws[lc_si] | strip -%}
          {%- assign lc_slc  = lc_sraw | downcase -%}
          {%- assign lc_sstatus = 'unavailable' -%}
          {%- if lc_slc == 'available' or lc_slc == 'yes' or lc_slc == 'in stock' or lc_slc == 'instock' -%}{%- assign lc_sstatus = 'yes' -%}
          {%- elsif lc_slc == 'limited' or lc_slc == 'low' or lc_slc == 'limited stock' or lc_slc == 'low stock' or lc_slc == 'limited availability' -%}{%- assign lc_sstatus = 'limited' -%}
          {%- elsif lc_slc == 'unavailable' or lc_slc == 'no' or lc_slc == 'out of stock' -%}{%- assign lc_sstatus = 'no' -%}
          {%- elsif lc_slc != blank -%}{%- assign lc_sstatus = 'restock' -%}{%- endif -%}
          <div class="lc-avail-cell">
            <span class="lc-avail-abbr lc-avail-m--{{ lc_sstatus }}">{{ lc_state_abbrs[lc_si] }}</span>
            <span class="lc-avail-status-m">
              {%- case lc_sstatus -%}
                {%- when 'yes' -%}In stock
                {%- when 'slow' or 'limited' -%}Limited
                {%- when 'no' -%}Unavail.
                {%- else -%}{{ lc_sraw }}
              {%- endcase -%}
            </span>
          </div>
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}

    {% render 'lc-duo-badge', product: product, st: section.settings, pos: 'above_configuration' %}

    {%- comment %} Product configuration block - moved below the Add to Cart button {%- endcomment %}
