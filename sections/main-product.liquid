            </div>
          </div>

          <button type="submit" name="add" id="lc-d-atc-btn" class="lc-d-atc" style="margin-top:8px" data-base-price="{{ lc_d_cv.price | divided_by: 100.0 }}" {% unless lc_d_cv.available %}disabled{% endunless %}>
            {%- if lc_d_cv.available -%}Add to Cart - {{ lc_d_cv.price | money }}{%- else -%}Sold Out{%- endif -%}
          </button>
          {%- comment %} Availability by state - rendered below Add to Cart, above the experts button (all PDPs) {%- endcomment %}
          {%- if lc_move_avail and lc_d_avail_html != blank -%}<div style="margin-top:12px">{{ lc_d_avail_html }}</div>{%- endif -%}
          {%- comment %} #5 - Contact our experts (desktop ? contact page) {%- endcomment %}
          <a href="/pages/contact" class="lc-d-experts-btn" aria-label="Contact our experts">
            <svg class="lc-d-experts-btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 13v-1.5a8 8 0 0 1 16 0V13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M4 13h1.7a1 1 0 0 1 1 1v3.3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V13z" fill="currentColor"/>
              <path d="M20 13h-1.7a1 1 0 0 0-1 1v3.3a1 1 0 0 0 1 1H19a1 1 0 0 0 1-1V13z" fill="currentColor"/>
              <path d="M18.5 18.6a2.6 2.6 0 0 1-2.6 2.4H13.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            Contact our experts
