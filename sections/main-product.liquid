  {%- comment -%} Desktop sticky bar - thumb + SKU + short title + price + CTA {%- endcomment -%}
  {%- liquid
    assign lc_d_sticky_sku = product.selected_or_first_available_variant.sku | upcase
    if lc_d_sticky_sku == blank
      assign lc_d_sticky_sku = product.metafields.custom.fs_sku.value | upcase
    endif
    # Build a short, scannable name e.g. "168 Bottle Wine Cabinet" by
    # picking the bottle count + container type from the product title.
    assign lc_d_sticky_bottles = ''
    assign lc_d_sticky_container = 'Cabinet'
    assign lc_d_sticky_type = 'Wine'
    assign lc_d_sticky_parts = product.title | split: ' '
    for lc_d_sp in lc_d_sticky_parts
      assign lc_d_sp_lc = lc_d_sp | downcase | remove: '-'
      if lc_d_sp_lc == 'bottle' or lc_d_sp_lc == 'bottles'
        assign lc_d_sticky_ix = forloop.index0 | minus: 1
        if lc_d_sticky_ix >= 0
          assign lc_d_sticky_bottles = lc_d_sticky_parts[lc_d_sticky_ix] | remove: '-'
        endif
      endif
      if lc_d_sp_lc == 'cabinet'
        assign lc_d_sticky_container = 'Cabinet'
      endif
      if lc_d_sp_lc == 'fridge'
        assign lc_d_sticky_container = 'Fridge'
      endif
      if lc_d_sp_lc == 'beverage'
        assign lc_d_sticky_type = 'Beverage'
      endif
    endfor
    if lc_d_sticky_bottles != blank
      assign lc_d_sticky_name = lc_d_sticky_bottles | append: ' Bottle ' | append: lc_d_sticky_type | append: ' ' | append: lc_d_sticky_container
    else
      assign lc_d_sticky_name = product.title | truncate: 50
    endif
  -%}
  <div class="lc-d-sticky" id="lc-d-sticky">
    <div class="lc-d-sticky__inner">
      {%- if product.featured_image != blank -%}
        <img class="lc-d-sticky__thumb"
             src="{{ product.featured_image | image_url: width: 96 }}"
             alt="{{ product.title | escape }}"
             width="40" height="40" loading="lazy">
      {%- endif -%}
      <div class="lc-d-sticky__info">
        {%- if lc_d_sticky_sku != blank -%}
          <span class="lc-d-sticky__sku">{{ lc_d_sticky_sku }}</span>
        {%- endif -%}
        <span class="lc-d-sticky__name">{{ lc_d_sticky_name }}</span>
      </div>
      <div class="lc-d-sticky__price" id="lc-d-sticky-price">{{ lc_d_cv.price | money }}</div>
      <button class="lc-d-sticky__btn" onclick="document.getElementById('{{ lc_d_pfid }}').dispatchEvent(new Event('submit',{bubbles:true,cancelable:true}))">
        {%- if lc_d_cv.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
      </button>
    </div>
  </div>

  <script>
  (function(){
    var lcDActive = 0;
    var lcDImgs = document.querySelectorAll('#lc-d-gallery-main .lc-d-gallery__slide');
    var lcDThumbs = document.querySelectorAll('#lc-d-thumbs .lc-d-thumb');
    var lcDDots = document.querySelectorAll('#lc-d-dots .lc-d-dot');
    var lcDLabel = document.getElementById('lc-d-overlay-label');
    var lcDQtyInput = document.getElementById('lc-d-qty-input');
    var lcDQtyDisplay = document.getElementById('lc-d-qty-display');
    var lcDAtcBtn = document.getElementById('lc-d-atc-btn');
    var lcDPriceEl = document.getElementById('lc-d-price');
    var lcDStickyPrice = document.getElementById('lc-d-sticky-price');
    var lcDSticky = document.getElementById('lc-d-sticky');
    var lcDQty = 1;

    window.lcDGoto = function(idx) {
      if (!lcDImgs[idx]) return;
      lcDImgs[lcDActive].classList.remove('is-active');
      if (lcDDots[lcDActive]) lcDDots[lcDActive].classList.remove('is-active');
      if (lcDThumbs[lcDActive]) lcDThumbs[lcDActive].classList.remove('is-active');
      lcDActive = idx;
      lcDImgs[lcDActive].classList.add('is-active');
      if (lcDDots[lcDActive]) lcDDots[lcDActive].classList.add('is-active');
      if (lcDThumbs[lcDActive]) lcDThumbs[lcDActive].classList.add('is-active');
      if (lcDLabel) lcDLabel.textContent = '0' + (idx+1) + ' / 0' + lcDImgs.length;
    };

    window.lcDQty = function(delta) {
      lcDQty = Math.max(1, lcDQty + delta);
      if (lcDQtyDisplay) lcDQtyDisplay.textContent = lcDQty;
      if (lcDQtyInput) lcDQtyInput.value = lcDQty;
      // Update ATC button total
      if (lcDAtcBtn && lcDAtcBtn.dataset.basePrice) {
        var total = parseFloat(lcDAtcBtn.dataset.basePrice) * lcDQty;
        var fmt = '$' + total.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        lcDAtcBtn.textContent = 'Add to Cart - ' + fmt;
      }
    };

    // Sticky bar
    if (lcDSticky && lcDAtcBtn) {
      window.addEventListener('scroll', function() {
        var rect = lcDAtcBtn.getBoundingClientRect();
        lcDSticky.classList.toggle('is-visible', rect.bottom < 0);
      }, { passive: true });
    }

    // Variant selection
    var lcDProd = {{ product | json }};
    document.querySelectorAll('.lc-d-opt-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var idx = parseInt(btn.dataset.optionIdx);
        document.querySelectorAll('.lc-d-opt-btn[data-option-idx="' + idx + '"]').forEach(function(b) {
          b.classList.remove('is-selected');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-selected');
        btn.setAttribute('aria-pressed', 'true');

        var selected = [];
        document.querySelectorAll('.lc-d-option-btns').forEach(function(grp, i) {
          var s = grp.querySelector('.lc-d-opt-btn.is-selected');
          selected[i] = s ? s.dataset.value : '';
        });

        var match = lcDProd.variants.find(function(v) {
          return v.options.every(function(opt, i) { return opt === selected[i]; });
        });

        if (match) {
          var varInput = document.getElementById('lc-d-variant-id');
          if (varInput) varInput.value = match.id;
          var price = match.price / 100;
          var formatted = '$' + price.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
          if (lcDPriceEl) lcDPriceEl.textContent = formatted;
          if (lcDStickyPrice) lcDStickyPrice.textContent = formatted;
          if (lcDAtcBtn) {
            lcDAtcBtn.disabled = !match.available;
            lcDAtcBtn.textContent = match.available ? 'Add to Cart \u2014 ' + formatted : 'Sold Out';
            lcDAtcBtn.style.background = match.available ? 'var(--lc-ed-acc, #6B1F2E)' : 'rgba(26,21,18,0.15)';
          }
          var url = new URL(window.location.href);
          url.searchParams.set('variant', match.id);
          window.history.replaceState({}, '', url.toString());
        }
      });
    });

    // ?? Wishlist - writes to theme's native 'glozin__wishlist-items' key
    // and refreshes the header counter via wishlistHeader.init()
    var LC_WL_KEY = 'glozin__wishlist-items';
    function lcRefreshWlHeader() {
      if (typeof window.wishlistHeader !== 'undefined' && window.wishlistHeader.init) {
        window.wishlistHeader.init();
      } else {
        var items = JSON.parse(localStorage.getItem(LC_WL_KEY) || '[]');
        document.querySelectorAll('.wishlist-count').forEach(function(el) {
          el.innerText = items && items.length ? items.length : 0;
        });
      }
    }
    window.lcDWishlist = function(btn) {
      var pid = '{{ product.id }}';
      var stored = JSON.parse(localStorage.getItem(LC_WL_KEY) || '[]');
      var idx = stored.indexOf(pid);
      if (idx === -1) {
        stored.push(pid);
        btn.classList.add('is-wishlisted');
        btn.setAttribute('aria-label', 'Saved to wishlist');
      } else {
        stored.splice(idx, 1);
        btn.classList.remove('is-wishlisted');
        btn.setAttribute('aria-label', 'Save to wishlist');
      }
      localStorage.setItem(LC_WL_KEY, JSON.stringify(stored));
      lcRefreshWlHeader();
    };
    window.lcMWishlist = function(btn) {
      var pid = '{{ product.id }}';
      var stored = JSON.parse(localStorage.getItem(LC_WL_KEY) || '[]');
      var idx = stored.indexOf(pid);
      var label = btn.querySelector('.lc-wishlist-label');
      if (idx === -1) {
        stored.push(pid);
        btn.classList.add('is-wishlisted');
        if (label) label.textContent = 'Saved to wishlist';
      } else {
        stored.splice(idx, 1);
        btn.classList.remove('is-wishlisted');
        if (label) label.textContent = 'Save to wishlist';
      }
      localStorage.setItem(LC_WL_KEY, JSON.stringify(stored));
      lcRefreshWlHeader();
    };
    // Init wishlist button state from storage on load
    (function() {
      var pid = '{{ product.id }}';
      var stored = JSON.parse(localStorage.getItem(LC_WL_KEY) || '[]');
      var wlBtn = document.getElementById('lc-d-wishlist-btn');
      if (wlBtn && stored.indexOf(pid) !== -1) {
        wlBtn.classList.add('is-wishlisted');
      }
      var mWlBtn = document.getElementById('lc-m-wishlist-btn');
      if (mWlBtn && stored.indexOf(pid) !== -1) {
        mWlBtn.classList.add('is-wishlisted');
        var label = mWlBtn.querySelector('.lc-wishlist-label');
        if (label) label.textContent = 'Saved to wishlist';
      }
    })();

    // ?? Email to myself modal ???????????????????????????????????
    var lcDEmailModal   = document.getElementById('lc-d-email-modal');
    var lcDEmailBackdrop = document.getElementById('lc-d-email-backdrop');
    var lcDEmailInput   = document.getElementById('lc-d-email-input');
    var lcDEmailStatus  = document.getElementById('lc-d-email-status');

    window.lcDEmailOpen = function() {
      if (!lcDEmailModal) return;
      lcDEmailModal.classList.add('is-open');
      lcDEmailModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (lcDEmailInput) setTimeout(function() { lcDEmailInput.focus(); }, 100);
    };
    window.lcDEmailClose = function() {
      if (!lcDEmailModal) return;
      lcDEmailModal.classList.remove('is-open');
      lcDEmailModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };
    if (lcDEmailBackdrop) lcDEmailBackdrop.addEventListener('click', window.lcDEmailClose);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') window.lcDEmailClose(); });

    window.lcDEmailSend = function() {
      var email = lcDEmailInput ? lcDEmailInput.value.trim() : '';
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (lcDEmailStatus) { lcDEmailStatus.style.color = '#991b1b'; lcDEmailStatus.textContent = 'Please enter a valid email address.'; }
        return;
      }
      if (typeof window.lcRecapSend !== 'function') {
        if (lcDEmailStatus) { lcDEmailStatus.style.color = '#991b1b'; lcDEmailStatus.textContent = 'Could not send - please try again.'; }
        return;
      }
      var box = lcDEmailModal ? lcDEmailModal.querySelector('[data-recap-compare]') : null;
      var selected = (box && box._lcSelected) ? box._lcSelected() : [];
      var sendBtn = lcDEmailModal ? lcDEmailModal.querySelector('.lc-d-email-modal__send') : null;
      if (sendBtn) sendBtn.disabled = true;
      if (lcDEmailStatus) { lcDEmailStatus.style.color = ''; lcDEmailStatus.textContent = 'Sending.'; }
      window.lcRecapSend({ email: email, selected: selected })
        .then(function() {
          var n = selected.length;
          if (lcDEmailStatus) { lcDEmailStatus.style.color = '#1a6642'; lcDEmailStatus.textContent = n ? ('? Sent! Your comparison of ' + (n + 1) + ' cabinets is on its way.') : '? Sent! Check your inbox.'; }
          if (lcDEmailInput) lcDEmailInput.value = '';
          setTimeout(window.lcDEmailClose, 3500);
        })
        .catch(function(err) {
          if (err && err.message === 'no-key') console.warn('[lc-recap] Klaviyo public key not set in theme settings - email recap disabled.');
          else console.warn('[lc-recap] desktop send failed:', err);
          if (lcDEmailStatus) { lcDEmailStatus.style.color = '#991b1b'; lcDEmailStatus.textContent = 'Could not send - please try again.'; }
        })
        .finally(function() { if (sendBtn) sendBtn.disabled = false; });
    };

  })();
  </script>

  {%- comment %} Click handler for the rating badge ? smooth-scrolls to the Judge.me reviews widget anywhere on the page {%- endcomment %}
  <script>
  (function(){
    function findJdgmTarget(){
      return document.querySelector('.jdgm-rev-widg') ||
             document.querySelector('.jdgm-review-widget') ||
             document.querySelector('[data-template="product"].jdgm-widget') ||
             document.querySelector('[id*="judgeme_reviews_lc"]') ||
             document.querySelector('.shopify-section[id*="judgeme"]');
    }
    document.addEventListener('click', function(e){
      var anchor = e.target.closest('[data-lc-scroll-jdgm]');
      if (!anchor) return;
      var target = findJdgmTarget();
      if (!target) return;
      e.preventDefault();
      var headerOffset = 80;
      var top = target.getBoundingClientRect().top + window.pageYOffset - headerOffset;
      window.scrollTo({ top: top, behavior: 'smooth' });
    });
    // "Show more" toggle on the product short description
    document.addEventListener('click', function(e){
      var t = e.target.closest('[data-lc-desc-toggle]');
      if (!t) return;
      var rest = t.parentNode.querySelector('.lc-d-desc-rest');
      if (!rest) return;
      if (rest.hasAttribute('hidden')) {
        rest.removeAttribute('hidden'); t.textContent = 'Show less'; t.setAttribute('aria-expanded','true');
      } else {
        rest.setAttribute('hidden',''); t.textContent = 'Show more'; t.setAttribute('aria-expanded','false');
      }
    });
  })();
  </script>

  {%- comment %} Desktop reviews carousel moved into its own section: sections/product-reviews-teaser.liquid {%- endcomment %}

  {% if enable_frequently_bought_together and products_bought_together.size > 0 %}
    <product-bought-together class="block" id="product-bought-together">
      <script type="application/json" class="productBoughTogether">
        [{{ product.id }},{%- for item in products_bought_together -%}{{ item | split: 'Product/' | last | split: '"' | first }}{%- unless forloop.last -%},{%- endunless forloop.last -%}{%- endfor -%}]
      </script>
    </product-bought-together>
  {% endif %}
  {% if enable_sticky_add_cart_on_desktop == true or enable_sticky_add_cart_on_mobile == true %}
    {%- assign product_form_id = 'sticky-addcart-form-' | append: section.id -%}
    <sticky-add-cart class="fixed z-10 inset-x-0 bottom-0 py-15 shadow color-default transition-popup invisible {% if enable_sticky_add_cart_on_desktop == true %}sticky_desktop--show{% else %} hidden-md{% endif %}{% if enable_sticky_add_cart_on_mobile == true %} sticky_mobile--show{% else %} hidden{% endif %}">
      <div class="{{ section_width }}">
        <div class="flex gap-15 justify-between align-center">
          {% render 'product-item', card_product: product, section_id: section.id, template_enable_action: false, template_enable_product_vendor: false, template_enable_rate: true, template_enable_product_short_description: false, template_enable_color_swatches: false, type: 'sticky', class: 'hidden block-md', section_st: section_st %}
          <div class="sticky__item-info flex gap-10 w-full w-md-unset">
            <div class="product-detail__variant-picker text-size heading-color w-full">
              {% if user_variants_image_group %}{%- render 'color-swatches', product: product, type: 'sticky_group' -%}{% else %}{%- render 'color-swatches', product: product, type: 'sticky' -%}{% endif %}
            </div>
            <div class="product-detail__buy-buttons w-full">
              {%- render 'buy-buttons', product: product, product_form_id: product_form_id, section_id: section.id, show_wishlist: false, show_compare: false, formClass: 'feature-product-form', type: 'sticky' -%}
            </div>
          </div>
        </div>
      </div>
    </sticky-add-cart>
  {% endif %}
  {% unless product == empty %}
    <script type="application/json" data-product-json class="productJson">{{ product | json }}</script>
  {% endunless %}
  {%- unless product.has_only_default_variant -%}
    <script type="application/json" class="productVariantsQty">
      [
        {%- for variant in product.variants -%}
          {%- assign op = variant.option1 | replace: '"', '\"' -%}
          {%- liquid
            assign id            = '"id":'             | append: variant.id
            assign option        = '"option":"'        | append: op | append: '"'
            assign quantity      = '"qty":'            | append: variant.inventory_quantity
            assign available     = '"available":'      | append: variant.available
            assign mamagement    = '"mamagement":"'    | append: variant.inventory_management | append: '"'
            assign incoming      = '"incoming":"'      | append: variant.incoming | append: '"'
            assign incoming_date = '"incoming_date":"' | append: variant.next_incoming_date | append: '"'
          -%}
          { {{ id }},{{ option }},{{ quantity }},{{ available }},{{ mamagement }},{{ incoming }},{{ incoming_date }}}
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
  {%- endunless -%}
  {%- if first_3_d_model -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">{{ product.media | where: 'media_type', 'model' | json }}</script>
    <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {% endif %}
  {%- liquid
    if product.selected_or_first_available_variant.featured_media
      assign seo_media = product.selected_or_first_available_variant.featured_media
    else
      assign seo_media = product.featured_media
    endif
  -%}
  {%- capture lc_seo_sku -%}{%- render 'lc-product-sku', product: product -%}{%- endcapture -%}
  {%- assign lc_seo_sku = lc_seo_sku | strip -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {% if seo_media -%}
        "image": [{{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}],
      {%- endif %}
      "description": {{ product.description | strip_html | json }},
      {% if lc_seo_sku != blank -%}
        "sku": {{ lc_seo_sku | json }},
      {%- endif %}
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      "offers": [
        {%- for variant in product.variants -%}
          {%- capture lc_offer_sku -%}{%- render 'lc-product-sku', product: product, variant: variant -%}{%- endcapture -%}
          {%- assign lc_offer_sku = lc_offer_sku | strip -%}
          {
            "@type": "Offer",
            {%- if lc_offer_sku != blank -%}"sku": {{ lc_offer_sku | json }},{%- endif %}
            "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "price": {{ variant.price | divided_by: 100.00 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "url": {{ request.origin | append: variant.url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  {%- comment %} The section wrapper opens as a plain <div> unconditionally;
      the old skeleton-page conditional close had no matching opener and left
      the wrapper unclosed whenever enable_skeleton_loading was true. {%- endcomment %}
  </div>
