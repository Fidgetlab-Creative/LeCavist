{%- comment %} ??? 8. STICKY BOTTOM BAR (mobile) ???????????????? {%- endcomment %}
{%- comment %}
  This bar stays fixed at the bottom of the screen on mobile.
  It shows the price and an ATC button at all times as the user scrolls.
  It auto-hides on desktop where the main ATC button is already visible.
{%- endcomment %}
{%- liquid
  assign lc_m_sticky_sku = current_variant.sku | upcase
  if lc_m_sticky_sku == blank
    assign lc_m_sticky_sku = product.metafields.custom.fs_sku.value | upcase
  endif
-%}
<div class="lc-sticky-bar" id="lc-sticky-bar" aria-hidden="true">
  <div class="lc-sticky-bar__inner">
    {%- if product.featured_image != blank -%}
      <img class="lc-sticky-bar__thumb"
           src="{{ product.featured_image | image_url: width: 88 }}"
           alt="{{ product.title | escape }}"
           width="36" height="36" loading="lazy">
    {%- endif -%}
    <div class="lc-sticky-bar__info">
      {%- if lc_m_sticky_sku != blank -%}
        <span class="lc-sticky-bar__sku">{{ lc_m_sticky_sku }}</span>
      {%- endif -%}
      <span class="lc-sticky-bar__price" id="lc-sticky-price">{{ current_variant.price | money }}</span>
    </div>
    <button
      class="lc-sticky-bar__btn"
      id="lc-sticky-atc"
      {% unless current_variant.available %}disabled{% endunless %}
      aria-label="Add {{ product.title }} to cart"
    >
      {%- if current_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
    </button>
  </div>
</div>


