      {%- comment %} Email to self - sends product summary to user's email {%- endcomment %}
      <button class="lc-email-self-btn" id="lc-email-self-btn" type="button" aria-label="Email this product to yourself">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <path d="M2 7l10 7 10-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Email to myself
