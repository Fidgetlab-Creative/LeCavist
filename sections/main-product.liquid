              <span class="lc-d-wc-label lc-d-eyebrow">? {{ section.settings.pdp_incl_heading | default: 'Included with purchase' }}</span>
              {%- if section.settings.pdp_incl_badge != blank -%}<span class="lc-d-wc-badge lc-d-wc-badge--green">{{ section.settings.pdp_incl_badge }}</span>{%- endif -%}
