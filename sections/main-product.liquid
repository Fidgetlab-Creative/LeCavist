    <button class="lc-gallery-lightbox__nav lc-gallery-lightbox__nav--prev" type="button" aria-label="Previous image" data-lc-lb-prev>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button class="lc-gallery-lightbox__nav lc-gallery-lightbox__nav--next" type="button" aria-label="Next image" data-lc-lb-next>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
