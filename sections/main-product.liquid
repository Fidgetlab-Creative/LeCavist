          <path d="M4 13h1.7a1 1 0 0 1 1 1v3.3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V13z" fill="currentColor"/>
          <path d="M20 13h-1.7a1 1 0 0 0-1 1v3.3a1 1 0 0 0 1 1H19a1 1 0 0 0 1-1V13z" fill="currentColor"/>
          <path d="M18.5 18.6a2.6 2.6 0 0 1-2.6 2.4H13.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
