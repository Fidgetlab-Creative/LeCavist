          src="{{ image | image_url: width: 1600 }}"
          alt="{{ image.alt | default: product.title | escape }}"
          loading="lazy"
        >
      {%- endfor -%}
    </div>
  </div>

  {%- comment %} ??? VIDEO BUTTON - lc_vid_src already resolved above (before the gallery) ??? {%- endcomment %}

  {%- comment %} ??? Watch-in-video pill (placed above the trust icons) ??? {%- endcomment %}
  {%- if lc_vid_src != blank -%}
    <div class="lc-video-pill-wrap">
      <button
        class="lc-video-pill"
