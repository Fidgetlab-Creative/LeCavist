  /* Image variant: the artwork already carries its own background and radius */
  .lc-duo-badge--image { padding: 0; background: none; border-radius: 0; display: block; }
  .lc-duo-badge__img { display: block; width: 100%; height: auto; border-radius: .62em; }
</style>

  {%- comment %} ??? MOBILE-ONLY CUSTOM PDP - hidden on desktop via CSS ??? {%- endcomment %}

  {%- comment %} ??? MOBILE-ONLY CUSTOM PDP - hidden on desktop via CSS ??? {%- endcomment %}
  <div class="lc-mobile-pdp-wrapper">
{%- assign product = product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- comment %} Metafield shortcuts {%- endcomment %}
{%- assign specs = product.metafields.specs -%}
{%- assign faq   = product.metafields.faq -%}

<div class="lc-pdp" id="lc-product-{{ product.id }}" data-product-id="{{ product.id }}">

  {%- comment %} ??? 2. HERO IMAGE GALLERY ????????????????????? {%- endcomment %}
  {%- assign gallery_ratio  = section.settings.gallery_mobile_ratio | default: 'auto' -%}
  {%- assign gallery_maxh   = section.settings.gallery_max_height    | default: 520 -%}

  {%- comment %} ??? Resolve the product video URL EARLY (before the gallery) so it can
      be used by the gallery (appended end-slide), the "Watch in video" pill, the
      modal, and the desktop mosaic. Resolution order:
        1) editor setting (video_button_url)
        2) the product's own video media
        3) a shopable video linked to this product elsewhere on the site
           (incl. the homepage carousel) via the handle?url map snippet. {%- endcomment %}
  {%- liquid
    assign lc_vid_src = section.settings.video_button_url
    if lc_vid_src == blank
      for lc_vid_m in product.media
        if lc_vid_m.media_type == 'video'
          for lc_vid_s in lc_vid_m.sources
            if lc_vid_s.format == 'mp4'
              assign lc_vid_src = lc_vid_s.url
              break
            endif
          endfor
          break
        endif
      endfor
    endif
  -%}
  {%- if lc_vid_src == blank -%}
    {%- capture lc_vid_shop -%}{%- render 'shopable-video-map', handle: product.handle -%}{%- endcapture -%}
    {%- assign lc_vid_src = lc_vid_shop | strip -%}
  {%- endif -%}

  {%- comment %} Per-product override: hide the product video entirely (gallery slide, pill, modal, mosaic) {%- endcomment %}
  {%- if section.settings.video_hide -%}{%- assign lc_vid_src = '' -%}{%- endif -%}

  {%- comment -%} PDP block-font overrides (Theme settings ? Product page) - only emitted when a toggle is on, so the default look is unchanged {%- endcomment -%}
  {%- if section.settings.pdp_avail_font_enable or section.settings.pdp_config_font_enable or section.settings.pdp_setup_font_enable -%}
    <style>
      {%- if section.settings.pdp_avail_font_enable -%}{{ section.settings.pdp_avail_font | font_face }}
      .lc-avail-block, .lc-avail-block *, .lc-d-avail-wrap, .lc-d-avail-wrap * { font-family: {{ section.settings.pdp_avail_font.family }}, {{ section.settings.pdp_avail_font.fallback_families }} !important; }{%- endif -%}
      {%- if section.settings.pdp_config_font_enable -%}{{ section.settings.pdp_config_font | font_face }}
      .lc-pdp-config-font, .lc-pdp-config-font * { font-family: {{ section.settings.pdp_config_font.family }}, {{ section.settings.pdp_config_font.fallback_families }} !important; }{%- endif -%}
      {%- if section.settings.pdp_setup_font_enable -%}{{ section.settings.pdp_setup_font | font_face }}
      .lc-pdp-setup-font, .lc-pdp-setup-font * { font-family: {{ section.settings.pdp_setup_font.family }}, {{ section.settings.pdp_setup_font.fallback_families }} !important; }{%- endif -%}
    </style>
  {%- endif -%}
  <div class="lc-gallery" id="lc-gallery"
       style="--lc-gallery-ratio: {{ gallery_ratio }}; --lc-gallery-maxh: {{ gallery_maxh }}px">

    {%- comment %} Image viewport - wraps zoom + track + counter so the
        counter overlay anchors to the image area, not the gallery container
        (otherwise it overlaps the tab strip below). {%- endcomment %}
    <div class="lc-gallery__viewport">
      {% render 'lc-merch-badges', product: product, class: 'lc-mbadges--overlay' %}
      <button class="lc-gallery__zoom" aria-label="Zoom image" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/>
          <path d="M16.5 16.5L21 21M8 11h6M11 8v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>

      {%- comment %}
        Per-slide tab category. Read from image alt-text prefix:
          "PRODUCT: ..."   ? product
          "INSIDE: ..."    ? inside
          "LIFESTYLE: ..." ? lifestyle
          "DETAILS: ..."   ? details
        Anything else falls back to the Product tab.
      {%- endcomment %}
      <div class="lc-gallery__track" id="lc-gallery-track">
      {%- for image in product.images -%}
        {%- assign lc_alt_u = image.alt | upcase | strip -%}
        {%- assign lc_prefix7  = lc_alt_u | slice: 0, 7  -%}
        {%- assign lc_prefix8  = lc_alt_u | slice: 0, 8  -%}
        {%- assign lc_prefix10 = lc_alt_u | slice: 0, 10 -%}
        {%- comment %} Untagged / unknown prefixes fall back to the Product tab {%- endcomment %}
        {%- assign lc_slide_tab = 'product' -%}
        {%- if lc_prefix8  == 'PRODUCT:'   -%}{%- assign lc_slide_tab = 'product'   -%}{%- endif -%}
        {%- if lc_prefix7  == 'INSIDE:'    -%}{%- assign lc_slide_tab = 'inside'    -%}{%- endif -%}
        {%- if lc_prefix10 == 'LIFESTYLE:' -%}{%- assign lc_slide_tab = 'lifestyle' -%}{%- endif -%}
        {%- if lc_prefix8  == 'DETAILS:'   -%}{%- assign lc_slide_tab = 'details'   -%}{%- endif -%}
        <div class="lc-gallery__slide" data-index="{{ forloop.index0 }}" data-tab="{{ lc_slide_tab }}">
          <img
            src="{{ image | image_url: width: 1000 }}"
            alt="{{ image.alt | default: product.title | escape }}"
            width="1000"
            height="{{ 1000 | divided_by: image.aspect_ratio | round }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            class="lc-gallery__img"
          >
        </div>
      {%- endfor -%}
      </div>

      {%- comment %} Counter overlay - absolute inside the viewport so it
          anchors to the image bottom (no longer to the tabs row). {%- endcomment %}
      {%- if product.images.size > 1 -%}
        <div class="lc-gallery__nav" role="group" aria-label="Image navigation">
          <button class="lc-gallery__nav-btn lc-gallery__prev" aria-label="Previous image" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <span class="lc-gallery__counter">
            <span id="lc-gallery-current">1</span>
            <span class="lc-gallery__counter-sep">/</span>
            <span id="lc-gallery-total">{{ product.images.size }}</span>
          </span>
          <button class="lc-gallery__nav-btn lc-gallery__next" aria-label="Next image" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </div>{%- comment %} /.lc-gallery__viewport {%- endcomment %}

    {%- comment %} Tab strip - populated by JS based on which tabs have slides {%- endcomment %}
    {%- if product.images.size > 1 -%}
      <div class="lc-gallery__tabs" id="lc-gallery-tabs" role="tablist" aria-label="Gallery categories"></div>
      {%- comment %} Pagination dots - rebuilt by JS for the active tab {%- endcomment %}
      <div class="lc-gallery__dots" id="lc-gallery-dots" role="tablist" aria-label="Gallery pagination"></div>
    {%- endif -%}
  </div>

  {%- comment %} Fullscreen lightbox - opens on slide tap or zoom button click.
      Navigates within the currently active tab (uses activeIndices from the
      gallery JS). Holds full-resolution copies of every image so swiping
      doesn't require re-fetch. {%- endcomment %}
  <div class="lc-gallery-lightbox" id="lc-gallery-lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image gallery - full view">
    <div class="lc-gallery-lightbox__backdrop" data-lc-lb-close></div>
    <button class="lc-gallery-lightbox__close" type="button" aria-label="Close fullscreen" data-lc-lb-close>
