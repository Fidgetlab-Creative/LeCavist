{{ 'lc-mp-mobile.css' | asset_url | stylesheet_tag }}
<script>
(function() {
  'use strict';

  // ?? Gallery: tabs + touch swipe + counter nav ?????????
  var track    = document.getElementById('lc-gallery-track');
  var prevBtn  = document.querySelector('.lc-gallery__prev');
  var nextBtn  = document.querySelector('.lc-gallery__next');
  var counter  = document.getElementById('lc-gallery-current');
  var totalEl  = document.getElementById('lc-gallery-total');
  var dotsRow  = document.getElementById('lc-gallery-dots');
  var tabsRow  = document.getElementById('lc-gallery-tabs');

  if (track) {
    var slides   = Array.prototype.slice.call(track.querySelectorAll('.lc-gallery__slide'));
    var current  = 0;
    var startX   = 0;
    var dragging = false;

    // Group slides by tab category (read from data-tab on each slide).
    // Tab definitions - order = display order in the strip.
    var TAB_DEFS = [
      { key: 'product',   label: 'Product'   },
      { key: 'inside',    label: 'Inside'    },
      { key: 'lifestyle', label: 'Lifestyle' },
      { key: 'details',   label: 'Details'   }
    ];
    var tabIndices = {};
    slides.forEach(function(s, i) {
      var t = s.getAttribute('data-tab') || 'gallery';
      (tabIndices[t] = tabIndices[t] || []).push(i);
    });

    var visibleTabs = TAB_DEFS.filter(function(t) {
      return tabIndices[t.key] && tabIndices[t.key].length > 0;
    });

    // If every slide is tagged with prefixed alts, "gallery" will be empty
    // and we drop it. If nothing is tagged, only "gallery" remains and the
    // tab strip is hidden (single-tab UX).
    var activeTab = null;
    var activeIndices = [];

    function rebuildDots() {
      if (!dotsRow) return;
      dotsRow.innerHTML = '';
      var n = activeIndices.length;
      if (n <= 1) return; // single image: no dots
      for (var i = 0; i < n; i++) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'lc-gallery__dot' + (i === 0 ? ' is-active' : '');
        b.setAttribute('data-dot-index', String(i));
        b.setAttribute('aria-label', 'Go to image ' + (i + 1));
        b.setAttribute('aria-current', i === 0 ? 'true' : 'false');
        (function(idx) {
          b.addEventListener('click', function() { goTo(idx); });
        })(i);
        dotsRow.appendChild(b);
      }
    }

    function renderTabs() {
      if (!tabsRow) return;
      tabsRow.innerHTML = '';
      // Hide the strip entirely if only one (or zero) tabs exist.
      if (visibleTabs.length <= 1) { tabsRow.style.display = 'none'; return; }
      tabsRow.style.display = '';
      visibleTabs.forEach(function(t) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'lc-gallery__tab';
        btn.setAttribute('data-tab-key', t.key);
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-selected', 'false');
        btn.innerHTML = '<span class="lc-gallery__tab-label">' + t.label + '</span>'
                      + '<span class="lc-gallery__tab-count">' + tabIndices[t.key].length + '</span>';
        btn.addEventListener('click', function() { setTab(t.key); });
        tabsRow.appendChild(btn);
      });
    }

    function updateTabUI() {
      if (!tabsRow) return;
      var btns = tabsRow.querySelectorAll('.lc-gallery__tab');
      btns.forEach(function(b) {
        var on = (b.getAttribute('data-tab-key') === activeTab);
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    }

    function setTab(key) {
      if (!tabIndices[key] || !tabIndices[key].length) return;
      activeTab = key;
      activeIndices = tabIndices[key].slice();
      if (totalEl) totalEl.textContent = activeIndices.length;
      updateTabUI();
      rebuildDots();
      goTo(0);
    }

    function goTo(idx) {
      var max = activeIndices.length - 1;
      if (max < 0) return;
      idx = Math.max(0, Math.min(max, idx));
      current = idx;
      var actualIdx = activeIndices[idx];
      track.style.transform = 'translateX(-' + (actualIdx * 100) + '%)';
      if (counter) counter.textContent = idx + 1;
      if (prevBtn) prevBtn.disabled = idx === 0;
      if (nextBtn) nextBtn.disabled = idx === max;
      if (dotsRow) {
        var dotEls = dotsRow.querySelectorAll('.lc-gallery__dot');
        for (var i = 0; i < dotEls.length; i++) {
          var on = (i === idx);
          dotEls[i].classList.toggle('is-active', on);
          dotEls[i].setAttribute('aria-current', on ? 'true' : 'false');
        }
        var activeDot = dotEls[idx];
        if (activeDot && dotsRow.scrollWidth > dotsRow.clientWidth) {
          dotsRow.scrollTo({
            left: activeDot.offsetLeft - (dotsRow.clientWidth / 2) + (activeDot.offsetWidth / 2),
            behavior: 'smooth'
          });
        }
      }
    }

    if (prevBtn) prevBtn.addEventListener('click', function() { goTo(current - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function() { goTo(current + 1); });

    // Initial render: pick the tab containing slide 0 (so the hero image
    // is visible) and default to the first slide of that tab.
    var initialTabKey = (slides[0] && slides[0].getAttribute('data-tab')) || 'gallery';
    if (!tabIndices[initialTabKey] || !tabIndices[initialTabKey].length) {
      initialTabKey = visibleTabs[0] ? visibleTabs[0].key : 'gallery';
    }
    renderTabs();
    setTab(initialTabKey);

    // Touch swipe
    track.addEventListener('touchstart', function(e) {
      startX   = e.touches[0].clientX;
      dragging = true;
    }, { passive: true });
    track.addEventListener('touchend', function(e) {
      if (!dragging) return;
      var dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) goTo(dx < 0 ? current + 1 : current - 1);
      dragging = false;
    }, { passive: true });

    // Mouse drag (desktop / responsive preview where touch events don't fire)
    track.addEventListener('mousedown', function(e) {
      startX   = e.clientX;
      dragging = true;
    });
    window.addEventListener('mouseup', function(e) {
      if (!dragging) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > 40) goTo(dx < 0 ? current + 1 : current - 1);
      dragging = false;
    });

    // ?? Fullscreen lightbox ???????????????????????????????
    var lb        = document.getElementById('lc-gallery-lightbox');
    var lbImgs    = lb ? lb.querySelectorAll('.lc-gallery-lightbox__img') : [];
    var lbCurEl   = document.getElementById('lc-lb-current');
    var lbTotEl   = document.getElementById('lc-lb-total');
    var lbPrev    = lb ? lb.querySelector('[data-lc-lb-prev]') : null;
    var lbNext    = lb ? lb.querySelector('[data-lc-lb-next]') : null;
    var zoomBtn   = document.querySelector('.lc-gallery__zoom');
    var lbPos     = 0;     // position within activeIndices
    var lbStartX  = 0;
    var lbDrag    = false;

    function showLbImage(pos) {
      if (!activeIndices.length || !lbImgs.length) return;
      var max = activeIndices.length - 1;
      pos = Math.max(0, Math.min(max, pos));
      lbPos = pos;
      var actualIdx = activeIndices[pos];
      for (var i = 0; i < lbImgs.length; i++) {
        lbImgs[i].classList.toggle('is-active', i === actualIdx);
      }
      if (lbCurEl) lbCurEl.textContent = pos + 1;
      if (lbTotEl) lbTotEl.textContent = activeIndices.length;
      if (lbPrev) lbPrev.disabled = pos === 0;
      if (lbNext) lbNext.disabled = pos === max;
    }

    function openLightbox(startPos) {
      if (!lb) return;
      lb.classList.add('is-open');
      lb.setAttribute('aria-hidden', 'false');
      document.body.classList.add('lc-lb-locked');
      showLbImage(typeof startPos === 'number' ? startPos : current);
    }
    function closeLightbox() {
      if (!lb) return;
      lb.classList.remove('is-open');
      lb.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('lc-lb-locked');
    }

    // Tap any slide to open at that slide; respect drag threshold so a
    // swipe-to-scroll doesn't also trigger the lightbox.
    slides.forEach(function(s, i) {
      s.addEventListener('click', function(e) {
        // Skip if a drag just happened
        if (Math.abs((e.clientX || 0) - startX) > 6 && startX !== 0) return;
        // Open at this slide if it's in the active tab; otherwise current
        var posInActive = activeIndices.indexOf(i);
        openLightbox(posInActive >= 0 ? posInActive : 0);
      });
    });
    if (zoomBtn) zoomBtn.addEventListener('click', function() { openLightbox(current); });

    if (lb) {
      lb.querySelectorAll('[data-lc-lb-close]').forEach(function(el) {
        el.addEventListener('click', closeLightbox);
      });
      if (lbPrev) lbPrev.addEventListener('click', function() { showLbImage(lbPos - 1); });
      if (lbNext) lbNext.addEventListener('click', function() { showLbImage(lbPos + 1); });
      document.addEventListener('keydown', function(e) {
        if (!lb.classList.contains('is-open')) return;
        if (e.key === 'Escape')     closeLightbox();
        if (e.key === 'ArrowLeft')  showLbImage(lbPos - 1);
        if (e.key === 'ArrowRight') showLbImage(lbPos + 1);
      });
      // Touch swipe inside the lightbox
      lb.addEventListener('touchstart', function(e) {
        lbStartX = e.touches[0].clientX;
        lbDrag = true;
      }, { passive: true });
      lb.addEventListener('touchend', function(e) {
        if (!lbDrag) return;
        var dx = e.changedTouches[0].clientX - lbStartX;
        if (Math.abs(dx) > 40) showLbImage(dx < 0 ? lbPos + 1 : lbPos - 1);
        lbDrag = false;
      }, { passive: true });
    }
  }

  // ?? Quantity stepper ???????????????????????????????????
  var qtyInput = document.getElementById('lc-qty-input');
  var qtyMinus = document.querySelector('.lc-qty__minus');
  var qtyPlus  = document.querySelector('.lc-qty__plus');
  var mAtcBtn  = document.getElementById('lc-m-atc-btn');
  function lcMUpdateAtcPrice(qty) {
    if (!mAtcBtn || !mAtcBtn.dataset.basePrice) return;
    var total = parseFloat(mAtcBtn.dataset.basePrice) * qty;
    var fmt = '$' + total.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    mAtcBtn.textContent = 'Add to Cart - ' + fmt;
  }
  if (qtyInput && qtyMinus && qtyPlus) {
    qtyMinus.addEventListener('click', function() {
      var v = parseInt(qtyInput.value, 10);
      if (v > 1) { qtyInput.value = v - 1; lcMUpdateAtcPrice(v - 1); }
    });
    qtyPlus.addEventListener('click', function() {
      var v = parseInt(qtyInput.value, 10);
      var max = parseInt(qtyInput.max, 10) || 99;
      if (v < max) { qtyInput.value = v + 1; lcMUpdateAtcPrice(v + 1); }
    });
    qtyInput.addEventListener('change', function() {
      var v = Math.max(1, parseInt(qtyInput.value, 10) || 1);
      qtyInput.value = v;
      lcMUpdateAtcPrice(v);
    });
  }

  // ?? Smooth scroll: review anchor ? reviews section ????
  var reviewAnchor = document.querySelector('.lc-reviews-anchor');
  if (reviewAnchor) {
    reviewAnchor.addEventListener('click', function(e) {
      var target = document.getElementById('lc-reviews-full');
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }

  // ?? Video modal ????????????????????????????????????????
  var videoBtn         = document.getElementById('lc-video-pill-btn');
  var videoBtnDesktop  = document.getElementById('lc-d-video-pill-btn');
  var videoModal       = document.getElementById('lc-video-modal');
  var videoBackdrop   = document.getElementById('lc-video-modal-backdrop');
  var videoModalClose = document.getElementById('lc-video-modal-close');
  var videoModalIframe = document.getElementById('lc-video-modal-iframe');
  var videoModalVideo  = document.getElementById('lc-video-modal-video');

  function toEmbedUrl(url) {
    if (!url) return '';
    var m;
    m = url.match(/^https?:\/\/(?:www\.)?youtu\.be\/([a-zA-Z0-9_-]+)/);
    if (m) return 'https://www.youtube.com/embed/' + m[1] + '?autoplay=1&rel=0';
    m = url.match(/^https?:\/\/(?:www\.)?youtube\.com\/watch\?[^#]*v=([a-zA-Z0-9_-]+)/);
    if (m) return 'https://www.youtube.com/embed/' + m[1] + '?autoplay=1&rel=0';
    m = url.match(/^https?:\/\/(?:www\.)?youtube\.com\/shorts\/([a-zA-Z0-9_-]+)/);
    if (m) return 'https://www.youtube.com/embed/' + m[1] + '?autoplay=1&rel=0';
    m = url.match(/^https?:\/\/vimeo\.com\/(\d+)/);
    if (m) return 'https://player.vimeo.com/video/' + m[1] + '?autoplay=1';
    return url;
  }
  function openVideoModal() {
    if (!videoModal) return;
    var src = (videoModalIframe && videoModalIframe.dataset.src) || '';
    var isDirectVideo = /\.(mp4|mov|webm|ogg)(\?|$)/i.test(src);
    if (isDirectVideo && videoModalVideo) {
      if (videoModalIframe) videoModalIframe.style.display = 'none';
      videoModalVideo.src = src;
      videoModalVideo.style.display = 'block';
      videoModalVideo.play().catch(function(){});
    } else if (videoModalIframe) {
      if (videoModalVideo) videoModalVideo.style.display = 'none';
      var embedSrc = toEmbedUrl(src);
      if (!videoModalIframe.src || videoModalIframe.src === window.location.href) {
        videoModalIframe.src = embedSrc;
      }
      videoModalIframe.style.display = 'block';
    }
    videoModal.classList.add('is-open');
    videoModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    if (videoModalClose) videoModalClose.focus();
  }
  function closeVideoModal() {
    if (!videoModal) return;
    videoModal.classList.remove('is-open');
    videoModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (videoModalIframe) { videoModalIframe.style.display = 'none'; videoModalIframe.src = ''; }
    if (videoModalVideo)  { videoModalVideo.style.display = 'none'; videoModalVideo.pause(); videoModalVideo.src = ''; }
  }
  if (videoBtn)         videoBtn.addEventListener('click', openVideoModal);
  if (videoBtnDesktop)  videoBtnDesktop.addEventListener('click', openVideoModal);
  if (videoModalClose) videoModalClose.addEventListener('click', closeVideoModal);
  if (videoBackdrop)   videoBackdrop.addEventListener('click', closeVideoModal);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && videoModal && videoModal.classList.contains('is-open')) closeVideoModal();
  });

  // ?? Email-to-self panel ????????????????????????????????
  var emailSelfBtn = document.getElementById('lc-email-self-btn');
  var emailPanel   = document.getElementById('lc-email-panel');
  var emailClose   = document.getElementById('lc-email-close');
  var emailInput   = document.getElementById('lc-email-input');
  var emailSend    = document.getElementById('lc-email-send');
  var emailStatus  = document.getElementById('lc-email-status');

  if (emailSelfBtn && emailPanel) {
    emailSelfBtn.addEventListener('click', function() {
      emailPanel.classList.toggle('is-open');
      emailPanel.setAttribute('aria-hidden', emailPanel.classList.contains('is-open') ? 'false' : 'true');
      if (emailPanel.classList.contains('is-open') && emailInput) emailInput.focus();
    });
    emailClose.addEventListener('click', function() {
      emailPanel.classList.remove('is-open');
      emailPanel.setAttribute('aria-hidden', 'true');
    });
  }

  if (emailSend && emailInput) {
    emailSend.addEventListener('click', function() {
      var addr = emailInput.value.trim();
      if (!addr || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(addr)) {
        emailStatus.textContent = 'Please enter a valid email address.';
        emailStatus.className = 'lc-email-panel__status is-error';
        return;
      }

      if (typeof window.lcRecapSend !== 'function') {
        emailStatus.textContent = 'Could not send - please try again.';
        emailStatus.className = 'lc-email-panel__status is-error';
        return;
      }
      emailSend.disabled = true;
      emailStatus.textContent = 'Sending.';
      emailStatus.className = 'lc-email-panel__status';

      var box = emailPanel.querySelector('[data-recap-compare]');
      var selected = (box && box._lcSelected) ? box._lcSelected() : [];

      window.lcRecapSend({ email: addr, selected: selected })
      .then(function() {
        var n = selected.length;
        emailStatus.textContent = n ? ('? Sent! Your comparison of ' + (n + 1) + ' cabinets is on its way.') : '? Sent! Check your inbox.';
        emailStatus.className = 'lc-email-panel__status is-success';
        emailInput.value = '';
        setTimeout(function() {
          emailPanel.classList.remove('is-open');
          emailPanel.setAttribute('aria-hidden', 'true');
          emailStatus.textContent = '';
        }, 3500);
      })
      .catch(function(err) {
        if (err && err.message === 'no-key') {
          console.warn('[lc-recap] Klaviyo public key not set in theme settings - email recap disabled.');
        } else {
          console.warn('[lc-recap] send failed:', err);
        }
        emailStatus.textContent = 'Could not send - please try again.';
        emailStatus.className = 'lc-email-panel__status is-error';
      })
      .finally(function() {
        emailSend.disabled = false;
      });
    });

    // Allow pressing Enter in the input field
    emailInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') emailSend.click();
    });
  }
  var stickyBar  = document.getElementById('lc-sticky-bar');
  var mainAtc    = document.querySelector('.lc-atc-btn');
  var stickyBtn  = document.getElementById('lc-sticky-atc');
  var stickyPriceEl = document.getElementById('lc-sticky-price');

  if (stickyBar && mainAtc) {
    stickyBar.setAttribute('aria-hidden', 'true');

    function updateStickyBar() {
      var rect = mainAtc.getBoundingClientRect();
      var pastBtn = rect.bottom < 0;
      stickyBar.classList.toggle('is-visible', pastBtn);
      stickyBar.setAttribute('aria-hidden', pastBtn ? 'false' : 'true');
    }

    var ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        requestAnimationFrame(function() {
          updateStickyBar();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // Sticky ATC submits the main product form
    if (stickyBtn) {
      stickyBtn.addEventListener('click', function() {
        var mainForm = document.getElementById('lc-product-form');
        if (mainForm) {
          mainForm.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
        }
      });
    }
  }

  // ?? Variant selection ??????????????????????????????????
  var swatches = document.querySelectorAll('.lc-optswatch');
  if (swatches.length) {
    swatches.forEach(function(btn) {
      btn.addEventListener('click', function() {
        // Deselect siblings in the same option group
        var idx = btn.dataset.optionIndex;
        document.querySelectorAll('[data-option-index="' + idx + '"]')
          .forEach(function(s) {
            s.classList.remove('is-selected');
            s.setAttribute('aria-pressed', 'false');
          });
        btn.classList.add('is-selected');
        btn.setAttribute('aria-pressed', 'true');

        // Build option values array from current selections
        var selectedOptions = [];
        var maxIdx = document.querySelectorAll('.lc-opttile-group').length;
        for (var i = 0; i < maxIdx; i++) {
          var sel = document.querySelector('.lc-optswatch.is-selected[data-option-index="' + i + '"]');
          selectedOptions.push(sel ? sel.dataset.value : '');
        }

        // Find matching variant from Shopify's product JSON
        var productJSON = {{ product | json }};
        var match = productJSON.variants.find(function(v) {
          return v.options.every(function(opt, i) {
            return opt === selectedOptions[i];
          });
        });

        if (match) {
          // Update hidden variant input
          var variantInput = document.getElementById('lc-variant-id');
          if (variantInput) variantInput.value = match.id;

          // Update price displays
          var formatted = match.price / 100;
          var currency  = '{{ shop.currency }}';
          var priceStr  = '$' + formatted.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',');

          var priceEl = document.querySelector('.lc-price');
          if (priceEl) priceEl.textContent = priceStr;
          if (stickyPriceEl) stickyPriceEl.textContent = priceStr;

          // Update ATC button availability
          var available = match.available;
          var atcBtn = document.querySelector('.lc-atc-btn');
          if (atcBtn) {
            atcBtn.disabled = !available;
            atcBtn.textContent = available
              ? 'Buy Now - ' + priceStr
              : 'Sold Out';
          }
          if (stickyBtn) {
            stickyBtn.disabled = !available;
            stickyBtn.textContent = available ? 'Buy Now' : 'Sold Out';
          }

          // Update browser URL without reload
          var url = new URL(window.location.href);
          url.searchParams.set('variant', match.id);
          window.history.replaceState({}, '', url.toString());
        }
      });
    });
  }

  // ?? Mobile ATC: intercept submit ? AJAX cart popup ????????
  var lcMobileForm = document.getElementById('lc-product-form');
  if (lcMobileForm) {
    lcMobileForm.addEventListener('submit', function(e) {
      e.preventDefault();
      var cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
      if (!cart) { lcMobileForm.submit(); return; }
      var btn = document.getElementById('lc-m-atc-btn');
      var origTxt = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Adding.'; }
      var fd = new FormData(lcMobileForm);
      if (cart.getSectionsToRender) {
        fd.append('sections', cart.getSectionsToRender().map(function(s) { return s.id; }).join(','));
        fd.append('sections_url', window.location.pathname);
      }
      fetch((window.routes && window.routes.cart_add_url) || '/cart/add', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
        body: fd
      })
      .then(function(r) { return r.json(); })
      .then(function(response) {
        if (response.status) return;
        if (response.sections && cart.getSectionsToRender) {
          cart.getSectionsToRender().forEach(function(section) {
            var el = document.getElementById(section.id);
            if (el && response.sections[section.id]) {
              var html = new DOMParser().parseFromString(response.sections[section.id], 'text/html');
              var inner = html.querySelector('#minicart-form');
              if (inner) el.innerHTML = inner.innerHTML;
            }
          });
        }
        fetch('/cart.json').then(function(r) { return r.json(); }).then(function(cartData) {
          if (cartData.item_count != null) {
            document.querySelectorAll('.cart-count').forEach(function(el) {
              el.innerHTML = cartData.item_count > 100 ? '~' : cartData.item_count;
            });
          }
        });
        if (cart.cartAction) cart.cartAction();
        if (cart.classList.contains('is-empty')) cart.classList.remove('is-empty');
        cart.open();
      })
      .catch(function() { lcMobileForm.submit(); })
      .finally(function() {
        if (btn) { btn.disabled = false; btn.textContent = origTxt; }
      });
    });
  }

})();

</script>

