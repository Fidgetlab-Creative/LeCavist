            <div class="lc-d-qty-right">
              <div class="lc-d-qty-ctrl">
                <button type="button" class="lc-d-qty-btn" onclick="lcDQty(-1)">?</button>
                <span class="lc-d-qty-num" id="lc-d-qty-display">1</span>
                <button type="button" class="lc-d-qty-btn" onclick="lcDQty(1)">+</button>
