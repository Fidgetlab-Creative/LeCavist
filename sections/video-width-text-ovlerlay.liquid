{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme

  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
  --overlay-opacity: {{ section_st.overlay_opacity }}%;
{%- endcapture -%}

<style>
  #video-{{ section.id }} {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background-color: #000;
  }

  #video-{{ section.id }} .video-cover {
    position: absolute;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    flex-direction: column;
    color: #000;
    text-align: center;
    z-index: 1;
  }

  #video-{{ section.id }} .video-cover h2 {
    font-size: {{ section.settings.title_size }}px;
    margin: 10px 0 5px;
  }

  #video-{{ section.id }} .video-cover p {
    margin: 0;
    color: var(--color-text);
  }

  #video-{{ section.id }} .play-button {
    width: 80px;
    height: 80px;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 15px;
  }

  #video-{{ section.id }} .play-button svg {
    width: 30px;
    height: 30px;
    fill: white;
  }

  #video-{{ section.id }} iframe {
    position: absolute;
    width: 100%;
    height: 100%;
    border: 0;
    top: 0;
    left: 0;
    z-index: 2;
  }
</style>

<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__video color-{{ color_scheme }} gradient{{ reset_spacing }}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    <div id="video-{{ section.id }}">
      <div
        class="video-cover"
        id="video-cover-{{ section.id }}"
        style="
          {% if section.settings.video_poster %}
            background-image: url('{{ section.settings.video_poster | image_url: width: 1600 }}');
          {% endif %}
        "
        onclick="loadYouTube('{{ section.id }}', '{{ section.settings.video_url }}')"
      >
        <div class="play-button">
          <svg viewBox="0 0 24 24">
            <polygon points="9.5,7.5 16.5,12 9.5,16.5"/>
          </svg>
        </div>
        {% if section.settings.title != blank %}
          <h2>{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="sec__content-des rich__text-m0">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>
<script>
  function loadYouTube(sectionId, videoUrl) {
    const videoId = getYouTubeVideoId(videoUrl);
    if (!videoId) {
      console.error('Invalid YouTube URL:', videoUrl);
      return;
    }

    const container = document.getElementById('video-' + sectionId);
    const cover = document.getElementById('video-cover-' + sectionId);
    const iframe = document.createElement('iframe');
    iframe.src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&playsinline=1';
    iframe.allow = 'autoplay; encrypted-media';
    iframe.allowFullscreen = true;
    cover.remove();
    container.appendChild(iframe);
  }

  function getYouTubeVideoId(url) {
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
    const match = url.match(regExp);
    return (match && match[2].length === 11) ? match[2] : null;
  }
</script>
{% schema %}
{
