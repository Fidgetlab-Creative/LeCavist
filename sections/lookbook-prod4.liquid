{{ 'lookbook.css' | asset_url | stylesheet_tag }}

<style>
/* --- Anti-clipping & z-index --- */
.sec__lookbook-image,
.sec__lookbook-image .swiper,
.sec__lookbook-image .swiper-wrapper,
.sec__lookbook-image .swiper-slide,
.sec__lookbook-image .lookbook-item__media--ratio{overflow:visible!important}
.sec__lookbook-image .lookbook-item__popup{z-index:9999!important}
.sec__lookbook-image.overflow-hidden{overflow:visible!important}

/* --- Cacher la flèche du BOUTON hotspot --- */
.lookbook-animation::before,
.lookbook-animation::after{display:none!important}

/* --- Flèche (caret) sur le POPUP --- */
.lookbook-item__popup{position:absolute}
.lookbook-item__popup::after{
  content:""; position:absolute; width:0; height:0; border:10px solid transparent;
}

/* Directions forcées */
.lookbook-item__popup.force-top{
  top:auto!important; bottom:100%!important; left:50%!important; transform:translate(-50%,-10px)
}
.lookbook-item__popup.force-top::after{
  bottom:-10px; left:50%; transform:translateX(-50%);
  border-top-color:#fff; border-bottom-width:0
}
.lookbook-item__popup.force-bottom{
  top:100%!important; left:50%!important; transform:translate(-50%,10px)
}
.lookbook-item__popup.force-bottom::after{
  top:-10px; left:50%; transform:translateX(-50%);
  border-bottom-color:#fff; border-top-width:0
}
.lookbook-item__popup.force-left{
  left:auto!important; right:100%!important; top:50%!important; transform:translate(-10px,-50%)
}
.lookbook-item__popup.force-left::after{
  right:-10px; top:50%; transform:translateY(-50%);
  border-left-color:#fff; border-right-width:0
}
.lookbook-item__popup.force-right{
  left:100%!important; top:50%!important; transform:translate(10px,-50%)
}
.lookbook-item__popup.force-right::after{
  left:-10px; top:50%; transform:translateY(-50%);
  border-right-color:#fff; border-left-width:0
}
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&display=swap" rel="stylesheet">

<style>
/* ===== Shop the Look — banner title (SHOP / THE / LOOK) overlay ===== */
.sec__lookbook-image{ container-type: inline-size; }

/* title block: left edge, vertically centred over the image */
.sec__lookbook-image .section__header{
  position:absolute; top:0; bottom:0; left:0; width:100%;
  margin:0!important; z-index:6;
  display:flex; flex-direction:column; justify-content:center; align-items:flex-start;
  padding:0 0 0 2.4%!important; text-align:left; pointer-events:none;
}
.sec__lookbook-image .section__header-heading{
  display:flex!important; flex-direction:column; align-items:flex-start;
  gap:clamp(.4rem,2cqw,3.8rem); margin:0!important; padding:0!important;
}
/* style the word-spans directly so the homepage eyebrow rule
   (body.index .section__header-heading) can't override the typeface */
.sec__lookbook-image .section__header-heading .stl-word{
  display:block;
  font-family:'Montserrat',sans-serif!important; font-weight:700!important;
  line-height:1!important; text-transform:uppercase!important; color:#F5F0E8!important;
}
/* NB: this theme runs html{font-size:62.5%} → 1rem = 10px, so the clamp
   ceilings are doubled vs a 16px root to reach the ~138px / ~57px target. */
.sec__lookbook-image .section__header-heading .stl-word--lg{
  font-size:clamp(3.2rem,7.2cqw,14rem); letter-spacing:.12em;
}
.sec__lookbook-image .section__header-heading .stl-word--sm{
  font-size:clamp(1.4rem,3cqw,5.8rem); letter-spacing:.25em;
}
.sec__lookbook-image .section__header-des{ color:#F5F0E8!important; }

/* popover feature titles — the <h5>s like "Anti-vibration system",
   "Humidity control", "Charcoal filter": match the homepage section titles
   (Inter Tight, uppercase, tracked) instead of the serif heading default */
.sec__lookbook-image .lookbook-item__popup .richtext :is(h1,h2,h3,h4,h5,h6){
  font-family:'Inter Tight',-apple-system,sans-serif!important;
  font-weight:700!important;
  text-transform:uppercase!important;
  letter-spacing:.12em!important;
}

/* maroon scrim — strongest at the left edge, gone by ~40% of the width */
.sec__lookbook-image .lookbook-item__media--ratio{ position:relative; }
.sec__lookbook-image .stl-scrim{
  position:absolute; inset:0; z-index:2; pointer-events:none;
  border-radius:16px;
  background:linear-gradient(90deg,#3A0D16 0%,rgba(58,13,22,0) 40%);
  opacity:.88;
}

/* single navigation button, right side only, vertically centred over the image */
.sec__lookbook-image .swiper-actions{
  position:absolute; top:0; bottom:0; right:0; left:auto; width:auto;
  margin:0!important; z-index:7;
  display:flex!important; align-items:center; justify-content:flex-end;
  padding-right:20px; pointer-events:none;
}
.sec__lookbook-image .swiper-actions .swiper-button-prev{ display:none!important; }
.sec__lookbook-image .swiper-actions .swiper-button-next{
  pointer-events:auto; position:relative; margin:0;
  width:46px; height:46px; min-width:46px;
}
</style>

{%- liquid
  assign st = section.settings
  assign section_width = st.section_width
  assign color_scheme = st.color_scheme
  assign reset_spacing = ''
  if st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  assign image_ratio   = st.image_ratio
  assign custom_ratio  = st.custom_ratio
  assign hotspot_style = st.hotspot_style
  assign action_click  = st.action_when_click_on_hotspot
  assign reveal        = st.reveal
  assign scroll_animation = settings.scroll_animation
-%}

{%- capture style -%}
  --section-pt: {{ st.padding_top }}; --section-pb: {{ st.padding_bottom }};
{%- endcapture -%}

{%- capture col_style -%}
--col-desktop: {{ st.items_per_row }};
--col-number:{{ st.items_per_row_mobile }};
{% if st.items_per_row > 3 %}--col-tablet: 3;{% else %}--col-tablet: {{ st.items_per_row }};{% endif %}
{% if st.column_gap < 15 %}
  --col-gap: {{ st.column_gap }}px;
{% else %}
  --col-gap: 15px;--col-gap-desktop: {{ st.column_gap }}px;
{% endif %}
--col-mobile: {{ st.items_per_row_mobile }}
{%- endcapture -%}

<div
  class="section{% if st.padding_top < 30 %} pt-min{% endif %}{% if st.padding_bottom < 30 %} pb-min{% endif %} sec__lookbook-image color-{{ color_scheme }} gradient{{ reset_spacing }}{% if reveal %} overflow-hidden{% endif %}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    {%- if st.heading != blank or st.description != blank -%}
      <div class="section__header mb-33 mb-sm-20 text-{{ st.header_alignment }}{% if st.section_width == 'full_width' %} px-20{% endif %}">
        {%- if st.heading != blank -%}
          <h2 class="section__header-heading heading-letter-spacing
                     {% if st.header_size == 'small' %}h3{% elsif st.header_size == 'large' %}h1-size{% endif %}
                     mt-0{% if st.description != blank %} mb-10{% else %} mb-0{% endif %}
                     {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
              style="{% if scroll_animation != 'none' %}--animation-order: 0{% endif %}">
            {%- assign stl_words = st.heading | strip | split: ' ' -%}
            {%- for stl_w in stl_words -%}
              {%- if forloop.first or forloop.last -%}
                <span class="stl-word stl-word--lg">{{ stl_w }}</span>
              {%- else -%}
                <span class="stl-word stl-word--sm">{{ stl_w }}</span>
              {%- endif -%}
            {%- endfor -%}
          </h2>
        {% endif %}
        {%- if st.description != blank -%}
          <div class="section__header-des rich__text-m0{% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
               style="{% if scroll_animation != 'none' %}--animation-order: 1{% endif %}">
            {{ st.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <svg hidden>
        <symbol id="icon-lookbook-plus">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M5 0C4.44772 0 4 0.447715 4 1V4L1 4C0.447715 4 0 4.44771 0 5C0 5.55228 0.447715 6 1 6H4V9C4 9.55229 4.44772 10 5 10C5.55228 10 6 9.55228 6 9V6H9C9.55228 6 10 5.55229 10 5C10 4.44772 9.55228 4 9 4L6 4V1C6 0.447715 5.55228 0 5 0Z" fill="currentColor"></path>
        </symbol>
      </svg>

      <slide-section
        class="swiper{% if reveal %} reveal_on_scroll{% endif %}"
        data-section-id="{{ section.id }}"
        data-autoplay="{{ st.autoplay }}"
        data-effect="slide"
        data-loop="{{ st.infinite }}"
        data-speed="500"
        data-autoplay-speed="{{ st.autorotate_speed }}"
        data-spacing="{{ st.column_gap }}"
        data-mobile="{{ st.items_per_row_mobile }}"
        data-desktop="{{ st.items_per_row }}"
        data-free-scroll="{% if st.items_per_row_mobile > 1 and st.items_per_row_mobile < 2 %}true{% endif %}"
        data-pagination-progressbar="{% if st.carousel_pagination == 'show_progress_bar' %}true{% else %}false{% endif %}"
        style="{{ col_style | strip | strip_newlines }}"
      >
        {% if st.show_arrow %}
          {%- render 'swiper-navigation' -%}
        {% endif %}

        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% assign b = block.settings %}

            {%- comment -%} ===== Masquer CET ITEM sur mobile (option par block) ===== {%- endcomment -%}
            {% if b.hide_on_mobile %}
              <style>
                @media screen and (max-width: 749px){
                  #lb-{{ block.id }}{ display:none !important; }
                }
              </style>
            {% endif %}

            <div id="lb-{{ block.id }}" class="lookbook-item grid-custom-item relative swiper-slide" {{ block.shopify_attributes }}>

              {%- comment -%} ==== IMAGE ==== {%- endcomment -%}
              {% if b.lookbook_image != blank %}
                {%- liquid
                  assign ratio = ''
                  if image_ratio != 'adapt'
                    case image_ratio
                      when 'square'
                      when 'landscape'
                      when 'portrait'
                      else
                        if custom_ratio != empty
                          assign ratio = custom_ratio | replace: ':','/'
                        else
                          assign ratio = '3/4'
                        endif
                    endcase
                  else
                    assign ratio = b.lookbook_image.aspect_ratio
                  endif
                -%}
                <div class="lookbook-item__media--ratio{% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
                     style="--aspect-ratio: {{ ratio }}; {% if scroll_animation != 'none' %}--animation-order: {{ forloop.index }}{% endif %}">
                  {% render 'responsive-image', type: 'banner', class: 'rounded', image: b.lookbook_image, image_alt: b.lookbook_image.alt, default: 'lookbook', container: section_width, colunm: st.items_per_row, colunm_mobile: st.items_per_row_mobile, padding: st.column_gap %}
                  <span class="stl-scrim" aria-hidden="true"></span>
                </div>
              {% else %}
                <div class="lookbook-item__media--ratio" style="--aspect-ratio: {% if image_ratio == 'adapt' %}3/4{% else %}{{ ratio }}{% endif %};">
                  {%- render 'placeholder-render', class: 'rounded' -%}
                </div>
              {% endif %}

              {%- comment -%} ==== HOTSPOTS 1..5 ==== {%- endcomment -%}
              {%- for i in (1..5) -%}
                {% liquid
                  assign t  = 'offset_top__'  | append: i
                  assign l  = 'offset_left__' | append: i
                  assign c  = 'content__'     | append: i
                  assign im = 'image__'       | append: i
                  assign lk = 'link__'        | append: i
                  assign ll = 'link_label__'  | append: i
                  assign ph = 'product__'     | append: i
                  assign mw = 'popup_max_width__' | append: i
                  assign dk = 'popup_direction__' | append: i

                  assign top   = b[t]
                  assign left  = b[l]
                  assign txt   = b[c]
                  assign img   = b[im]
                  assign url   = b[lk]
                  assign label = b[ll] | default: 'Learn more'
                  assign handle= b[ph]
                  assign prod  = nil
                  if handle != blank
                    assign prod = all_products[handle]
                  endif

                  assign mw_val = b[mw] | default: 0
                  assign max_w  = st.popup_max_width
                  if mw_val and mw_val != blank and mw_val > 0
                    assign max_w = mw_val
                  endif

                  assign has_any = false
                  if prod or txt != blank or img != blank or url != blank
                    assign has_any = true
                  endif

                  assign dir = b[dk] | default: 'auto'
                  assign dir_class = ''
                  if dir == 'top'
                    assign dir_class = 'force-top'
                  elsif dir == 'bottom'
                    assign dir_class = 'force-bottom'
                  elsif dir == 'left'
                    assign dir_class = 'force-left'
                  elsif dir == 'right'
                    assign dir_class = 'force-right'
                  endif
                %}

                {% if has_any %}
                  <lookbook-item
                    data-type="{{ action_click }}"
                    class="z-3 absolute pointer{% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
                    style="--top: {{ top }}%; --left: {{ left }}%; --transform: translate(-{{ left }}%,-{{ top }}%); {% if scroll_animation != 'none' %}--animation-order: {{ forloop.index }}{% endif %}"
                  >
                    {% assign to_href = '' %}
                    {% if action_click == 'go_to_page' %}
                      {% if prod %}{% assign to_href = prod.url %}{% elsif url != blank %}{% assign to_href = url %}{% endif %}
                    {% endif %}

                    <a class="lookbook-animation heading-color w-44 h-44 inline-flex content-center relative"
                       {% if action_click == 'open' or to_href == '' %}role="link" aria-disabled="true"{% else %}href="{{ to_href }}"{% endif %}
                       aria-label="{% if hotspot_style == 'plus' %}{{ 'general.hotspot.plus' | t }}{% else %}{{ 'general.hotspot.dot' | t }}{% endif %}">
                      <span class="rounded-50 bg-white w-custom h-custom inline-flex content-center"
                            style="--custom-height:31px; --custom-width:31px;">
                        {% if hotspot_style == 'plus' %}
                          <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><use href="#icon-lookbook-plus" /></svg>
                        {% else %}
                          {% render 'icon-dot' %}
                        {% endif %}
                      </span>
                    </a>

                    {% if action_click == 'open' or to_href == '' %}
                      <div class="lookbook-item__popup transition invisible bg-white absolute z-2 p-10 {{ dir_class }}"
                           style="border-radius: {{ st.popup_radius | default: 8 }}px;">
                        <div class="popup-inner" style="max-width: {{ max_w | default: 420 }}px;">
                          {% if prod %}
                            {% render 'product-item',
                              card_product: prod,
                              section_id: section.id,
                              template_enable_action: true,
                              template_enable_product_vendor: false,
                              template_enable_product_short_description: false,
                              template_enable_color_swatches: false,
                              template_enable_rate: true,
                              template_enable_price: true,
                              custom_widths: '160, 80',
                              sizes: '80px',
                              type: 'list'
                            %}
                          {% endif %}
                          {% if txt != blank %}
                            <div class="fs-14 color-subtext richtext {% if prod %}mt-10{% endif %}">{{ txt }}</div>
                          {% endif %}
                          {% if img != blank %}
                            <div class="popup-img-wrap mt-10" style="border-radius: {{ st.image_radius | default: 8 }}px; overflow: hidden;">
                              {% render 'responsive-image', type: 'banner', image: img, image_alt: 'hotspot', sizes: '{{ max_w | default: 420 }}px' %}
                            </div>
                          {% endif %}
                          {% if url != blank %}
                            <div class="mt-10"><a class="btn btn--link underline" href="{{ url }}">{{ label }}</a></div>
                          {% endif %}
                        </div>
                      </div>
                    {% endif %}
                  </lookbook-item>
                {% endif %}
              {%- endfor -%}
            </div>
          {% endfor %}
        </div>

        {% if st.carousel_pagination == 'show_dots'
           or st.carousel_pagination == 'show_dots_on_mobile'
           or st.carousel_pagination == 'show_progress_bar' %}
          <div class="swiper-pagination flex flex-wrap px-15 lh-1 bottom-30 {% if st.carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-center{% if st.content_below_image %} absolute-md-impo{% endif %}"
               style="--swiper-pagination-bottom: 3rem;--swiper-pagination-position: static;"></div>
        {% endif %}
      </slide-section>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Lookbook mix5",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer", "custom.overlay"] },
  "settings": [
    { "type": "select", "id": "section_width", "label": "t:sections.all.section_width.label", "default": "fluid_container",
      "options": [
        { "value": "container", "label": "t:sections.all.section_width.container.label" },
        { "value": "fluid_container", "label": "t:sections.all.section_width.fluid_container.label" },
        { "value": "stretch_width", "label": "t:sections.all.section_width.stretch_width.label" },
        { "value": "full_width", "label": "t:sections.all.section_width.full_width.label" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme-1" },

    { "type": "header", "content": "t:sections.all.section_header.label" },
    { "type": "text", "id": "heading", "label": "t:sections.all.section_header.heading.label" },
    { "type": "richtext", "id": "description", "label": "t:sections.all.section_header.description.label" },
    { "type": "select", "id": "header_size", "label": "t:sections.all.section_header.header_size.label", "default": "medium",
      "options": [
        { "value": "small", "label": "t:sections.all.section_header.header_size.small.label" },
        { "value": "medium", "label": "t:sections.all.section_header.header_size.medium.label" },
        { "value": "large", "label": "t:sections.all.section_header.header_size.large.label" }
      ]
    },
    { "type": "select", "id": "header_alignment", "label": "t:sections.all.section_header.alignment.label", "default": "left",
      "options": [
        { "value": "left", "label": "t:sections.all.section_header.alignment.left.label" },
        { "value": "center", "label": "t:sections.all.section_header.alignment.center.label" },
        { "value": "right", "label": "t:sections.all.section_header.alignment.right.label" }
      ]
    },

    { "type": "header", "content": "Lookbook image" },
    { "type": "select", "id": "image_ratio", "label": "t:sections.all.image.image_ratio.label", "default": "adapt",
      "options": [
        { "value": "adapt", "label": "t:sections.all.image.image_ratio.adapt.label" },
        { "value": "square", "label": "t:sections.all.image.image_ratio.square.label" },
        { "value": "portrait", "label": "t:sections.all.image.image_ratio.portrait.label" },
        { "value": "landscape", "label": "t:sections.all.image.image_ratio.landscape.label" },
        { "value": "custom", "label": "t:sections.all.image.image_ratio.custom.label" }
      ]
    },
    { "type": "text", "id": "custom_ratio", "label": "t:sections.all.image.image_ratio.custom_ratio.label" },

    { "type": "select", "id": "hotspot_style", "label": "Hotspot style", "default": "plus",
      "options": [ { "value": "plus", "label": "Plus" }, { "value": "dot", "label": "Dot" } ]
    },
    { "type": "select", "id": "action_when_click_on_hotspot", "label": "Hotspot action", "default": "open",
      "options": [ { "value": "open", "label": "Open popover" }, { "value": "go_to_page", "label": "Go to link/product" } ]
    },

    { "type": "range", "id": "items_per_row", "label": "t:sections.all.items.items_per_row.label", "min": 1, "max": 8, "step": 1, "default": 6 },
    { "type": "range", "id": "column_gap", "label": "t:sections.all.items.column_gap.label", "min": 0, "max": 50, "step": 5, "default": 30, "unit": "px" },

    { "type": "header", "content": "Carousel" },
    { "type": "checkbox", "id": "show_arrow", "label": "t:sections.all.carousel_settings.show-next-back.label", "default": false },
    { "type": "select", "id": "carousel_pagination", "label": "t:sections.all.carousel_settings.pagination.label",
      "options": [
        { "value": "disable", "label": "t:sections.all.carousel_settings.pagination.disable.label" },
        { "value": "show_dots", "label": "t:sections.all.carousel_settings.pagination.show_dots.label" },
        { "value": "show_dots_on_mobile", "label": "t:sections.all.carousel_settings.pagination.show_dots_on_mobile.label" },
        { "value": "show_progress_bar", "label": "t:sections.all.carousel_settings.pagination.show_progress_bar.label" }
      ]
    },
    { "type": "checkbox", "id": "infinite", "label": "t:sections.all.carousel_settings.infinite.label", "default": false },
    { "type": "checkbox", "id": "autoplay", "label": "t:sections.all.carousel_settings.auto_change.label", "default": false },
    { "type": "range", "id": "autorotate_speed", "label": "t:sections.all.carousel_settings.change_slides_every.label", "max": 6, "min": 2, "step": 1, "unit": "s", "default": 5 },
    { "type": "checkbox", "id": "reveal", "label": "t:sections.all.carousel_settings.reveal.label", "default": false },

    { "type": "header", "content": "Popup appearance" },
    { "type": "range", "id": "popup_radius", "label": "Popup corner radius", "min": 0, "max": 32, "step": 1, "default": 8, "unit": "px" },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 1, "default": 8, "unit": "px" },
    { "type": "range", "id": "popup_max_width", "label": "Popup max width (default)", "min": 280, "max": 560, "step": 10, "default": 420, "unit": "px" },
    { "type": "checkbox", "id": "show_link_when_product", "label": "Show custom link even when a product is present", "default": false },

    { "type": "header", "content": "t:sections.all.mobile_options.label" },
    { "type": "range", "id": "items_per_row_mobile", "label": "t:sections.all.items.items_per_row.label", "min": 1, "max": 2, "step": 0.5, "default": 1.5 },

    { "type": "header", "content": "t:sections.all.section_padding.label" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.section_padding.top.label", "default": 0, "min": 0, "max": 100, "step": 1, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.section_padding.bottom.label", "default": 0, "min": 0, "max": 100, "step": 1, "unit": "px" },
    { "type": "checkbox", "id": "reset_spacing", "label": "t:sections.all.section_padding.reset_spacing.label", "default": false }
  ],
  "blocks": [
    {
      "type": "lookbook_item",
      "name": "Lookbook item",
      "settings": [
        { "type": "image_picker", "id": "lookbook_image", "label": "Background image" },

        { "type": "checkbox", "id": "hide_on_mobile", "label": "Masquer cet item sur mobile (< 750px)", "default": false },

        { "type": "header", "content": "Hotspot 1" },
