{%- comment -%}
  LeCavist: collection comparison table, shown below the product grid.
  Same table styling as the buying guidance table (lc-collection-guidance.liquid).
  By default the table is built from the collection's own products and their
  lecavist_specs metafields, so a draft or removed product drops out automatically:
    lecavist_specs.bottle_capacity, cooling_zone, installation_type, width_mm, height_mm, depth_mm
    lecavist_specs.min_cavity_mm (optional, single line text, shown when "Show minimum cavity column" is on)
  If the collection has rows in custom.comparison_table (list of comparison_table_item),
  those rows are used instead, as a manual override. Each manual row is matched to a product
  in the collection by the SKU in its Model text, e.g. "17 Bottle (LJ17VN2ZBU)". A matched row
  links to the product and shows the product's current price; an unmatched row shows its own
  text, unlinked, with the Price typed in the entry.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign table_title = collection.metafields.custom.comparison_table_title.value | default: section_st.heading
  assign table_items = collection.metafields.custom.comparison_table.value
  assign show_cavity = section_st.show_cavity

  assign show_table = false
  assign manual = false
  if table_items.size > 0
    assign show_table = true
    assign manual = true
  elsif section_st.auto_generate and collection.products_count > 0
    assign show_table = true
  endif

  comment
    Manual rows: build one SKU -> url -> price lookup for the collection's products.
  endcomment
  assign sku_lookup = ''
  if manual
    for product in collection.products
      capture product_sku
        render 'lc-product-sku', product: product
      endcapture
      assign product_sku = product_sku | strip | upcase
      if product_sku != blank
        assign price_text = product.price | money_without_trailing_zeros
        assign lookup_entry = product_sku | append: '^^' | append: product.url | append: '^^' | append: price_text
        assign sku_lookup = sku_lookup | append: lookup_entry | append: '||'
      endif
    endfor
  endif
  assign sku_entries = sku_lookup | split: '||'
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}
{%- if show_table -%}
  {%- style -%}
    .lc-compare__inner {
      max-width: 1100px;
    }
    .lc-compare__title {
      margin: 0 0 15px;
    }
    .lc-compare__table-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: 0;
    }
    .lc-compare__table {
      width: 100%;
      min-width: 820px;
      border-collapse: collapse;
      text-align: left;
      border-top: 1px solid #a9a49f;
      border-bottom: 1px solid #a9a49f;
    }
    .lc-compare__table th,
    .lc-compare__table td {
      padding: 12px 16px;
      vertical-align: top;
      border-bottom: 1px solid #a9a49f;
      border-color: #a9a49f;
    }
    .lc-compare__table thead th,
    .lc-compare__table th + th,
    .lc-compare__table td + td {
      border-left: 1px solid #a9a49f;
    }
    .lc-compare__table thead th {
      background: #fdfaf5;
      border-color: #a9a49f;
      font-weight: 600;
    }
    .lc-compare__table tbody tr:last-child th,
    .lc-compare__table tbody tr:last-child td {
      border-bottom: 0;
    }
    .lc-compare__table tbody th {
      font-weight: 600;
    }
    .lc-compare__table tbody th a {
      font-weight: 500;
    }
    .lc-compare__sku {
      font-size: 13px;
      font-weight: 400;
      opacity: 0.7;
    }
    .lc-compare__footnote {
      margin: 10px 0 0;
      font-size: 13px;
      opacity: 0.7;
    }
  {%- endstyle -%}
  <div
    class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__lc-collection-table"
    style="{{ style | strip | strip_newlines }}"
  >
    <div class="{{ section_width }}">
      <div class="lc-compare__inner">
        {%- if table_title != blank -%}
          <h2 class="lc-compare__title heading-letter-spacing h3">{{ table_title }}</h2>
        {%- endif -%}
        <div
          class="lc-compare__table-wrap"
          role="region"
          tabindex="0"
          aria-label="{{ table_title | default: collection.title | escape }}"
        >
          <table class="lc-compare__table">
            <thead>
              <tr>
                <th scope="col">Model</th>
                <th scope="col">Capacity</th>
                <th scope="col">Zones</th>
                <th scope="col">Installation</th>
                <th scope="col">Size W × H × D (mm)</th>
                {%- if show_cavity -%}
                  <th scope="col">Minimum cavity (mm)</th>
                {%- endif -%}
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {%- if manual -%}
                {%- for item in table_items -%}
                  {%- liquid
                    assign model_text = item.model | strip
                    assign model_sku = model_text | upcase | split: '(' | last | split: ')' | first | strip
                    assign row_url = ''
                    assign row_price = item.price
                    for entry in sku_entries
                      assign entry_parts = entry | split: '^^'
                      if entry_parts[0] == model_sku
                        assign row_url = entry_parts[1]
                        assign row_price = entry_parts[2]
                        break
                      endif
                    endfor
                  -%}
                  <tr>
                    <th scope="row">
                      {%- if row_url != blank -%}
                        <a href="{{ row_url }}">{{ model_text }}</a>
                      {%- else -%}
                        {{ model_text }}
                      {%- endif -%}
                    </th>
                    <td>{{ item.bottles }}</td>
                    <td>{{ item.zones }}</td>
                    <td>{{ item.installation }}</td>
                    <td>{{ item.w_x_h_x_d_mm }}</td>
                    {%- if show_cavity -%}
                      <td>{{ item.minimum_cavity | default: 'TBC' }}</td>
                    {%- endif -%}
                    <td>{{ row_price }}</td>
                  </tr>
                {%- endfor -%}
              {%- else -%}
                {%- for product in collection.products -%}
                  {%- liquid
                    assign specs = product.metafields.lecavist_specs
                    capture product_sku
                      render 'lc-product-sku', product: product
                    endcapture
                    assign product_sku = product_sku | strip
                    assign capacity = specs.bottle_capacity.value | strip
                    assign capacity_rt = capacity | plus: 0 | append: ''
                    if capacity != blank and capacity == capacity_rt
                      assign capacity = capacity | append: ' bottles*'
                    endif
                    assign size = 'See product page'
                    if specs.width_mm.value != blank and specs.height_mm.value != blank and specs.depth_mm.value != blank
                      assign size = specs.width_mm.value | append: ' × ' | append: specs.height_mm.value | append: ' × ' | append: specs.depth_mm.value
                    endif
                  -%}
                  <tr>
                    <th scope="row">
                      <a href="{{ product.url }}">{{ product.title | split: '(' | first | strip }}</a>
                      {%- if product_sku != blank -%}
                        <div class="lc-compare__sku">{{ product_sku }}</div>
                      {%- endif -%}
                    </th>
                    <td>{{ capacity }}</td>
                    <td>{{ specs.cooling_zone.value }}</td>
                    <td>{{ specs.installation_type.value }}</td>
                    <td>{{ size }}</td>
                    {%- if show_cavity -%}
                      <td>{{ specs.min_cavity_mm.value | default: 'TBC' }}</td>
                    {%- endif -%}
                    <td>{{ product.price | money_without_trailing_zeros }}</td>
                  </tr>
                {%- endfor -%}
              {%- endif -%}
            </tbody>
          </table>
          {%- if section_st.footnote != blank -%}
            <p class="lc-compare__footnote">{{ section_st.footnote }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="section sec__lc-collection-table" style="{{ style | strip | strip_newlines }}">
    <div class="{{ section_width }}">
      <p class="text-center my-0">
        Comparison table: this collection has no products. Add products, or add rows to the "Comparison Table"
        metafield.
      </p>
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "disabled_on": {
    "groups": ["custom.overlay", "header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "By default the table is built from the collection's products and their lecavist_specs metafields. Rows in the collection's Comparison Table metafield override this."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Table title",
      "info": "Used when the collection has no Comparison Table Title metafield.",
      "default": "Compare wine cabinets"
    },
    {
      "type": "checkbox",
      "id": "auto_generate",
      "label": "Build the table from the collection's products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cavity",
      "label": "Show minimum cavity column",
      "default": false
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "*Bottle capacity is based on standard 750 ml Bordeaux bottles. Wider bottles, such as Burgundy, Champagne and Pinot, take more space and reduce capacity."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "t:sections.all.section_width.container.label"
        },
        {
          "value": "fluid_container",
          "label": "t:sections.all.section_width.fluid_container.label"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.section_width.stretch_width.label"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.section_width.full_width.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.section_padding.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.section_padding.top.label",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.section_padding.bottom.label",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Comparison table"
    }
  ]
}
{% endschema %}
