/* === [USER CUSTOMIZATIONS] Custom Styling and Modifications ===
   - Added to fix the image cropping issue in product grids
   - Desired behavior: display the entire image without cropping (even if it's not square)
   - Using object-fit: contain to avoid any image cuts
*/

/* Ensure product images are displayed fully (contain) */
.product-image {
  object-fit: contain;
  width: 100%;
  height: 100%;
}

 
