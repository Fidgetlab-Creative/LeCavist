{%- comment -%}
  Capacity Calculator — trigger button
  Renders the "Find my perfect capacity" button.
  Pair with the `capacity-calculator` snippet which provides the shared modal.

  Params:
    variant: 'mobile' (default) | 'desktop' — picks the styling that matches
             the surrounding wishlist / email-to-self buttons.
{%- endcomment -%}

{%- assign cc_variant = variant | default: 'mobile' -%}

{%- if cc_variant == 'desktop' -%}
  <div class="lc-d-sec-btns" style="grid-template-columns: 1fr; margin-top: 10px;">
    <button
      type="button"
      class="lc-d-sec-btn"
      data-lc-cc-open
      aria-haspopup="dialog"
      aria-controls="lc-cc-modal"
    >
      ▦ Find my perfect capacity
    </button>
  </div>
{%- else -%}
  <div class="lc-cc-row">
    <button
      type="button"
      class="lc-cc-trigger"
      data-lc-cc-open
      aria-haspopup="dialog"
      aria-controls="lc-cc-modal"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
        <path d="M7 8h10M7 12h6M7 16h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <circle cx="17" cy="15" r="2.5" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span>Find my perfect capacity</span>
    </button>
  </div>
{%- endif -%}
