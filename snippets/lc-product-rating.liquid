{%- comment -%} Prefer live Judge.me / Shopify review metafields (always current); fall back to the static dataset above {%- endcomment -%}
{%- liquid
  assign lc_scale = 5
  if product.metafields.reviews.rating_count != blank
    assign lc_rating_count = product.metafields.reviews.rating_count.value
  endif
  if product.metafields.reviews.rating != blank
    assign lc_rating_avg = product.metafields.reviews.rating.value.rating
    assign lc_scale = product.metafields.reviews.rating.value.scale_max
  endif
-%}
{%- if mode == 'stars' and lc_rating_avg != blank and lc_rating_count != blank and lc_rating_count != 0 -%}
  {%- assign lc_pct = lc_rating_avg | times: 100.0 | divided_by: lc_scale -%}
  {%- assign lc_avg_disp = lc_rating_avg | times: 1.0 | round: 1 -%}
  <span class="lc-rate" aria-label="Rated {{ lc_avg_disp }} out of {{ lc_scale }} based on {{ lc_rating_count }} reviews">
    <span class="lc-rate__stars" style="--pct: {{ lc_pct }}%;"><span class="lc-rate__bg">★★★★★</span><span class="lc-rate__fg">★★★★★</span></span>
    <span class="lc-rate__c">{{ lc_rating_count }} {% if lc_rating_count == 1 %}review{% else %}reviews{% endif %}</span>
  </span>
{%- endif -%}
