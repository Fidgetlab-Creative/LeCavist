{%- if lc_rv_cards contains '<article' -%}
<div class="lc-reviews-block" data-lc-reviews data-product-sku="{{ lc_rv_sku | escape }}" style="--lc-rv-sku: '{{ lc_rv_sku | escape }}';">
  <header class="lc-reviews-block__header">
    <span class="lc-reviews-block__eyebrow">— Reviews —</span>
    <h3 class="lc-reviews-block__title">What our customers say</h3>
  </header>
  <div class="lc-reviews-block__frame">
    <button class="lc-reviews-block__nav lc-reviews-block__nav--prev" type="button" aria-label="Previous reviews" data-lc-reviews-prev>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="lc-reviews-block__list" data-lc-reviews-track>
      {{ lc_rv_cards }}
    </div>
    <button class="lc-reviews-block__nav lc-reviews-block__nav--next" type="button" aria-label="Next reviews" data-lc-reviews-next>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</div>
{%- endif -%}

<script>
(function(){
  document.querySelectorAll("[data-lc-reviews]").forEach(function(root){
    var track = root.querySelector("[data-lc-reviews-track]");
    var prev = root.querySelector("[data-lc-reviews-prev]");
    var next = root.querySelector("[data-lc-reviews-next]");
    if (!track) return;
    function step(){ var c = track.querySelector(".lc-review-card"); return c ? c.getBoundingClientRect().width + 16 : 320; }
    function refresh(){ if (prev) prev.disabled = track.scrollLeft <= 2; if (next) next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2; }
    if (prev) prev.addEventListener("click", function(){ track.scrollBy({left: -step(), behavior: "smooth"}); });
    if (next) next.addEventListener("click", function(){ track.scrollBy({left:  step(), behavior: "smooth"}); });
    track.addEventListener("scroll", refresh, {passive:true});
    window.addEventListener("resize", refresh);
    refresh();
  });

  // "See more" toggle — only inject on bodies that are actually clamped
  function setupReviewToggles(){
    document.querySelectorAll(".lc-reviews-block .lc-review-card__body").forEach(function(body){
      if (body.dataset.lcRevToggleSetup) return;
      // Only meaningful when the body is truncated by line-clamp
      var clamped = body.scrollHeight > body.clientHeight + 1;
      if (!clamped) return;
      body.dataset.lcRevToggleSetup = "1";
      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "lc-rev-toggle";
      btn.textContent = "See more";
      btn.addEventListener("click", function(){
        var expanded = body.classList.toggle("is-expanded");
        btn.textContent = expanded ? "See less" : "See more";
      });
      body.parentNode.insertBefore(btn, body.nextSibling);
    });
  }
  // Run after layout settles (line-clamp needs computed metrics)
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", function(){ requestAnimationFrame(setupReviewToggles); });
  } else {
    requestAnimationFrame(setupReviewToggles);
  }
  // Re-evaluate on resize because clamping may change
  window.addEventListener("resize", function(){ requestAnimationFrame(setupReviewToggles); });
})();
</script>