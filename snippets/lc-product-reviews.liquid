{%- comment -%}
  Top reviews carousel — 5 cards, arrow-nav, CTA to #lc-all-reviews-full.
{%- endcomment -%}
{%- liquid
  assign lc_rv_handle = product.handle
  assign lc_rv_sku    = product.selected_or_first_available_variant.sku | upcase
  if lc_rv_sku == blank
    assign lc_rv_sku  = product.metafields.custom.fs_sku.value | upcase
  endif
  comment
    Inherit reviews from parent product when this product is a duo/full-shelves variant
    (website-rev.parent_product reference set). Falls back to own handle otherwise.
  endcomment
  assign lc_rv_parent = product.metafields['website-rev'].parent_product.value
  if lc_rv_parent != blank and lc_rv_parent.handle != blank
    assign lc_rv_handle = lc_rv_parent.handle
    assign lc_rv_sku    = lc_rv_parent.selected_or_first_available_variant.sku | upcase
    if lc_rv_sku == blank
      assign lc_rv_sku  = lc_rv_parent.metafields.custom.fs_sku.value | upcase
    endif
  endif
-%}
{%- comment -%}
  Capture the case-statement output first so we can suppress the whole
  reviews block (heading + carousel chrome) for products that don't yet
  have curated reviews. Without this, the section header would render
  on every product page even when no review cards exist.
{%- endcomment -%}
