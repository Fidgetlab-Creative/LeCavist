  }
  .lc-cfg__title {
    display: block;
    font-family: 'Inter Tight', -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1A1512;
  }

  /* ── Row ───────────────────────────────────────────────── */
  .lc-cfg__row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 0;
    border-top: 1px solid rgba(212,205,191,0.7);
  }
  .lc-cfg__row:first-of-type { border-top: none; padding-top: 4px; }
  .lc-cfg__label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(26,26,26,0.55);
  }
  .lc-cfg__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* ── Chip base ─────────────────────────────────────────── */
  .lc-cfg__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    padding: 8px 14px;
    background: #F5F0E8;
    border: 1px solid #D4CDBF;
    border-radius: 4px;
    color: #1A1A1A;
    text-decoration: none;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.15;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s, box-shadow 0.15s;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  .lc-cfg__chip:hover {
    border-color: #1A1A1A;
  }
  .lc-cfg__chip:active {
    transform: scale(0.98);
  }
  .lc-cfg__chip.is-active {
    background: #5C0F1A;
    border-color: #5C0F1A;
    color: #F7F1E6;
    box-shadow: 0 1px 0 rgba(92,15,26,0.06);
  }
  .lc-cfg__chip.is-active:hover {
    border-color: #5C0F1A;
  }

  /* ── Capacity chip — number stacked over unit ─────────── */
  .lc-cfg__chip-value {
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
  }
  .lc-cfg__chip-unit {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-left: 5px;
    opacity: 0.78;
  }
  .lc-cfg__chip.is-active .lc-cfg__chip-unit { opacity: 0.85; }

  /* ── Text chip (legacy) ────────────────────────────────── */
  .lc-cfg__chip--text { font-size: 13.5px; }

  /* ── Visual chip (Set + Shelving rows: text stack + icon row) ─ */
  .lc-cfg__chip--visual {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    padding: 8px 12px;
    min-height: 48px;
    min-width: 120px;
  }
  .lc-cfg__chip-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
