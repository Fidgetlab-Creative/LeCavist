  /* ── Compare button (sits below the chip rows) ──────────── */
  .lc-cfg__compare-btn {
    width: 100%;
    margin-top: 14px;
    background: #EBE4D8;
    border: 1px solid rgba(26,21,18,0.12);
    border-radius: 4px;
    padding: 10px 14px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #1A1512;
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
