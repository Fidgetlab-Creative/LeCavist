    border-color: #6B1F2E;
    color: #6B1F2E;
    background: #E3D8C5;
  }
  .lc-cfg__compare-btn svg { flex-shrink: 0; }

  /* ── Compare modal ─────────────────────────────────────── */
  .lc-cfg-compare {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    font-family: 'Inter Tight', 'Helvetica', -apple-system, sans-serif;
  }
  .lc-cfg-compare.is-open { display: flex; }
  .lc-cfg-compare__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(26,26,26,0.55);
    backdrop-filter: blur(2px);
  }
  .lc-cfg-compare__inner {
    position: relative;
    width: 100%;
    max-width: 760px;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    background: #F7F1E6;
    border-radius: 8px;
    padding: clamp(28px, 4vw, 44px) clamp(20px, 3vw, 36px);
    box-shadow: 0 24px 64px rgba(26,26,26,0.25);
    color: #1A1A1A;
  }
  .lc-cfg-compare__close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: rgba(26,26,26,0.06);
    color: #1A1A1A;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
    z-index: 2;
  }
  .lc-cfg-compare__close:hover { background: rgba(26,26,26,0.14); }

  .lc-cfg-compare__header { text-align: center; margin-bottom: 18px; }
  .lc-cfg-compare__eyebrow {
    font-family: 'Inter Tight', 'Helvetica', sans-serif;
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6B1F2E;
    display: inline-block;
    margin-bottom: 10px;
  }
  .lc-cfg-compare__heading {
