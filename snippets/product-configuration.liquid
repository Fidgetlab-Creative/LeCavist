  }
  .lc-cfg__chip--visual .lc-cfg__chip-icon--wide { width: 26px; }
  .lc-cfg__chip--visual:hover .lc-cfg__chip-icon { opacity: 0.85; }
  .lc-cfg__chip--visual.is-active .lc-cfg__chip-icon { opacity: 1; }

  /* ── Swatch chip (Finish) ──────────────────────────────── */
  .lc-cfg__chip--swatch { padding-left: 10px; gap: 8px; }
  .lc-cfg__swatch {
    width: 16px;
    height: 16px;
    border-radius: 50%;
