    color: rgba(26,26,26,0.6);
    margin: 0;
  }

  .lc-cfg-compare__table-wrap {
    margin: 22px 0 14px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .lc-cfg-compare__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
    min-width: 480px;
  }
  .lc-cfg-compare__table thead th {
    text-align: left;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(26,26,26,0.55);
    padding: 8px 10px;
    border-bottom: 1px solid #D4CDBF;
    background: transparent;
  }
  .lc-cfg-compare__row {
    cursor: pointer;
    transition: background 0.12s;
    border-bottom: 1px solid rgba(212,205,191,0.55);
  }
  .lc-cfg-compare__row:hover { background: rgba(92,15,26,0.04); }
  .lc-cfg-compare__row.is-current {
    background: rgba(92,15,26,0.08);
    box-shadow: inset 3px 0 0 #5C0F1A;
  }
  .lc-cfg-compare__row td {
    padding: 12px 10px;
    vertical-align: middle;
    color: #1A1A1A;
  }
  .lc-cfg-compare__thumb-cell {
    width: 72px;
    padding: 8px !important;
    text-align: center;
    vertical-align: middle;
  }
