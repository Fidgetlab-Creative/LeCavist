  .ai-image-carousel-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    font-family: var(--heading-font, 'Cormorant Garamond', 'Times New Roman', serif);
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
  }

  .ai-image-carousel-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: {{ block.settings.subtitle_weight }};
    font-family: var(--body-font, 'Inter Tight', -apple-system, sans-serif);
    margin: 0 0 {{ block.settings.subtitle_spacing }}px 0;
  }

  .ai-image-carousel-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    font-family: var(--body-font, 'Inter Tight', -apple-system, sans-serif);
    line-height: 1.5;
    margin: 0 0 {{ block.settings.description_spacing }}px 0;
  }

.ai-image-carousel-link-{{ ai_gen_id }} {
  display: inline-block; /* make it behave like a button */
  text-align: center;
  color: {{ block.settings.link_color }};
  background-color: {{ block.settings.button_fill }};
  font-size: {{ block.settings.link_size }}px;
  font-weight: {{ block.settings.link_weight }};
  font-family: var(--btn-font, 'Inter Tight', -apple-system, sans-serif);
  text-decoration: none;
  padding: 10px 20px; /* space inside the button */
  border-radius: 6px;
  border: 2px solid {{ block.settings.link_color }}; /* optional border */
  transition: all 0.3s ease;
}

.ai-image-carousel-link-{{ ai_gen_id }}:hover {
  color: {{ block.settings.link_hover_color }};
  background-color: {{ block.settings.button_fill_hover }};
  transform: scale(1.1);
}

  .ai-image-carousel-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: {{ block.settings.controls_spacing }}px;
  }

  .ai-image-carousel-nav-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
  }

  .ai-image-carousel-nav-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_icon_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-image-carousel-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-image-carousel-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-image-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-image-carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .ai-image-carousel-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-carousel-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-image-carousel-slide-{{ ai_gen_id }} {
      min-width: 100%;
    }

    .ai-image-carousel-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_image_height }}px;
    }
