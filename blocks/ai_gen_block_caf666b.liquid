{% endstyle %}

<image-carousel-{{ ai_gen_id }}
  class="ai-image-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-carousel-container-{{ ai_gen_id }}">
    <div class="ai-image-carousel-track-{{ ai_gen_id }}">
        {% assign slide_order = "3,1,2,4,5" | split: "," %}
        {% for i in slide_order %}
          {% assign i = i | plus: 0 %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign title_key = 'title_' | append: i
          assign subtitle_key = 'subtitle_' | append: i
          assign description_key = 'description_' | append: i
          assign link_text_key = 'link_text_' | append: i
          assign link_url_key = 'link_url_' | append: i
          assign image = block.settings[image_key]
          assign title = block.settings[title_key]
          assign subtitle = block.settings[subtitle_key]
          assign description = block.settings[description_key]
          assign link_text = block.settings[link_text_key]
          # Change the URL to a mailto link
          assign link_url = "mailto:marketing@osasourcing.com"
        %}
        <div class="ai-image-carousel-slide-{{ ai_gen_id }} ai-image-carousel-slide-{{ ai_gen_id }}-{{ i }}">
          <div class="ai-image-carousel-image-wrapper-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
                class="ai-image-carousel-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-image-carousel-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          {% if title != blank or subtitle != blank or description != blank or link_text != blank %}
            <div class="ai-image-carousel-text-wrapper-{{ ai_gen_id }}">
              {% if title != blank %}
                <h3 class="ai-image-carousel-title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}
              {% if subtitle != blank %}
                <div class="ai-image-carousel-subtitle-{{ ai_gen_id }}">{{ subtitle }}</div>
              {% endif %}
              {% if description != blank %}
                <div class="ai-image-carousel-description-{{ ai_gen_id }}">{{ description }}</div>
              {% endif %}
              {% if link_text != blank %}
                <a
                  href="{{ link_url }}"
                  class="ai-image-carousel-link-{{ ai_gen_id }}"
                >
                  {{ link_text }}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="ai-image-carousel-controls-{{ ai_gen_id }}">
    <div class="ai-image-carousel-nav-{{ ai_gen_id }}">
      <button
        class="ai-image-carousel-nav-button-{{ ai_gen_id }} ai-image-carousel-prev-{{ ai_gen_id }}"
        aria-label="Previous slide"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button
        class="ai-image-carousel-nav-button-{{ ai_gen_id }} ai-image-carousel-next-{{ ai_gen_id }}"
        aria-label="Next slide"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="ai-image-carousel-dots-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        <button
          class="ai-image-carousel-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
          data-index="{{ i | minus: 1 }}"
          aria-label="Go to slide {{ i }}"
        ></button>
      {% endfor %}
    </div>
  </div>
</image-carousel-{{ ai_gen_id }}>
<script>
  (function() {
    class ImageCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.totalSlides = 5;
        this.slidesPerView = 3;
        this.maxIndex = this.totalSlides - this.slidesPerView;

        this.autoScroll = {{ block.settings.auto_scroll }};
        this.autoSpeed = {{ block.settings.auto_speed }};
        this.autoTimer = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-image-carousel-track-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-image-carousel-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-image-carousel-next-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-image-carousel-dot-{{ ai_gen_id }}');

        this.setupEventListeners();
        this.updateCarousel();
        this.handleResize();

        window.addEventListener('resize', () => this.handleResize());

        if (this.autoScroll) {
          this.startAutoScroll();

          this.addEventListener('mouseenter', () => this.stopAutoScroll());
          this.addEventListener('mouseleave', () => this.startAutoScroll());
        }
      }

      startAutoScroll() {
        this.autoTimer = setInterval(() => {
          if (this.currentIndex >= this.maxIndex) {
            this.currentIndex = 0;
          } else {
            this.currentIndex++;
          }
          this.updateCarousel();
        }, this.autoSpeed);
      }

      stopAutoScroll() {
        clearInterval(this.autoTimer);
      }

      handleResize() {
        if (window.innerWidth <= 749) {
          this.slidesPerView = 1;
          this.maxIndex = this.totalSlides - 1;
        } else {
          this.slidesPerView = 3;
          this.maxIndex = this.totalSlides - this.slidesPerView;
        }

        if (this.currentIndex > this.maxIndex) {
          this.currentIndex = this.maxIndex;
        }

        this.updateCarousel();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.goToPrevious());
        this.nextButton.addEventListener('click', () => this.goToNext());

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const index = parseInt(e.target.dataset.index);
            this.goToSlide(index);
          });
        });
      }

      goToPrevious() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
        } else {
          this.currentIndex = this.maxIndex;
        }
        this.updateCarousel();
      }

      goToNext() {
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex++;
        } else {
          this.currentIndex = 0;
        }
        this.updateCarousel();
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const slideWidth = this.track.querySelector('.ai-image-carousel-slide-{{ ai_gen_id }}').offsetWidth;
        const gap = {{ block.settings.slide_gap }};
        const offset = -(this.currentIndex * (slideWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;

        this.prevButton.disabled = false;
        this.nextButton.disabled = false;

        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('image-carousel-{{ ai_gen_id }}', ImageCarousel{{ ai_gen_id }});
  })();
</script>

