{% doc %}
  @prompt
    5 images like carousel but with text underneath each, Make the height of the picture at least a third of what it is now and i want to be able to change the opacity of picture and text area, make it so 3 are visible on the page , In the text area i want there to be Title bow, subtitle and desciption area, add the possibility to have a linkafter the description and to modify the font and font siwe for each text box, i want to be able to control the opacity for each of the image + text block separately like image 1 + Text 1 could be opacity 60 and image 2 and texte2 opacity 10 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-carousel-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    position: relative;
  }

  .ai-image-carousel-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-image-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.slide_gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-image-carousel-slide-{{ ai_gen_id }} {
    min-width: calc((100% - ({{ block.settings.slide_gap }}px * 2)) / 3);
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_spacing }}px;
  }

  .ai-image-carousel-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
  }

  .ai-image-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
    object-fit: cover;
  }

  .ai-image-carousel-slide-{{ ai_gen_id }}-1 .ai-image-carousel-image-{{ ai_gen_id }},
  .ai-image-carousel-slide-{{ ai_gen_id }}-1 .ai-image-carousel-placeholder-{{ ai_gen_id }} {
    opacity: {{ block.settings.image_opacity_1 }};
  }

  .ai-image-carousel-slide-{{ ai_gen_id }}-2 .ai-image-carousel-image-{{ ai_gen_id }},
  .ai-image-carousel-slide-{{ ai_gen_id }}-2 .ai-image-carousel-placeholder-{{ ai_gen_id }} {
    opacity: {{ block.settings.image_opacity_2 }};
  }

  .ai-image-carousel-slide-{{ ai_gen_id }}-3 .ai-image-carousel-image-{{ ai_gen_id }},
  .ai-image-carousel-slide-{{ ai_gen_id }}-3 .ai-image-carousel-placeholder-{{ ai_gen_id }} {
    opacity: {{ block.settings.image_opacity_3 }};
  }

  .ai-image-carousel-slide-{{ ai_gen_id }}-4 .ai-image-carousel-image-{{ ai_gen_id }},
  .ai-image-carousel-slide-{{ ai_gen_id }}-4 .ai-image-carousel-placeholder-{{ ai_gen_id }} {
    opacity: {{ block.settings.image_opacity_4 }};
  }

  .ai-image-carousel-slide-{{ ai_gen_id }}-5 .ai-image-carousel-image-{{ ai_gen_id }},
  .ai-image-carousel-slide-{{ ai_gen_id }}-5 .ai-image-carousel-placeholder-{{ ai_gen_id }} {
    opacity: {{ block.settings.image_opacity_5 }};
  }

  .ai-image-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-image-carousel-text-wrapper-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-image-carousel-slide-{{ ai_gen_id }}-1 .ai-image-carousel-text-wrapper-{{ ai_gen_id }} {
    opacity: {{ block.settings.text_opacity_1 }};
  }

  .ai-image-carousel-slide-{{ ai_gen_id }}-2 .ai-image-carousel-text-wrapper-{{ ai_gen_id }} {
    opacity: {{ block.settings.text_opacity_2 }};
  }

  .ai-image-carousel-slide-{{ ai_gen_id }}-3 .ai-image-carousel-text-wrapper-{{ ai_gen_id }} {
    opacity: {{ block.settings.text_opacity_3 }};
  }

  .ai-image-carousel-slide-{{ ai_gen_id }}-4 .ai-image-carousel-text-wrapper-{{ ai_gen_id }} {
    opacity: {{ block.settings.text_opacity_4 }};
  }

  .ai-image-carousel-slide-{{ ai_gen_id }}-5 .ai-image-carousel-text-wrapper-{{ ai_gen_id }} {
