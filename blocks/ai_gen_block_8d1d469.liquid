{% doc %}
  @prompt
    Create a mixed media carousel section that supports both images and videos (MP4/YouTube/Vimeo), smaller in size than the main hero banner slideshow. The carousel should have navigation arrows and dot indicators, allow merchants to add multiple slides each with either an image or a video, and include optional caption text per slide. The height should be configurable but default to a medium size (e.g., 400-500px) suitable for secondary content sections. without text or anything underneath it , is it possible to have 3 pictures/videos per page like de image carousel classiaue which is feature in shopify
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-media-carousel-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-media-carousel-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.carousel_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-media-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    transition: transform 0.5s ease;
    height: 100%;
  }

  .ai-media-carousel-slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.items_per_page_desktop | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.items_per_page_desktop }});
    height: 100%;
  }

  .ai-media-carousel-slide-{{ ai_gen_id }} img,
  .ai-media-carousel-slide-{{ ai_gen_id }} video,
  .ai-media-carousel-slide-{{ ai_gen_id }} iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-media-carousel-slide-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-media-carousel-slide-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-media-carousel-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-media-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.3s ease;
  }

  .ai-media-carousel-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
  }

  .ai-media-carousel-nav-{{ ai_gen_id }}.prev {
    left: {{ block.settings.arrow_offset }}px;
  }

  .ai-media-carousel-nav-{{ ai_gen_id }}.next {
    right: {{ block.settings.arrow_offset }}px;
  }

  .ai-media-carousel-nav-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.arrow_size }}px * 0.5);
    height: calc({{ block.settings.arrow_size }}px * 0.5);
  }

  .ai-media-carousel-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-media-carousel-dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.dots_offset }}px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .ai-media-carousel-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .ai-media-carousel-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  @media screen and (max-width: 749px) {
    .ai-media-carousel-container-{{ ai_gen_id }} {
      height: {{ block.settings.carousel_height | times: 0.7 }}px;
    }

    .ai-media-carousel-slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.items_per_page_mobile | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.items_per_page_mobile }});
    }

    .ai-media-carousel-nav-{{ ai_gen_id }} {
      width: {{ block.settings.arrow_size | times: 0.8 }}px;
      height: {{ block.settings.arrow_size | times: 0.8 }}px;
    }

    .ai-media-carousel-nav-{{ ai_gen_id }}.prev {
      left: {{ block.settings.arrow_offset | times: 0.5 }}px;
    }

    .ai-media-carousel-nav-{{ ai_gen_id }}.next {
      right: {{ block.settings.arrow_offset | times: 0.5 }}px;
    }
  }
{% endstyle %}

<media-carousel-{{ ai_gen_id }}
  class="ai-media-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-items-desktop="{{ block.settings.items_per_page_desktop }}"
  data-items-mobile="{{ block.settings.items_per_page_mobile }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
>
  <div class="ai-media-carousel-container-{{ ai_gen_id }}">
    <div class="ai-media-carousel-track-{{ ai_gen_id }}">
      {% liquid
        assign has_content = false
        for i in (1..12)
          assign media_type_key = 'slide_' | append: i | append: '_media_type'
          assign image_key = 'slide_' | append: i | append: '_image'
          assign video_key = 'slide_' | append: i | append: '_video'
          assign youtube_key = 'slide_' | append: i | append: '_youtube_id'
          assign vimeo_key = 'slide_' | append: i | append: '_vimeo_id'

          assign media_type = block.settings[media_type_key]
          assign image = block.settings[image_key]
          assign video = block.settings[video_key]
          assign youtube_id = block.settings[youtube_key]
          assign vimeo_id = block.settings[vimeo_key]

          if media_type == 'image' and image != blank
            assign has_content = true
          elsif media_type == 'video' and video != blank
            assign has_content = true
          elsif media_type == 'youtube' and youtube_id != blank
            assign has_content = true
          elsif media_type == 'vimeo' and vimeo_id != blank
            assign has_content = true
          endif
        endfor
      %}

      {% for i in (1..12) %}
        {% liquid
          assign media_type_key = 'slide_' | append: i | append: '_media_type'
          assign image_key = 'slide_' | append: i | append: '_image'
          assign video_key = 'slide_' | append: i | append: '_video'
          assign youtube_key = 'slide_' | append: i | append: '_youtube_id'
          assign vimeo_key = 'slide_' | append: i | append: '_vimeo_id'

          assign media_type = block.settings[media_type_key]
          assign image = block.settings[image_key]
          assign video = block.settings[video_key]
          assign youtube_id = block.settings[youtube_key]
          assign vimeo_id = block.settings[vimeo_key]
        %}

        {% if media_type == 'image' and image != blank %}
          <div class="ai-media-carousel-slide-{{ ai_gen_id }}" data-slide="{{ forloop.index }}">
            <img
              src="{{ image | image_url: width: 1000 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
          </div>
        {% elsif media_type == 'video' and video != blank %}
          <div class="ai-media-carousel-slide-{{ ai_gen_id }}" data-slide="{{ forloop.index }}">
            <video
              src="{{ video }}"
              {% if block.settings.video_autoplay %}autoplay{% endif %}
              {% if block.settings.video_loop %}loop{% endif %}
              {% if block.settings.video_muted %}muted{% endif %}
              playsinline
            ></video>
          </div>
        {% elsif media_type == 'youtube' and youtube_id != blank %}
          <div class="ai-media-carousel-slide-{{ ai_gen_id }}" data-slide="{{ forloop.index }}">
            <iframe
              src="https://www.youtube.com/embed/{{ youtube_id }}?controls=1&rel=0&playsinline=1&modestbranding=1&autoplay=0&enablejsapi=1&origin={{ shop.url | url_encode }}&widgetid=1"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        {% elsif media_type == 'vimeo' and vimeo_id != blank %}
          <div class="ai-media-carousel-slide-{{ ai_gen_id }}" data-slide="{{ forloop.index }}">
            <iframe
              src="https://player.vimeo.com/video/{{ vimeo_id }}?title=0&byline=0&portrait=0"
              frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        {% endif %}
      {% endfor %}

      {% unless has_content %}
        <div class="ai-media-carousel-slide-{{ ai_gen_id }}" data-slide="1">
          <div class="ai-media-carousel-slide-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-media-carousel-empty-state-{{ ai_gen_id }}">
              Next, add images or videos to your slides
            </div>
          </div>
        </div>
      {% endunless %}
    </div>

    {% if has_content %}
      <button
        class="ai-media-carousel-nav-{{ ai_gen_id }} prev"
        aria-label="Previous slide"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="ai-media-carousel-nav-{{ ai_gen_id }} next"
        aria-label="Next slide"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="ai-media-carousel-dots-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</media-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class MediaCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentPage = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-media-carousel-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-media-carousel-slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-media-carousel-nav-{{ ai_gen_id }}.prev');
        this.nextButton = this.querySelector('.ai-media-carousel-nav-{{ ai_gen_id }}.next');
        this.dotsContainer = this.querySelector('.ai-media-carousel-dots-{{ ai_gen_id }}');
        this.itemsDesktop = parseInt(this.dataset.itemsDesktop);
        this.itemsMobile = parseInt(this.dataset.itemsMobile);
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) * 1000;

        if (this.slides.length === 0) return;

        this.updateItemsPerPage();
        this.createDots();
        this.setupEventListeners();
        this.updateCarousel();

        if (this.autoplay) {
          this.startAutoplay();
        }

        window.addEventListener('resize', () => {
          this.updateItemsPerPage();
          this.updateCarousel();
        });
      }

      updateItemsPerPage() {
        this.itemsPerPage = window.innerWidth <= 749 ? this.itemsMobile : this.itemsDesktop;
        this.totalPages = Math.ceil(this.slides.length / this.itemsPerPage);
      }

      createDots() {
        if (!this.dotsContainer) return;

        this.dotsContainer.innerHTML = '';
        
        for (let i = 0; i < this.totalPages; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-media-carousel-dot-{{ ai_gen_id }}');
          if (i === 0) dot.classList.add('active');
          dot.setAttribute('aria-label', 'Go to page ' + (i + 1));
          dot.addEventListener('click', () => this.goToPage(i));
          this.dotsContainer.appendChild(dot);
        }

        this.dots = this.querySelectorAll('.ai-media-carousel-dot-{{ ai_gen_id }}');
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousPage());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextPage());
        }
      }

      goToPage(pageIndex) {
        this.currentPage = Math.max(0, Math.min(pageIndex, this.totalPages - 1));
        this.updateCarousel();

        if (this.autoplay) {
          this.resetAutoplay();
        }
      }

      updateCarousel() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = parseFloat(getComputedStyle(this.track).gap) || 0;
        const offset = this.currentPage * this.itemsPerPage * (slideWidth + gap);
        
        this.track.style.transform = `translateX(-${offset}px)`;

        if (this.dots) {
          this.dots.forEach((dot, index) => {
            if (index === this.currentPage) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }

        if (this.prevButton) {
          this.prevButton.disabled = this.currentPage === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentPage >= this.totalPages - 1;
        }
      }

      nextPage() {
        if (this.currentPage < this.totalPages - 1) {
          this.goToPage(this.currentPage + 1);
        }
      }

      previousPage() {
        if (this.currentPage > 0) {
          this.goToPage(this.currentPage - 1);
        }
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          if (this.currentPage >= this.totalPages - 1) {
            this.goToPage(0);
          } else {
            this.nextPage();
          }
        }, this.autoplaySpeed);
      }

      resetAutoplay() {
        clearInterval(this.autoplayInterval);
        this.startAutoplay();
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('media-carousel-{{ ai_gen_id }}', MediaCarousel{{ ai_gen_id }});
  })();
</script>

